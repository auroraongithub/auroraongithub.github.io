---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import SiteSection from '../components/SiteSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MobileShoutbox from '../components/MobileShoutbox.astro';
import { favoriteCategories } from '../data/favorites';
import { mangaSeries } from '../data/mangaSeries';
import { entrySlug, sortByDate } from '../lib/content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const recentBlogs = sortByDate(await getCollection('blogs', ({ data }) => !data.draft)).slice(0, 3);
const recentStories = sortByDate(await getCollection('stories', ({ data }) => !data.draft)).slice(0, 3);
---
<ContentLayout>
  <div class="neo-hero scroll-animate">
    <img class="avatar" src="/img/aboutme.gif" alt="About Me" />
  </div>

  <SiteSection id="about" title="About Me">
    <div class="about-grid">
      <img src="/img/pfp.png" alt="Aurora" />
      <div>
        <h3 style="margin-top: 0;">aurora · Creator, Scanlator</h3>
        <p>I am a hobbyist coder and I also design for projects for myself or ones that I find interesting. I usually create designs in photoshop and code sites when I have nothing to do.</p>
        <p>I'm a pretty competitive gamer. You can find me the most in osu! and Valorant.</p>
      </div>
    </div>
    <div class="about-contact-bar">
      <span class="contact-label"><i class="bi bi-envelope"></i> Contact:</span>
      <a href="https://discord.com/users/izaurora" target="_blank" rel="noopener noreferrer" class="contact-link discord"><i class="bi bi-discord"></i> izaurora</a>
      <a href="https://x.com/_kuzuminn" target="_blank" rel="noopener noreferrer" class="contact-link twitter"><i class="bi bi-twitter-x"></i> @_kuzuminn</a>
      <a href="https://youtube.com/@pmuaurora" target="_blank" rel="noopener noreferrer" class="contact-link youtube"><i class="bi bi-youtube"></i> @pmuaurora</a>
      <a href="mailto:aurorashorts.forbusiness@gmail.com" class="contact-link email"><i class="bi bi-envelope-fill"></i> Email</a>
    </div>
  </SiteSection>

  <SiteSection title="Our Group's Mangas">
    <p class="text-muted mb-2">All series that our group worked on</p>
    <div class="neo-carousel">
      <div class="carousel-viewport">
        <div class="carousel-track" id="seriesTrack">
          {mangaSeries.map((series) => (
            <a class="carousel-item" data-series={series.id} href={series.href} target="_blank" rel="noopener noreferrer"><img src={series.image} alt={series.title} /></a>
          ))}
        </div>
      </div>
      <button class="carousel-ctrl carousel-prev" data-carousel-prev aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
      <button class="carousel-ctrl carousel-next" data-carousel-next aria-label="Next"><i class="bi bi-chevron-right"></i></button>
    </div>
  </SiteSection>
  <div class="hover-card" id="seriesHover"></div>

  <SiteSection id="favorites" title="Favorites" icon="bi-heart">
    <div class="favorites-tabs">
      {favoriteCategories.map((category, index) => (
        <button class:list={['fav-tab', { active: index === 0 }]} data-category={category.id} onclick={`switchFavoritesTab('${category.id}')`}><i class={`bi ${category.icon}`}></i> {category.label}</button>
      ))}
    </div>
    <div class="neo-carousel favorites-carousel">
      <div class="carousel-viewport"><div class="carousel-track" id="favoritesTrack"><div class="loading-small" style="text-align:center;padding:40px;">Loading favorites...</div></div></div>
      <button class="carousel-ctrl carousel-prev" data-fav-carousel-prev aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
      <button class="carousel-ctrl carousel-next" data-fav-carousel-next aria-label="Next"><i class="bi bi-chevron-right"></i></button>
    </div>
  </SiteSection>

  <SiteSection id="portfolio" title="Portfolio">
    <p class="text-muted mb-2">my work!</p>
    <div class="neo-grid" id="portfolioGrid">
      {projects.length ? projects.map((project) => <ProjectCard name={project.data.name} description={project.data.description} href={project.data.githubUrl || project.data.url || '#'} language={project.data.language} stars={project.data.stars} forks={project.data.forks} />) : <div class="loading-small" style="text-align:center;padding:40px;">Loading projects...</div>}
    </div>
  </SiteSection>

  <SiteSection id="recent" title="Recent" icon="bi-clock-history">
    <div class="recent-grid">
      <div class="recent-panel">
        <h3><i class="bi bi-journal-text"></i> Latest Blog Posts</h3>
        <div class="recent-list" id="recentBlogs">
          {recentBlogs.length ? recentBlogs.map((post) => <a class="recent-item" href={`/blogs/${entrySlug(post.id)}/`}><strong>{post.data.title}</strong><small>{post.data.date.toLocaleDateString()}</small></a>) : <div class="loading-small">Loading...</div>}
        </div>
        <a href="/blogs/" class="widget-link">View all blogs <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="recent-panel">
        <h3><i class="bi bi-book"></i> Latest Stories</h3>
        <div class="recent-list" id="recentStories">
          {recentStories.length ? recentStories.map((post) => <a class="recent-item" href={`/stories/${entrySlug(post.id)}/`}><strong>{post.data.title}</strong><small>{post.data.date.toLocaleDateString()}</small></a>) : <div class="loading-small">Loading...</div>}
        </div>
        <a href="/stories/" class="widget-link">View all stories <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </SiteSection>

  <section class="neo-box scroll-animate" id="widgetSpotifyBox" style="display: none;">
    <div class="neo-header"><h2><i class="bi bi-spotify"></i> Currently Listening</h2></div>
    <div class="neo-content" style="padding:15px;"><iframe id="widgetSpotify" style="border-radius:8px;border:none;" src="" width="100%" height="152" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe></div>
  </section>

  <MobileShoutbox />

  <SiteSection title="Join Us!">
    <div class="discord-banner">
      <h3>Join our Discord Server!</h3>
      <a href="https://dsc.gg/evescans" target="_blank" rel="noopener noreferrer">
        <img src="https://imgur-archive.ppy.sh/discord/915843559830204416-954686229314989056-ESBANNER.png?width=1080&height=270" alt="Discord Server Banner" loading="lazy" />
      </a>
    </div>
  </SiteSection>
</ContentLayout>
