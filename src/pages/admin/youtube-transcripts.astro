---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPanel from '../../components/admin/AdminPanel.astro';
import AdminModal from '../../components/admin/AdminModal.astro';
import AdminField from '../../components/admin/AdminField.astro';
---
<AdminLayout title="YouTube Transcripts" active="youtube-transcripts" wide={true} bodyClass="admin-tool admin-transcripts">
  <AdminPanel title="YouTube Transcript Extractor" icon="bi-card-text">
    <div class="transcript-layout">
      <aside class="transcript-source-panel">
        <label class="admin-label" for="urlInput">Add Videos</label>
        <textarea id="urlInput" class="transcript-url-input" placeholder="Paste YouTube URLs here (one per line)…"></textarea>
        <div class="transcript-add-actions"><button class="btn btn-primary" id="extractTranscripts" type="button">Extract</button><button class="btn btn-ghost" id="createBlankTranscript" type="button">Create Blank</button></div>
        <p id="extractStatus" class="admin-status" hidden></p>
        <div class="transcript-progress" id="extractProgress" hidden><span id="extractProgressFill"></span></div>
        <div class="transcript-stats"><div><strong id="statTotal">0</strong><span>Total</span></div><div><strong id="statPending">0</strong><span>Pending</span></div><div><strong id="statOngoing">0</strong><span>Ongoing</span></div><div><strong id="statDone">0</strong><span>Done</span></div></div>
        <div class="transcript-list-head"><strong>Transcripts</strong><div><button class="transcript-filter active" type="button" data-transcript-filter="all">All</button><button class="transcript-filter" type="button" data-transcript-filter="pending">Pending</button><button class="transcript-filter" type="button" data-transcript-filter="ongoing">Ongoing</button><button class="transcript-filter" type="button" data-transcript-filter="done">Done</button></div></div>
        <div id="transcriptList" class="transcript-list"><div class="admin-empty-state">No transcripts yet.</div></div>
      </aside>

      <section class="transcript-editor-panel">
        <div class="transcript-editor-head"><input id="editorTitle" placeholder="Video Title (select a transcript)" disabled /><div class="transcript-editor-actions"><span id="wordCount">0 words</span><button class="btn btn-ghost" id="expandEditor" type="button" disabled>Expand</button><button class="btn btn-ghost" id="toggleTranscriptStatus" type="button" disabled>Ongoing</button><button class="btn btn-primary" id="saveTranscript" type="button" disabled>Save</button><button class="btn btn-ghost admin-danger" id="deleteTranscript" type="button" disabled>Delete</button></div></div>
        <div class="transcript-split"><div><header>Original Transcript <small>(editable)</small></header><textarea id="originalTranscript" disabled></textarea></div><div><header>Your Version</header><textarea id="editedTranscript" disabled></textarea></div></div>
      </section>
    </div>
  </AdminPanel>

  <div class="expanded-transcript-editor" id="expandedEditor" hidden>
    <div class="expanded-transcript-card">
      <header class="expanded-transcript-head"><h2 id="expandedTitle">Transcript</h2><div><span id="expandedWordCount">0 words</span><button class="btn btn-ghost" id="expandedToggleStatus" type="button">Ongoing</button><button class="btn btn-primary" id="expandedSave" type="button">Save</button><button class="btn btn-ghost" id="expandedClose" type="button">Close</button></div></header>
      <div class="expanded-transcript-body">
        <aside class="expanded-transcript-list" id="expandedTranscriptList"></aside>
        <div class="expanded-transcript-panes"><div><header>Original Transcript</header><textarea id="expandedOriginal"></textarea></div><div><header>Your Version <small>AI output will appear here</small></header><textarea id="expandedEdited"></textarea></div></div>
        <section class="transcript-ai-panel">
          <header><strong>AI Assistant</strong><div><button class="btn btn-ghost" id="addCheckpoint" type="button">Checkpoint</button><button class="btn btn-ghost" id="openAISettings" type="button">Settings</button><button class="btn btn-ghost" id="clearAIChat" type="button">Clear</button></div></header>
          <div class="ai-chat-tabs"><div id="chatTabsList"></div><button class="ai-tab-new" id="newChatTab" type="button">+</button></div>
          <div id="aiMessages" class="ai-messages"><div class="ai-message system">Use a quick action or type a message to start.</div></div>
          <div class="ai-compose"><textarea id="aiInput" rows="1" placeholder="Ask AI to revise, improve, or rewrite…"></textarea><button class="btn btn-primary" id="aiSend" type="button">Send</button><div class="ai-quick-actions"><button type="button" data-ai-quick="rewrite">Rewrite</button><button type="button" data-ai-quick="hook">Hook</button><button type="button" data-ai-quick="shorter">Shorter</button><button type="button" data-ai-quick="punchier">Punchy</button><button type="button" data-ai-quick="broll">B-Roll</button></div></div>
        </section>
      </div>
    </div>
  </div>

  <AdminModal id="aiSettingsModal" title="AI Settings">
    <form id="aiSettingsForm" class="admin-form">
      <AdminField label="Model" forId="aiModel"><select id="aiModel"><option value="anthropic/claude-haiku-4.5">Claude Haiku 4.5 (Default)</option><option value="openai/gpt-4o">GPT-4o</option><option value="openai/gpt-4.1">GPT-4.1</option><option value="openai/gpt-4.1-mini">GPT-4.1 Mini</option><option value="openai/gpt-5.2">GPT-5.2</option><option value="anthropic/claude-sonnet-4">Claude Sonnet 4</option><option value="anthropic/claude-3.5-sonnet">Claude 3.5 Sonnet</option><option value="google/gemini-2.0-flash-001">Gemini 2.0 Flash</option></select></AdminField>
      <AdminField label="System Prompt" forId="aiSystemPrompt" hint="Leave empty to use the backend default."><textarea id="aiSystemPrompt" rows="7"></textarea></AdminField>
      <AdminField label="Memories" forId="aiMemories" hint="Style rules and preferences sent with requests."><textarea id="aiMemories" rows="8"></textarea></AdminField>
      <div class="admin-modal-actions"><button class="btn btn-ghost" id="resetAISettings" type="button">Reset</button><button class="btn btn-primary" type="submit">Save Settings</button><button class="btn btn-ghost" type="button" data-modal-close="aiSettingsModal">Cancel</button></div>
    </form>
  </AdminModal>

  <script>
    import { adminFetch, escapeHtml, setAdminStatus } from '../../lib/admin/api';
    type Transcript=Record<string,any> & {id:string;videoId:string;originalTitle?:string;customTitle?:string;originalTranscript?:string;editedTranscript?:string;thumbnail?:string;status:'pending'|'ongoing'|'done';hasTranscript?:boolean};
    type ChatMessage={role:'user'|'assistant'|'system';content:string;isCheckpoint?:boolean;checkpointId?:number;scriptSnapshot?:string;timestamp?:number};
    type ChatTab={id:string;name:string;messages:ChatMessage[];checkpointCounter?:number};
    type ChatTabData={tabs:ChatTab[];activeTabId:string};
    let transcripts:Transcript[]=[];let current:Transcript|null=null;let filter='all';let processing=false;let chatData:ChatTabData|null=null;let currentTabId='';
    const $=<T extends HTMLElement>(selector:string)=>document.querySelector<T>(selector)!;
    const editor={title:$<HTMLInputElement>('#editorTitle'),original:$<HTMLTextAreaElement>('#originalTranscript'),edited:$<HTMLTextAreaElement>('#editedTranscript')};
    const expanded={root:$<HTMLElement>('#expandedEditor'),title:$<HTMLElement>('#expandedTitle'),original:$<HTMLTextAreaElement>('#expandedOriginal'),edited:$<HTMLTextAreaElement>('#expandedEdited')};
    function extractVideoId(value:string){for(const pattern of [/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,/^([a-zA-Z0-9_-]{11})$/]){const match=value.trim().match(pattern);if(match)return match[1]}return null}
    function wordCount(value:string){return value.trim()?value.trim().split(/\s+/).length:0}function updateWords(){$('#wordCount').textContent=`${wordCount(editor.edited.value)} words`;$('#expandedWordCount').textContent=`${wordCount(expanded.edited.value)} words`}
    function setExtract(message='',state:''|'loading'|'success'|'error'=''){setAdminStatus($('#extractStatus'),message,state==='loading'?'loading':state)}
    function statusNext(status:string){return status==='pending'?'ongoing':status==='ongoing'?'done':'pending'}function statusAction(status:string){return status==='pending'?'Ongoing':status==='ongoing'?'Done':'Pending'}
    function updateStats(){$('#statTotal').textContent=String(transcripts.length);$('#statPending').textContent=String(transcripts.filter((item)=>item.status==='pending').length);$('#statOngoing').textContent=String(transcripts.filter((item)=>item.status==='ongoing').length);$('#statDone').textContent=String(transcripts.filter((item)=>item.status==='done').length)}
    function thumb(item:Transcript,small=false){if(item.videoId?.startsWith('blank_'))return `<span class="transcript-placeholder">TXT</span>`;return item.thumbnail?`<img src="${escapeHtml(item.thumbnail)}" alt="" loading="lazy">`:`<span class="transcript-placeholder">${small?'YT':'Video'}</span>`}
    function filtered(){return filter==='all'?transcripts:transcripts.filter((item)=>item.status===filter)}
    function renderList(){const items=filtered();const root=$('#transcriptList');root.innerHTML=items.length?items.map((item)=>`<button class="transcript-item ${current?.id===item.id?'active':''}" type="button" data-transcript-id="${escapeHtml(item.id)}">${thumb(item)}<span><strong>${escapeHtml(item.customTitle||item.originalTitle||'Untitled')}</strong><small><span class="transcript-status ${item.status}">${escapeHtml(item.status)}</span>${!item.hasTranscript&&!item.videoId?.startsWith('blank_')?' · No CC':''}</small></span></button>`).join(''):'<div class="admin-empty-state">No transcripts in this view.</div>';renderExpandedList()}
    function renderExpandedList(){const root=$('#expandedTranscriptList');const items=filtered();root.innerHTML=items.map((item)=>`<button type="button" class="expanded-list-item ${current?.id===item.id?'active':''}" data-expanded-transcript-id="${escapeHtml(item.id)}">${thumb(item,true)}<span><strong>${escapeHtml(item.customTitle||item.originalTitle||'Untitled')}</strong><small>${escapeHtml(item.status)}</small></span></button>`).join('')}
    function select(id:string,syncExpanded=false){if(syncExpanded&&current){editor.original.value=expanded.original.value;editor.edited.value=expanded.edited.value;saveChats()}current=transcripts.find((item)=>item.id===id)||null;if(!current)return;editor.title.value=current.customTitle||current.originalTitle||'';editor.original.value=current.originalTranscript||'';editor.edited.value=current.editedTranscript||'';[editor.title,editor.original,editor.edited,$<HTMLButtonElement>('#saveTranscript'),$<HTMLButtonElement>('#deleteTranscript'),$<HTMLButtonElement>('#toggleTranscriptStatus'),$<HTMLButtonElement>('#expandEditor')].forEach((el:any)=>el.disabled=false);updateStatusButtons();updateWords();renderList();if(!expanded.root.hidden){expanded.title.textContent=current.customTitle||current.originalTitle||'Untitled';expanded.original.value=current.originalTranscript||'';expanded.edited.value=current.editedTranscript||'';loadChats();renderChats();updateWords()}}
    function clearEditor(){current=null;editor.title.value='';editor.original.value='';editor.edited.value='';[editor.title,editor.original,editor.edited,$<HTMLButtonElement>('#saveTranscript'),$<HTMLButtonElement>('#deleteTranscript'),$<HTMLButtonElement>('#toggleTranscriptStatus'),$<HTMLButtonElement>('#expandEditor')].forEach((el:any)=>el.disabled=true);updateWords()}
    function updateStatusButtons(){if(!current)return;const label=statusAction(current.status);$('#toggleTranscriptStatus').textContent=label;$('#expandedToggleStatus').textContent=label}
    async function load(){try{const response=await adminFetch('/youtube/transcripts');const data=await response.json();if(!response.ok)throw new Error(data.error||'Failed to load');transcripts=Array.isArray(data)?data:(data.transcripts||[]);updateStats();renderList()}catch(error){$('#transcriptList').innerHTML=`<p class="admin-status" data-state="error">${escapeHtml(error instanceof Error?error.message:'Failed to load transcripts')}</p>`}}
    $('#extractTranscripts').addEventListener('click',async()=>{const ids=($('#urlInput') as HTMLTextAreaElement).value.split('\n').map(extractVideoId).filter((id):id is string=>Boolean(id)&&!transcripts.some((item)=>item.videoId===id));if(!ids.length){setExtract('No new valid YouTube URLs found.','error');return}const progress=$<HTMLElement>('#extractProgress');const fill=$<HTMLElement>('#extractProgressFill');progress.hidden=false;setExtract(`Extracting ${ids.length} transcript(s)…`,'loading');let success=0,failed=0;for(let index=0;index<ids.length;index++){const videoId=ids[index];fill.style.width=`${Math.round(((index+1)/ids.length)*100)}%`;try{const transcriptResponse=await adminFetch(`/youtube/transcript?videoId=${encodeURIComponent(videoId)}`);const data=await transcriptResponse.json();if(!transcriptResponse.ok)throw new Error(data.error||'Extraction failed');const save=await adminFetch('/youtube/transcripts',{method:'POST',body:JSON.stringify({videoId,originalTitle:data.title||`Video ${videoId}`,customTitle:'',originalTranscript:data.transcript||'',editedTranscript:'',thumbnail:data.thumbnail||`https://img.youtube.com/vi/${videoId}/mqdefault.jpg`,status:'pending',hasTranscript:Boolean(data.transcript)&&!data.placeholder})});if(!save.ok)throw new Error('Save failed');success++}catch(_){failed++}}progress.hidden=true;fill.style.width='0';if(success){($('#urlInput') as HTMLTextAreaElement).value='';setExtract(`Added ${success} transcript(s)${failed?`, ${failed} failed`:''}.`,'success');await load()}else setExtract('Failed to extract transcripts.','error')});
    $('#createBlankTranscript').addEventListener('click',async()=>{const title=window.prompt('Enter a title for the new transcript:','Untitled Script');if(!title)return;try{const response=await adminFetch('/youtube/transcripts',{method:'POST',body:JSON.stringify({videoId:`blank_${Date.now().toString(36)}`,originalTitle:title,customTitle:'',originalTranscript:'',editedTranscript:'',thumbnail:'',status:'pending',hasTranscript:true})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Failed to create transcript');setExtract('Blank transcript created.','success');await load();if(data.id)select(data.id)}catch(error){setExtract(error instanceof Error?error.message:'Failed to create transcript','error')}});
    $('#transcriptList').addEventListener('click',(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-transcript-id]');if(button?.dataset.transcriptId)select(button.dataset.transcriptId)});$('#expandedTranscriptList').addEventListener('click',(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-expanded-transcript-id]');if(button?.dataset.expandedTranscriptId)select(button.dataset.expandedTranscriptId,true)});
    document.querySelectorAll<HTMLButtonElement>('[data-transcript-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.transcriptFilter||'all';document.querySelectorAll('[data-transcript-filter]').forEach((item)=>item.classList.toggle('active',item===button));renderList()}));
    async function toggleStatus(){if(!current)return;const next=statusNext(current.status);const response=await adminFetch(`/youtube/transcripts/${encodeURIComponent(current.id)}`,{method:'PATCH',body:JSON.stringify({status:next})});if(response.ok){current.status=next as Transcript['status'];updateStats();updateStatusButtons();renderList()}}
    $('#toggleTranscriptStatus').addEventListener('click',toggleStatus);$('#expandedToggleStatus').addEventListener('click',toggleStatus);
    async function save(){if(!current)return;const response=await adminFetch(`/youtube/transcripts/${encodeURIComponent(current.id)}`,{method:'PATCH',body:JSON.stringify({customTitle:editor.title.value,originalTranscript:editor.original.value,editedTranscript:editor.edited.value})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Save failed');current.customTitle=editor.title.value;current.originalTranscript=editor.original.value;current.editedTranscript=editor.edited.value;renderList()}
    $('#saveTranscript').addEventListener('click',async()=>{try{await save();const button=$<HTMLButtonElement>('#saveTranscript');const previous=button.textContent;button.textContent='Saved!';setTimeout(()=>button.textContent=previous||'Save',1200)}catch(error){window.alert(error instanceof Error?error.message:'Save failed')}});
    $('#deleteTranscript').addEventListener('click',async()=>{if(!current||!window.confirm('Delete this transcript?'))return;const id=current.id;const response=await adminFetch(`/youtube/transcripts/${encodeURIComponent(id)}`,{method:'DELETE'});if(response.ok){transcripts=transcripts.filter((item)=>item.id!==id);clearEditor();updateStats();renderList()}});editor.edited.addEventListener('input',updateWords);
    $('#expandEditor').addEventListener('click',()=>{if(!current)return;expanded.title.textContent=current.customTitle||current.originalTitle||'Untitled';expanded.original.value=editor.original.value;expanded.edited.value=editor.edited.value;expanded.root.hidden=false;document.body.classList.add('admin-expanded-mode');loadChats();renderChats();renderExpandedList();updateWords()});$('#expandedClose').addEventListener('click',()=>{saveChats();editor.original.value=expanded.original.value;editor.edited.value=expanded.edited.value;expanded.root.hidden=true;document.body.classList.remove('admin-expanded-mode');updateWords()});$('#expandedSave').addEventListener('click',async()=>{editor.original.value=expanded.original.value;editor.edited.value=expanded.edited.value;try{await save();const button=$<HTMLButtonElement>('#expandedSave');button.textContent='Saved!';setTimeout(()=>button.textContent='Save',1200)}catch(error){window.alert(error instanceof Error?error.message:'Save failed')}});expanded.edited.addEventListener('input',updateWords);
    function storageKey(){return current?`chat_tabs_${current.id}`:''}function defaultChat():ChatTabData{const id=`chat_${Date.now().toString(36)}`;return{tabs:[{id,name:'Chat 1',messages:[],checkpointCounter:0}],activeTabId:id}}
    function loadChats(){if(!current)return;try{chatData=JSON.parse(localStorage.getItem(storageKey())||'null')}catch(_){chatData=null}if(!chatData?.tabs?.length)chatData=defaultChat();currentTabId=chatData.activeTabId||chatData.tabs[0].id;renderChatTabs()}
    function activeTab(){return chatData?.tabs.find((tab)=>tab.id===currentTabId)||null}function saveChats(){if(current&&chatData)localStorage.setItem(storageKey(),JSON.stringify(chatData))}
    function renderChatTabs(){const root=$('#chatTabsList');if(!chatData)return;root.innerHTML=chatData.tabs.map((tab)=>`<button class="ai-chat-tab ${tab.id===currentTabId?'active':''}" type="button" data-chat-tab="${escapeHtml(tab.id)}"><span>${escapeHtml(tab.name)}</span>${chatData!.tabs.length>1?`<i data-close-chat="${escapeHtml(tab.id)}">×</i>`:''}</button>`).join('')}
    function renderChats(){const tab=activeTab();const root=$('#aiMessages');if(!tab){root.innerHTML='<div class="ai-message system">No chat.</div>';return}root.innerHTML=tab.messages.length?tab.messages.map((message,index)=>message.isCheckpoint?`<button class="ai-checkpoint" type="button" data-revert-checkpoint="${index}">Checkpoint ${escapeHtml(message.checkpointId||index+1)}</button>`:`<div class="ai-message ${message.role}"><div>${escapeHtml(message.content).replaceAll('\n','<br>')}</div>${message.role==='assistant'?`<button type="button" data-use-ai="${index}">Use as Your Version</button>`:''}</div>`).join(''):'<div class="ai-message system">Use a quick action or type a message to start.</div>';root.scrollTop=root.scrollHeight}
    $('#newChatTab').addEventListener('click',()=>{if(!chatData)return;const id=`chat_${Date.now().toString(36)}`;chatData.tabs.push({id,name:`Chat ${chatData.tabs.length+1}`,messages:[],checkpointCounter:0});chatData.activeTabId=id;currentTabId=id;saveChats();renderChatTabs();renderChats()});$('#chatTabsList').addEventListener('click',(event)=>{const target=event.target as HTMLElement;const close=target.closest<HTMLElement>('[data-close-chat]');const tab=target.closest<HTMLButtonElement>('[data-chat-tab]');if(close?.dataset.closeChat&&chatData&&chatData.tabs.length>1){event.stopPropagation();chatData.tabs=chatData.tabs.filter((item)=>item.id!==close.dataset.closeChat);if(currentTabId===close.dataset.closeChat)currentTabId=chatData.tabs[0].id;chatData.activeTabId=currentTabId;saveChats();renderChatTabs();renderChats();return}if(tab?.dataset.chatTab&&chatData){currentTabId=tab.dataset.chatTab;chatData.activeTabId=currentTabId;saveChats();renderChatTabs();renderChats()}});
    function addCheckpoint(){const tab=activeTab();if(!tab)return;tab.checkpointCounter=(tab.checkpointCounter||0)+1;tab.messages.push({role:'system',content:'Checkpoint',isCheckpoint:true,checkpointId:tab.checkpointCounter,scriptSnapshot:expanded.edited.value,timestamp:Date.now()});saveChats();renderChats()}$('#addCheckpoint').addEventListener('click',addCheckpoint);$('#aiMessages').addEventListener('click',(event)=>{const target=event.target as HTMLElement;const checkpoint=target.closest<HTMLButtonElement>('[data-revert-checkpoint]');const use=target.closest<HTMLButtonElement>('[data-use-ai]');const tab=activeTab();if(checkpoint&&tab){const item=tab.messages[Number(checkpoint.dataset.revertCheckpoint)];if(item?.scriptSnapshot!=null&&window.confirm('Revert Your Version to this checkpoint?')){expanded.edited.value=item.scriptSnapshot;updateWords()}}if(use&&tab){const item=tab.messages[Number(use.dataset.useAi)];if(item?.content){expanded.edited.value=item.content;updateWords()}}});
    const quickPrompts:Record<string,string>={rewrite:'Rewrite this script in my style. Keep the core idea but improve pacing, clarity, and retention.',hook:'Give this script a much stronger opening hook and return the improved full script.',shorter:'Make this script shorter without losing the important information or personality.',punchier:'Make the wording punchier, faster, and more entertaining while keeping it natural.'};
    function settings(){return{model:localStorage.getItem('ai_model')||'anthropic/claude-haiku-4.5',systemPrompt:localStorage.getItem('ai_system_prompt')||'',memories:localStorage.getItem('ai_memories')||''}}
    async function sendAI(message:string,broll=false){if(processing||!current)return;const tab=activeTab();if(!tab)return;processing=true;$<HTMLButtonElement>('#aiSend').disabled=true;if(!broll)tab.messages.push({role:'user',content:message,timestamp:Date.now()});renderChats();const typing=document.createElement('div');typing.className='ai-message system';typing.id='aiTyping';typing.textContent='AI is typing…';$('#aiMessages').append(typing);try{const cfg=settings();const history=tab.messages.filter((item)=>!item.isCheckpoint).slice(0,-(broll?0:1));const body:any={message,history,originalTranscript:expanded.original.value,currentVersion:expanded.edited.value};if(cfg.model)body.model=cfg.model;if(cfg.systemPrompt)body.systemPrompt=cfg.systemPrompt;if(cfg.memories)body.memories=cfg.memories;const response=await adminFetch('/youtube/ai-chat',{method:'POST',body:JSON.stringify(body)});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'AI request failed');tab.messages.push({role:'assistant',content:data.response||'',timestamp:Date.now()});if(!broll)addCheckpoint();saveChats();renderChats()}catch(error){tab.messages.push({role:'assistant',content:`Error: ${error instanceof Error?error.message:'AI request failed'}`,timestamp:Date.now()});renderChats()}finally{typing.remove();processing=false;$<HTMLButtonElement>('#aiSend').disabled=false}}
    $('#aiSend').addEventListener('click',()=>{const input=$<HTMLTextAreaElement>('#aiInput');const value=input.value.trim();if(value){input.value='';sendAI(value)}});$('#aiInput').addEventListener('keydown',(event)=>{const key=event as KeyboardEvent;if(key.key==='Enter'&&!key.shiftKey){key.preventDefault();$('#aiSend').click()}});document.querySelectorAll<HTMLButtonElement>('[data-ai-quick]').forEach((button)=>button.addEventListener('click',()=>{const type=button.dataset.aiQuick||'';if(type==='broll')sendAI('Analyze this script and create a concise B-roll table with columns for script beat and suggested visual/B-roll.',true);else sendAI(quickPrompts[type]||type)}));
    $('#clearAIChat').addEventListener('click',()=>{const tab=activeTab();if(tab&&window.confirm('Clear this chat?')){tab.messages=[];tab.checkpointCounter=0;saveChats();renderChats()}});
    const aiModal=$<HTMLElement>('#aiSettingsModal');function closeAI(){aiModal.classList.remove('active');aiModal.setAttribute('aria-hidden','true')}$('#openAISettings').addEventListener('click',()=>{const cfg=settings();$<HTMLSelectElement>('#aiModel').value=cfg.model;$<HTMLTextAreaElement>('#aiSystemPrompt').value=cfg.systemPrompt;$<HTMLTextAreaElement>('#aiMemories').value=cfg.memories;aiModal.classList.add('active');aiModal.setAttribute('aria-hidden','false')});document.querySelectorAll('[data-modal-close="aiSettingsModal"]').forEach((button)=>button.addEventListener('click',closeAI));aiModal.addEventListener('click',(event)=>{if(event.target===aiModal)closeAI()});$('#aiSettingsForm').addEventListener('submit',(event)=>{event.preventDefault();localStorage.setItem('ai_model',$<HTMLSelectElement>('#aiModel').value);localStorage.setItem('ai_system_prompt',$<HTMLTextAreaElement>('#aiSystemPrompt').value);localStorage.setItem('ai_memories',$<HTMLTextAreaElement>('#aiMemories').value);closeAI()});$('#resetAISettings').addEventListener('click',()=>{localStorage.removeItem('ai_model');localStorage.removeItem('ai_system_prompt');localStorage.removeItem('ai_memories');$<HTMLSelectElement>('#aiModel').value='anthropic/claude-haiku-4.5';$<HTMLTextAreaElement>('#aiSystemPrompt').value='';$<HTMLTextAreaElement>('#aiMemories').value=''});
    load();
  </script>
  <style>
