---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPostEditor from '../../components/admin/AdminPostEditor.astro';
---
<AdminLayout title="Add Post" active="add-post" bodyClass="admin-post-editor-page">
  <Fragment slot="head"><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /></Fragment>
  <div class="post-editor-surface">
    <header class="editor-brief" aria-labelledby="editor-brief-title">
      <div class="editor-brief-copy">
        <h1 id="editor-brief-title">Give it a title. Then let it breathe.</h1>
        <p>Set the shape of the post first, then use the open page to write without getting in your own way.</p>
      </div>
      <div class="editor-brief-readout" aria-label="Editor status">
        <span class="editor-readout-dot" aria-hidden="true"></span>
        <span>EDITOR DESK</span>
        <strong>NEW / READY</strong>
      </div>
    </header>

    <div class="editor-workspace">
      <aside class="editor-notes" aria-label="Post checklist">
        <div class="editor-notes-header">
          <span>POST KIT</span>
          <i class="bi bi-pencil-square" aria-hidden="true"></i>
        </div>
        <ol>
          <li><span>01</span><strong>Title</strong><small>Make the first line count.</small></li>
          <li><span>02</span><strong>Category</strong><small>Give it a home.</small></li>
          <li><span>03</span><strong>Tags</strong><small>Leave a trail back.</small></li>
          <li><span>04</span><strong>Content</strong><small>Write the good part.</small></li>
        </ol>
        <p class="editor-notes-footer">Save the thought while it is still warm.</p>
      </aside>

      <div class="editor-form-column">
        <AdminPostEditor mode="create" />
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .post-editor-surface {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .editor-brief {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    min-height: 142px;
    padding: clamp(18px, 3vw, 30px);
    border: 1px solid var(--border);
    border-radius: 10px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--primary-light) 20%, var(--bg-elev)), var(--bg-elev) 58%),
      var(--bg-elev);
    box-shadow: 0 7px 20px color-mix(in srgb, var(--primary-dark) 12%, transparent);
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }

  .editor-brief::after {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    width: 34%;
    background:
      linear-gradient(135deg, transparent 0 42%, color-mix(in srgb, var(--primary-light) 20%, transparent) 42% 43%, transparent 43% 100%),
      repeating-linear-gradient(90deg, transparent 0 15px, color-mix(in srgb, var(--primary) 10%, transparent) 15px 16px);
    opacity: .9;
    pointer-events: none;
  }

  .editor-brief-copy {
    max-width: 660px;
  }

  .editor-brief h1 {
    margin: 0;
    color: var(--text);
    font-family: Poppins, system-ui, sans-serif;
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  .editor-brief p {
    max-width: 52ch;
    margin: 10px 0 0;
    color: var(--text-muted);
    font-size: .88rem;
    line-height: 1.65;
  }

  .editor-brief-readout {
    display: grid;
    flex: 0 0 auto;
    gap: 5px;
    min-width: 118px;
    padding: 10px 12px;
    border: 1px dashed color-mix(in srgb, var(--primary-dark) 56%, var(--border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-elev) 78%, var(--primary-light));
    color: var(--text-muted);
    font: 700 .62rem/1.25 'Courier New', monospace;
    letter-spacing: .1em;
    text-align: right;
  }

  .editor-brief-readout strong {
    color: var(--primary-dark);
    font-size: .85rem;
  }

  .editor-readout-dot {
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
  }

  .editor-workspace {
    display: grid;
    grid-template-columns: minmax(150px, .22fr) minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .editor-notes {
    position: sticky;
    top: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-elev) 88%, var(--primary-light));
    box-shadow: 0 5px 14px color-mix(in srgb, var(--primary-dark) 10%, transparent);
  }

  .editor-notes-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--gradient);
    color: #fff;
    font: 700 .68rem/1.2 'Courier New', monospace;
    letter-spacing: .12em;
  }

  .editor-notes-header i {
    font-size: .85rem;
  }

  .editor-notes ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 4px 12px 6px;
    list-style: none;
  }

  .editor-notes li {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 1px 8px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--border-light);
  }

  .editor-notes li:last-child {
    border-bottom: 0;
  }

  .editor-notes li > span {
    grid-row: span 2;
    color: var(--primary-dark);
    font: 700 .68rem/1.3 'Courier New', monospace;
  }

  .editor-notes strong {
    color: var(--text);
    font-size: .85rem;
    line-height: 1.2;
  }

  .editor-notes small {
    color: var(--text-muted);
    font-size: .85rem;
    line-height: 1.35;
  }

  .editor-notes-footer {
    margin: 0;
    padding: 12px;
    border-top: 1px solid var(--border-light);
    color: var(--text-muted);
    font: .68rem/1.5 'Courier New', monospace;
  }

  .editor-form-column {
    min-width: 0;
  }

  :global(.admin-post-editor-page .admin-panel) {
    margin-bottom: 0 !important;
    border-radius: 10px;
    box-shadow: 0 8px 22px color-mix(in srgb, var(--primary-dark) 14%, transparent);
    transform: none;
  }

  :global(.admin-post-editor-page .admin-panel:hover) {
    transform: none;
  }

  :global(.admin-post-editor-page .admin-panel-header) {
    min-height: 46px;
    padding: 10px 14px;
    background: var(--gradient);
  }

  :global(.admin-post-editor-page .admin-panel-header h2) {
    font-family: Poppins, system-ui, sans-serif;
    font-size: .92rem;
    letter-spacing: .14em;
  }

  :global(.admin-post-editor-page .admin-panel-actions) {
    gap: 8px;
  }

  :global(.admin-post-editor-page .admin-panel-content) {
    padding: clamp(16px, 2.8vw, 28px);
    background: color-mix(in srgb, var(--card) 94%, var(--primary-light));
  }

  :global(.admin-post-editor-page .admin-form) {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px 14px;
    max-width: none;
    margin: 0;
  }

  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(1)) {
    grid-column: span 7;
  }

  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(2)) {
    grid-column: span 5;
  }

  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(3)),
  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(4)),
  :global(.admin-post-editor-page .admin-form > .admin-status),
  :global(.admin-post-editor-page .admin-form > div:last-child) {
    grid-column: 1 / -1;
  }

  :global(.admin-post-editor-page .admin-field) {
    gap: 7px;
  }

  :global(.admin-post-editor-page .admin-field label) {
    color: var(--primary-dark);
    font: 700 .68rem/1.2 'Courier New', monospace;
    letter-spacing: .11em;
  }

  :global(.admin-post-editor-page input:not([type='checkbox']):not([type='radio'])),
  :global(.admin-post-editor-page select) {
    min-height: 44px;
    padding: 10px 12px;
    border-color: color-mix(in srgb, var(--primary-dark) 42%, var(--border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-elev) 94%, var(--primary-light));
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--primary-dark) 8%, transparent);
    font-size: .86rem;
  }

  :global(.admin-post-editor-page input:not([type='checkbox']):not([type='radio'])::placeholder) {
    color: var(--text-muted);
    opacity: .72;
  }

  :global(.admin-post-editor-page .admin-field small) {
    font-size: .85rem;
  }

  :global(.admin-post-editor-page .ql-toolbar.ql-snow) {
    padding: 9px 10px;
    border-color: color-mix(in srgb, var(--primary-dark) 42%, var(--border));
    border-radius: 8px 8px 0 0;
    background: color-mix(in srgb, var(--bg-elev) 88%, var(--primary-light));
  }

  :global(.admin-post-editor-page .ql-container.ql-snow) {
    min-height: 360px;
    border-color: color-mix(in srgb, var(--primary-dark) 42%, var(--border));
    border-radius: 0 0 8px 8px;
    background: var(--bg-elev);
  }

  :global(.admin-post-editor-page .ql-editor) {
    min-height: 360px;
    padding: 18px;
    color: var(--text);
    font-size: .93rem;
    line-height: 1.75;
  }

  :global(.admin-post-editor-page .ql-snow .ql-stroke) {
    stroke: var(--text-muted);
  }

  :global(.admin-post-editor-page .ql-snow .ql-fill) {
    fill: var(--text-muted);
  }

  :global(.admin-post-editor-page .admin-status) {
    border-radius: 8px;
  }

  :global(.admin-post-editor-page .admin-form > div:last-child) {
    display: flex;
    justify-content: flex-end;
    padding-top: 4px;
  }

  :global(.admin-post-editor-page .admin-form > div:last-child .btn-primary) {
    min-height: 40px;
    padding: 9px 18px;
    border-radius: 8px;
    box-shadow: 0 4px 10px color-mix(in srgb, var(--primary-dark) 22%, transparent);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .editor-workspace {
      grid-template-columns: 1fr;
    }

    .editor-notes {
      position: static;
    }

    .editor-notes ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      display: grid;
      gap: 0 12px;
    }

    .editor-notes li {
      border-bottom: 0;
    }

    .editor-notes-footer {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .editor-brief {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }

    .editor-brief-readout {
      width: 100%;
      box-sizing: border-box;
      text-align: left;
    }

    .editor-readout-dot {
      margin-left: 0;
    }

    .editor-notes ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .editor-notes li:nth-child(-n + 2) {
      border-bottom: 1px dashed var(--border-light);
    }

    :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(1)),
    :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(2)) {
      grid-column: 1 / -1;
    }

    :global(.admin-post-editor-page .admin-panel-actions) {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editor-brief,
    .editor-notes,
    :global(.admin-post-editor-page .admin-panel) {
      transition: none;
    }
  }
</style>
