---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPostEditor from '../../components/admin/AdminPostEditor.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Add Post" active="add-post" bodyClass="admin-post-editor-page">
  <Fragment slot="head"><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /></Fragment>
  <div class="post-editor-surface">
    <AdminPostWorkspace active="blogs">
      <Fragment slot="actions">
        <a class="admin-add-post-tab" href="/admin/add-post/" aria-current="page" aria-label="Add post" title="Add post">
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
        </a>
      </Fragment>
      <div class="editor-form-column">
        <AdminPostEditor mode="create" panel={false} />
      </div>
    </AdminPostWorkspace>
  </div>
</AdminLayout>

<style>
  .post-editor-surface {
    display: block;
    min-width: 0;
  }

  .editor-workspace {
    display: block;
  }

  .editor-form-column {
    min-width: 0;
    width: 100%;
  }

  :global(.admin-post-editor-page .admin-panel) {
    margin-bottom: 0 !important;
    border-radius: 10px;
    box-shadow: 0 8px 22px color-mix(in srgb, var(--primary-dark) 14%, transparent);
    transform: none;
  }

  :global(.admin-post-editor-page .admin-panel:hover) {
    transform: none;
  }

  :global(.admin-post-editor-page .admin-panel-header) {
    min-height: 46px;
    padding: 10px 14px;
    background: var(--gradient);
  }

  :global(.admin-post-editor-page .admin-panel-header h2) {
    font-family: Poppins, system-ui, sans-serif;
    font-size: .92rem;
    letter-spacing: .14em;
  }

  :global(.admin-post-editor-page .admin-panel-actions) {
    gap: 8px;
  }

  :global(.admin-post-editor-page .admin-panel-content) {
    padding: clamp(16px, 2.8vw, 28px);
    background: color-mix(in srgb, var(--card) 94%, var(--primary-light));
  }

  :global(.admin-post-editor-page .admin-form) {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px 14px;
    max-width: none;
    margin: 0;
  }

  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(1)) {
    grid-column: span 7;
  }

  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(2)) {
    grid-column: span 5;
  }

  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(3)),
  :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(4)),
  :global(.admin-post-editor-page .admin-form > .admin-status),
  :global(.admin-post-editor-page .admin-form > div:last-child) {
    grid-column: 1 / -1;
  }

  :global(.admin-post-editor-page .admin-field) {
    gap: 7px;
  }

  :global(.admin-post-editor-page .admin-field label) {
    color: var(--primary-dark);
    font: 700 .68rem/1.2 'Courier New', monospace;
    letter-spacing: .11em;
  }

  :global(.admin-post-editor-page input:not([type='checkbox']):not([type='radio'])),
  :global(.admin-post-editor-page select) {
    min-height: 44px;
    padding: 10px 12px;
    border-color: color-mix(in srgb, var(--primary-dark) 42%, var(--border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-elev) 94%, var(--primary-light));
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--primary-dark) 8%, transparent);
    font-size: .86rem;
  }

  :global(.admin-post-editor-page input:not([type='checkbox']):not([type='radio'])::placeholder) {
    color: var(--text-muted);
    opacity: .72;
  }

  :global(.admin-post-editor-page .admin-field small) {
    font-size: .85rem;
  }

  :global(.admin-post-editor-page .ql-toolbar.ql-snow) {
    padding: 9px 10px;
    border-color: color-mix(in srgb, var(--primary-dark) 42%, var(--border));
    border-radius: 8px 8px 0 0;
    background: color-mix(in srgb, var(--bg-elev) 88%, var(--primary-light));
  }

  :global(.admin-post-editor-page .ql-container.ql-snow) {
    min-height: 360px;
    border-color: color-mix(in srgb, var(--primary-dark) 42%, var(--border));
    border-radius: 0 0 8px 8px;
    background: var(--bg-elev);
  }

  :global(.admin-post-editor-page .ql-editor) {
    min-height: 360px;
    padding: 18px;
    color: var(--text);
    font-size: .93rem;
    line-height: 1.75;
  }

  :global(.admin-post-editor-page .ql-snow .ql-stroke) {
    stroke: var(--text-muted);
  }

  :global(.admin-post-editor-page .ql-snow .ql-fill) {
    fill: var(--text-muted);
  }

  :global(.admin-post-editor-page .admin-status) {
    border-radius: 8px;
  }

  :global(.admin-post-editor-page .admin-form > div:last-child) {
    display: flex;
    justify-content: flex-end;
    padding-top: 4px;
  }

  :global(.admin-post-editor-page .admin-form > div:last-child .btn-primary) {
    min-height: 40px;
    padding: 9px 18px;
    border-radius: 8px;
    box-shadow: 0 4px 10px color-mix(in srgb, var(--primary-dark) 22%, transparent);
    font-weight: 700;
  }

  /* Keep the editor inside the same compact old-web rhythm as the public blog archive. */
  .editor-form-column {
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace-content) {
    padding: 9px;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form) {
    grid-template-columns: minmax(0, 1.45fr) minmax(150px, .55fr);
    gap: 12px 10px;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-field) {
    gap: 3px;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-field label) {
    color: var(--primary-dark);
    font: 700 .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(.admin-post-editor-page .admin-post-workspace input:not([type='checkbox']):not([type='radio'])),
  :global(.admin-post-editor-page .admin-post-workspace select) {
    min-height: 32px;
    padding: 6px 8px;
    border: 1px solid var(--primary-dark);
    border-top-color: var(--primary-light);
    border-left-color: var(--primary-light);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev)));
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .72), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
    color: var(--text);
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-size: .78rem;
  }

  :global(.admin-post-editor-page .admin-post-workspace input:not([type='checkbox']):not([type='radio']):focus-visible),
  :global(.admin-post-editor-page .admin-post-workspace select:focus-visible) {
    outline: 1px solid var(--primary);
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary-light) 30%, transparent), inset 1px 1px 0 rgba(255, 255, 255, .72);
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-field small) {
    color: var(--text-muted);
    font: .66rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace #postEditor) {
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--primary-dark);
    border-radius: 5px;
    background: var(--card);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .7), 1px 1px 2px rgba(0, 0, 0, .14);
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-toolbar.ql-snow) {
    padding: 6px 7px;
    border: 0;
    border-bottom: 1px solid var(--primary-dark);
    background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-container.ql-snow) {
    border: 0;
    background: var(--card);
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-editor) {
    min-height: 300px;
    padding: 12px;
    color: var(--text);
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-size: .82rem;
    line-height: 1.65;
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-editor.ql-blank::before) {
    color: var(--text-muted);
    font: italic .8rem/1.5 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-snow .ql-stroke) {
    stroke: var(--text-muted);
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-snow .ql-fill) {
    fill: var(--text-muted);
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-status) {
    margin-top: -2px;
    border-radius: 4px;
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child) {
    padding-top: 7px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 54%, transparent);
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child .btn-primary) {
    min-height: 30px;
    padding: 6px 12px;
    border: 1px solid var(--primary-dark);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .6), 1px 1px 2px rgba(0, 0, 0, .16);
    font: 700 .7rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child .btn-primary:hover) {
    background: var(--primary);
    transform: none;
  }

  @media (max-width: 900px) {
    :global(.admin-post-editor-page .admin-post-workspace .admin-form) {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(1)),
    :global(.admin-post-editor-page .admin-form > .admin-field:nth-child(2)) {
      grid-column: 1 / -1;
    }

    :global(.admin-post-editor-page .admin-panel-actions) {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.admin-post-editor-page .admin-panel) {
      transition: none;
    }
  }
</style>
