---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPostEditor from '../../components/admin/AdminPostEditor.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Update Post" active="blogs" bodyClass="admin-post-editor-page">
  <Fragment slot="head"><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /></Fragment>
  <div class="post-editor-surface">
    <AdminPostWorkspace active="blogs">
      <Fragment slot="actions">
        <a class="admin-add-post-tab" href="/admin/add-post/" aria-label="Add post" title="Add post">
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
        </a>
      </Fragment>
      <div class="editor-form-column">
        <AdminPostEditor mode="update" panel={false} />
      </div>
    </AdminPostWorkspace>
  </div>
</AdminLayout>

<style>
  .post-editor-surface,
  .editor-form-column {
    min-width: 0;
  }

  .editor-form-column {
    width: 100%;
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace-content) {
    padding: 9px;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form) {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(150px, .55fr);
    gap: 9px 10px;
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > .admin-field:nth-child(1)) {
    grid-column: 1;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > .admin-field:nth-child(2)) {
    grid-column: 2;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > .admin-field:nth-child(3)),
  :global(.admin-post-editor-page .admin-post-workspace .admin-form > #postEditorStatus),
  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child) {
    grid-column: 1 / -1;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-field) {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-field label) {
    color: var(--primary-dark);
    font: 700 .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(.admin-post-editor-page .admin-post-workspace input:not([type='checkbox']):not([type='radio'])),
  :global(.admin-post-editor-page .admin-post-workspace select) {
    width: 100%;
    min-height: 32px;
    padding: 6px 8px;
    box-sizing: border-box;
    border: 1px solid var(--primary-dark);
    border-top-color: var(--primary-light);
    border-left-color: var(--primary-light);
    border-radius: 4px;
    background: linear-gradient(
      to bottom,
      var(--bg-elev) 0%,
      color-mix(in srgb, var(--primary-light) 15%, var(--bg-elev)) 46%,
      color-mix(in srgb, var(--primary-dark) 12%, var(--bg-elev)) 51%,
      var(--bg-elev) 100%
    );
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .72), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 24%, transparent);
    color: var(--text);
    font: .78rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace input::placeholder) {
    color: var(--text-muted);
    opacity: 1;
  }

  :global(.admin-post-editor-page .admin-post-workspace input:not([type='checkbox']):not([type='radio']):focus-visible),
  :global(.admin-post-editor-page .admin-post-workspace select:focus-visible) {
    border-color: var(--primary-dark);
    outline: 2px solid color-mix(in srgb, var(--primary) 48%, transparent);
    outline-offset: 1px;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .78), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 28%, transparent), 0 0 0 2px color-mix(in srgb, var(--primary-light) 24%, transparent);
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-field small) {
    color: var(--text-muted);
    font: .66rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace #postEditor) {
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--primary-dark);
    border-radius: 5px;
    background: var(--card);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .7), 1px 1px 2px rgba(0, 0, 0, .14);
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-toolbar.ql-snow) {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 4px;
    padding: 6px 7px;
    border: 0;
    border-bottom: 1px solid var(--primary-dark);
    background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-toolbar.ql-snow .ql-formats) {
    margin-right: 3px;
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-container.ql-snow) {
    max-height: min(58vh, 520px);
    overflow-y: auto;
    border: 0;
    background: var(--card);
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-editor) {
    min-height: 230px;
    padding: 12px;
    color: var(--text);
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-size: .82rem;
    line-height: 1.65;
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-editor.ql-blank::before) {
    color: var(--text-muted);
    font: italic .8rem/1.5 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-snow .ql-stroke) {
    stroke: var(--text-muted);
  }

  :global(.admin-post-editor-page .admin-post-workspace .ql-snow .ql-fill) {
    fill: var(--text-muted);
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-status) {
    margin-top: -2px;
    border-radius: 4px;
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child) {
    display: flex;
    justify-content: flex-end;
    padding-top: 7px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 54%, transparent);
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child .btn-primary) {
    min-height: 30px;
    padding: 6px 12px;
    border: 1px solid var(--primary-dark);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .6), 1px 1px 2px rgba(0, 0, 0, .16);
    font: 700 .7rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  :global(.admin-post-editor-page .admin-post-workspace .admin-form > div:last-child .btn-primary:hover) {
    background: var(--primary);
    transform: none;
  }

  @media (max-width: 620px) {
    :global(.admin-post-editor-page .admin-post-workspace .admin-form > .admin-field:nth-child(1)),
    :global(.admin-post-editor-page .admin-post-workspace .admin-form > .admin-field:nth-child(2)) {
      grid-column: 1 / -1;
    }

    :global(.admin-post-editor-page .admin-post-workspace .ql-container.ql-snow) {
      max-height: 48vh;
    }
  }

  @media (max-width: 480px) {
    :global(.admin-post-editor-page .admin-post-workspace-content) {
      padding: 8px;
    }

    :global(.admin-post-editor-page .admin-post-workspace .ql-editor) {
      min-height: 200px;
    }
  }
</style>
