---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
import AdminTabs from '../../components/admin/AdminTabs.astro';
import AdminPostList from '../../components/admin/AdminPostList.astro';
---
<AdminLayout title="Admin Blogs" active="blogs">
  <div class="blog-admin-page">
    <div class="blog-toolbar" role="search" aria-label="Filter blog posts">
      <div class="blog-toolbar-controls">
        <AdminField label="Find posts" forId="blogSearch">
          <input id="blogSearch" type="search" placeholder="Title or tag" autocomplete="off" />
        </AdminField>
        <AdminField label="Year" forId="blogYear">
          <select id="blogYear">
            <option value="all">All years</option>
          </select>
        </AdminField>
        <div class="blog-toolbar-actions">
          <AdminStatus id="blogFilterStatus" />
          <button class="btn btn-ghost" type="button" id="blogFilterReset">Reset</button>
        </div>
      </div>
      <div class="blog-toolbar-footer">
        <AdminTabs
          tabs={[{ id: 'all', label: 'All posts' }, { id: 'tagged', label: 'Tagged' }, { id: 'untagged', label: 'No tags' }]}
          dataAttribute="category"
        />
      </div>
    </div>

    <AdminPostList type="blog" title="Blogs" />
  </div>
</AdminLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#blogSearch');
  const year = document.querySelector<HTMLSelectElement>('#blogYear');
  const reset = document.querySelector<HTMLButtonElement>('#blogFilterReset');
  const status = document.querySelector<HTMLElement>('#blogFilterStatus');
  const root = document.querySelector<HTMLElement>('[data-admin-post-list]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.blog-toolbar-footer [data-category]')];

  if (search && year && reset && status && root) {
    const searchInput = search;
    const yearSelect = year;
    const resetButton = reset;
    const filterStatus = status;
    const postRoot = root;
    let tagFilter = 'all';
    let filteredEmpty: HTMLElement | null = null;

    function syncYears() {
      const years = [...postRoot.querySelectorAll<HTMLElement>('.admin-list-group-title')]
        .map((heading) => heading.textContent?.trim() || '')
        .filter(Boolean);
      const current = yearSelect.value;
      yearSelect.innerHTML = '<option value="all">All years</option>';
      years.forEach((value) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        yearSelect.append(option);
      });
      yearSelect.value = years.includes(current) ? current : 'all';

      let activeYear = '';
      [...postRoot.children].forEach((child) => {
        const element = child as HTMLElement;
        if (element.classList.contains('admin-list-group-title')) activeYear = element.textContent?.trim() || '';
        if (element.classList.contains('admin-list-item')) element.dataset.blogYear = activeYear;
      });
    }

    function applyFilters() {
      const query = searchInput.value.trim().toLowerCase();
      const selectedYear = yearSelect.value;
      const rows = [...postRoot.querySelectorAll<HTMLElement>('.admin-list-item')];
      const headings = [...postRoot.querySelectorAll<HTMLElement>('.admin-list-group-title')];
      const filtering = Boolean(query || selectedYear !== 'all' || tagFilter !== 'all');
      let visible = 0;

      if (!rows.length) {
        filteredEmpty?.remove();
        filteredEmpty = null;
        filterStatus.textContent = '';
        filterStatus.hidden = true;
        return;
      }

      rows.forEach((row) => {
        const matchesQuery = !query || (row.textContent || '').toLowerCase().includes(query);
        const matchesYear = selectedYear === 'all' || row.dataset.blogYear === selectedYear;
        const meta = [...row.querySelectorAll<HTMLElement>('.admin-list-meta span')].map((item) => item.textContent?.trim().toLowerCase() || '');
        const hasTags = Boolean(meta[1] && !meta[1].includes('no tags'));
        const matchesTag = tagFilter === 'all' || (tagFilter === 'tagged' ? hasTags : !hasTags);
        row.hidden = !(matchesQuery && matchesYear && matchesTag);
        if (!row.hidden) visible += 1;
      });

      headings.forEach((heading) => {
        const headingYear = heading.textContent?.trim() || '';
        heading.hidden = !rows.some((row) => !row.hidden && row.dataset.blogYear === headingYear);
      });

      filterStatus.textContent = filtering ? `${visible} of ${rows.length} posts` : '';
      filterStatus.hidden = !filtering;
      filterStatus.dataset.state = visible ? '' : 'error';

      if (visible || !filtering) {
        filteredEmpty?.remove();
        filteredEmpty = null;
      } else if (!filteredEmpty) {
        filteredEmpty = document.createElement('div');
        filteredEmpty.className = 'admin-empty-state blog-filter-empty';
        filteredEmpty.innerHTML = '<i class="bi bi-search" aria-hidden="true"></i><strong>No matching posts</strong><span>Reset the filters to see all posts.</span>';
        postRoot.append(filteredEmpty);
      }
    }

    function setTagFilter(value: string) {
      tagFilter = value;
      tabs.forEach((tab) => {
        const active = tab.dataset.category === value;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      applyFilters();
    }

    const observer = new MutationObserver(() => {
      syncYears();
      applyFilters();
    });
    observer.observe(postRoot, { childList: true, subtree: true });

    searchInput.addEventListener('input', applyFilters);
    yearSelect.addEventListener('change', applyFilters);
    tabs.forEach((tab) => tab.addEventListener('click', () => setTagFilter(tab.dataset.category || 'all')));
    resetButton.addEventListener('click', () => {
      searchInput.value = '';
      yearSelect.value = 'all';
      setTagFilter('all');
      searchInput.focus();
    });

    syncYears();
    applyFilters();
  }
</script>

<style>
  .blog-admin-page {
    min-width: 0;
  }

  .blog-toolbar {
    display: grid;
    gap: 8px;
    margin: 0 0 10px;
    padding: 8px 9px;
    border: 1px solid var(--border-light);
    border-radius: 5px;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg-elev) 94%, var(--primary-light)), var(--bg-elev));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--primary-light) 45%, transparent);
  }

  .blog-toolbar-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 160px) auto;
    gap: 8px;
    align-items: end;
  }

  .blog-toolbar :global(.admin-field) {
    gap: 3px;
  }

  .blog-toolbar :global(.admin-field label) {
    font: 700 .65rem/1.2 'Courier New', monospace;
    letter-spacing: .08em;
  }

  .blog-toolbar :global(input),
  .blog-toolbar :global(select) {
    min-height: 32px;
    padding: 6px 8px;
    font-size: .75rem;
  }

  .blog-toolbar-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    min-height: 32px;
  }

  .blog-toolbar-actions :global(.admin-status) {
    margin: 0;
    padding: 5px 7px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: .68rem/1.2 'Courier New', monospace;
    white-space: nowrap;
  }

  .blog-toolbar-actions :global(.admin-status[data-state='error']) {
    color: var(--admin-danger);
  }

  .blog-toolbar-actions .btn {
    min-height: 32px;
  }

  .blog-toolbar-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 29px;
    padding-top: 7px;
    border-top: 1px dashed var(--border-light);
  }

  .blog-toolbar-footer :global(.admin-tabs) {
    display: flex;
    gap: 5px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .blog-toolbar-footer :global(.admin-tab) {
    min-height: 29px;
    padding: 5px 9px;
    border-radius: 5px;
    font-size: .7rem;
  }

  .blog-toolbar-footer :global(.admin-tab:not(.active)) {
    background: var(--card);
  }

  .blog-admin-page :global(.admin-post-panel .admin-panel-content) {
    padding: 8px;
  }

  .blog-admin-page :global(.admin-post-list) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-group-title) {
    grid-column: 1 / -1;
    margin: 7px 2px 0;
    padding: 4px 6px 3px;
    border-bottom: 1px dashed var(--border-light);
    color: var(--primary-dark);
    font: 700 .68rem/1.2 'Courier New', monospace;
    letter-spacing: .12em;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-group-title:first-child) {
    margin-top: 0;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'head actions' 'body actions';
    gap: 3px 10px;
    align-items: center;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--border-light);
    border-radius: 5px;
    background: var(--card);
    transition: border-color .16s ease, background-color .16s ease;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item:hover) {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary-light) 10%, var(--card));
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head) {
    grid-area: head;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head h3) {
    overflow: hidden;
    margin: 0;
    font-size: .82rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head a) {
    color: var(--text);
    text-decoration: none;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head a:hover) {
    color: var(--primary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-body) {
    grid-area: body;
    min-width: 0;
    padding: 0;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 10px;
    overflow: hidden;
    color: var(--text-muted);
    font: .68rem/1.3 'Courier New', monospace;
    white-space: nowrap;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta span) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta i) {
    color: var(--primary-dark);
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-actions) {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 100%;
    padding: 0 0 0 10px;
    border-left: 1px solid var(--border-light);
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-actions .btn) {
    min-height: 28px;
    padding: 5px 8px;
  }

  .blog-admin-page :global(.admin-post-list > .admin-status) {
    margin: 0;
    padding: 13px 10px;
    border-style: dashed;
    text-align: center;
  }

  .blog-admin-page :global(.admin-post-list > .admin-empty-state) {
    min-height: 128px;
    padding: 18px 12px;
    border-style: dashed;
  }

  .blog-admin-page :global(.admin-post-list > .blog-filter-empty) {
    min-height: 84px;
  }

  @media (max-width: 560px) {
    .blog-toolbar-controls {
      grid-template-columns: 1fr 1fr;
    }

    .blog-toolbar-actions {
      grid-column: 1 / -1;
      justify-content: space-between;
    }

    .blog-toolbar-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .blog-admin-page :global(.admin-post-list .admin-list-item) {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'body' 'actions';
    }

    .blog-admin-page :global(.admin-post-list .admin-list-item-actions) {
      min-height: 0;
      padding: 6px 0 0;
      border-top: 1px solid var(--border-light);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-admin-page :global(.admin-post-list .admin-list-item) {
      transition: none;
    }
  }
</style>
