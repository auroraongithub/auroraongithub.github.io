---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
import AdminTabs from '../../components/admin/AdminTabs.astro';
import AdminPostList from '../../components/admin/AdminPostList.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Admin Blogs" active="blogs">
  <div class="blog-admin-page">
    <AdminPostWorkspace active="blogs">
      <Fragment slot="actions"><a class="btn btn-ghost" href="/admin/add-post/">Add Post</a></Fragment>
      <div class="blog-toolbar post-controls" role="search" aria-label="Filter blog posts">
        <div class="blog-toolbar-controls">
          <label class="post-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span class="visually-hidden">Search blogs</span>
            <input id="blogSearch" type="search" class="form-control" placeholder="Search the archive..." aria-label="Search blogs" autocomplete="off" />
          </label>
          <AdminField label="Year" forId="blogYear">
            <select id="blogYear">
              <option value="all">All years</option>
            </select>
          </AdminField>
          <div class="blog-toolbar-actions">
            <AdminStatus id="blogFilterStatus" />
            <button class="btn btn-ghost" type="button" id="blogFilterReset">Reset</button>
          </div>
        </div>
        <div class="blog-toolbar-footer tag-filters">
          <AdminTabs
            tabs={[{ id: 'all', label: 'All' }, { id: 'tagged', label: 'Tagged' }, { id: 'untagged', label: 'No tags' }]}
            dataAttribute="category"
          />
        </div>
      </div>
      <AdminPostList type="blog" title="Blogs" panel={false} />
    </AdminPostWorkspace>
  </div>
</AdminLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#blogSearch');
  const year = document.querySelector<HTMLSelectElement>('#blogYear');
  const reset = document.querySelector<HTMLButtonElement>('#blogFilterReset');
  const status = document.querySelector<HTMLElement>('#blogFilterStatus');
  const root = document.querySelector<HTMLElement>('[data-admin-post-list]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.blog-toolbar-footer [data-category]')];
  if (search && year && reset && status && root) {
    const searchInput = search;
    const yearSelect = year;
    const resetButton = reset;
    const filterStatus = status;
    const postRoot = root;
    let tagFilter = 'all';
    let filteredEmpty: HTMLElement | null = null;

    function syncYears() {
      const years = [...postRoot.querySelectorAll<HTMLElement>('.admin-list-group-title')]
        .map((heading) => heading.textContent?.trim() || '')
        .filter(Boolean);
      const current = yearSelect.value;
      yearSelect.innerHTML = '<option value="all">All years</option>';
      years.forEach((value) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        yearSelect.append(option);
      });
      yearSelect.value = years.includes(current) ? current : 'all';

      let activeYear = '';
      [...postRoot.children].forEach((child) => {
        const element = child as HTMLElement;
        if (element.classList.contains('admin-list-group-title')) activeYear = element.textContent?.trim() || '';
        if (element.classList.contains('admin-list-item')) element.dataset.blogYear = activeYear;
      });
    }

    function applyFilters() {
      const query = searchInput.value.trim().toLowerCase();
      const selectedYear = yearSelect.value;
      const rows = [...postRoot.querySelectorAll<HTMLElement>('.admin-list-item')];
      const headings = [...postRoot.querySelectorAll<HTMLElement>('.admin-list-group-title')];
      const filtering = Boolean(query || selectedYear !== 'all' || tagFilter !== 'all');
      let visible = 0;

      if (!rows.length) {
        filteredEmpty?.remove();
        filteredEmpty = null;
        filterStatus.textContent = '';
        filterStatus.hidden = true;
        return;
      }

      rows.forEach((row) => {
        const matchesQuery = !query || (row.textContent || '').toLowerCase().includes(query);
        const matchesYear = selectedYear === 'all' || row.dataset.blogYear === selectedYear;
        const meta = [...row.querySelectorAll<HTMLElement>('.admin-list-meta span')].map((item) => item.textContent?.trim().toLowerCase() || '');
        const hasTags = Boolean(meta[1] && !meta[1].includes('no tags'));
        const matchesTag = tagFilter === 'all' || (tagFilter === 'tagged' ? hasTags : !hasTags);
        row.hidden = !(matchesQuery && matchesYear && matchesTag);
        if (!row.hidden) visible += 1;
      });

      headings.forEach((heading) => {
        const headingYear = heading.textContent?.trim() || '';
        heading.hidden = !rows.some((row) => !row.hidden && row.dataset.blogYear === headingYear);
      });

      filterStatus.textContent = filtering ? `${visible} of ${rows.length} posts` : '';
      filterStatus.hidden = !filtering;
      filterStatus.dataset.state = visible ? '' : 'error';

      if (visible || !filtering) {
        filteredEmpty?.remove();
        filteredEmpty = null;
      } else if (!filteredEmpty) {
        filteredEmpty = document.createElement('div');
        filteredEmpty.className = 'admin-empty-state blog-filter-empty';
        filteredEmpty.innerHTML = '<i class="bi bi-search" aria-hidden="true"></i><strong>No matching posts</strong><span>Reset the filters to see all posts.</span>';
        postRoot.append(filteredEmpty);
      }
    }

    function setTagFilter(value: string) {
      tagFilter = value;
      tabs.forEach((tab) => {
        const active = tab.dataset.category === value;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      applyFilters();
    }

    const observer = new MutationObserver(() => {
      syncYears();
      applyFilters();
    });
    observer.observe(postRoot, { childList: true, subtree: true });

    searchInput.addEventListener('input', applyFilters);
    yearSelect.addEventListener('change', applyFilters);
    tabs.forEach((tab) => tab.addEventListener('click', () => setTagFilter(tab.dataset.category || 'all')));
    resetButton.addEventListener('click', () => {
      searchInput.value = '';
      yearSelect.value = 'all';
      setTagFilter('all');
      searchInput.focus();
    });

    syncYears();
    applyFilters();
  }
</script>

<style>
  .blog-admin-page {
    min-width: 0;
  }

  .blog-toolbar {
    display: grid;
    gap: 8px;
    margin: 0 0 10px;
    padding: 8px 9px;
    border: 1px solid var(--border-light);
    border-radius: 5px;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg-elev) 94%, var(--primary-light)), var(--bg-elev));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--primary-light) 45%, transparent);
  }

  .blog-toolbar-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 160px) auto;
    gap: 8px;
    align-items: end;
  }

  .blog-toolbar :global(.admin-field) {
    gap: 3px;
  }

  .blog-toolbar :global(.admin-field label) {
    font: 700 .65rem/1.2 'Courier New', monospace;
    letter-spacing: .08em;
  }

  .blog-toolbar :global(input),
  .blog-toolbar :global(select) {
    min-height: 32px;
    padding: 6px 8px;
    font-size: .75rem;
  }

  .blog-toolbar-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    min-height: 32px;
  }

  .blog-toolbar-actions :global(.admin-status) {
    margin: 0;
    padding: 5px 7px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: .68rem/1.2 'Courier New', monospace;
    white-space: nowrap;
  }

  .blog-toolbar-actions :global(.admin-status[data-state='error']) {
    color: var(--admin-danger);
  }

  .blog-toolbar-actions .btn {
    min-height: 32px;
  }

  .blog-toolbar-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 29px;
    padding-top: 7px;
    border-top: 1px dashed var(--border-light);
  }

  .blog-toolbar-footer :global(.admin-tabs) {
    display: flex;
    gap: 5px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .blog-toolbar-footer :global(.admin-tab) {
    min-height: 29px;
    padding: 5px 9px;
    border-radius: 5px;
    font-size: .7rem;
  }

  .blog-toolbar-footer :global(.admin-tab:not(.active)) {
    background: var(--card);
  }

  .blog-admin-page :global(.admin-post-panel .admin-panel-content) {
    padding: 8px;
  }

  .blog-admin-page :global(.admin-post-list) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-group-title) {
    grid-column: 1 / -1;
    margin: 7px 2px 0;
    padding: 4px 6px 3px;
    border-bottom: 1px dashed var(--border-light);
    color: var(--primary-dark);
    font: 700 .68rem/1.2 'Courier New', monospace;
    letter-spacing: .12em;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-group-title:first-child) {
    margin-top: 0;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'head actions' 'body actions';
    gap: 3px 10px;
    align-items: center;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--border-light);
    border-radius: 5px;
    background: var(--card);
    transition: border-color .16s ease, background-color .16s ease;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item:hover) {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary-light) 10%, var(--card));
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head) {
    grid-area: head;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head h3) {
    overflow: hidden;
    margin: 0;
    font-size: .82rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head a) {
    color: var(--text);
    text-decoration: none;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-head a:hover) {
    color: var(--primary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-body) {
    grid-area: body;
    min-width: 0;
    padding: 0;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 10px;
    overflow: hidden;
    color: var(--text-muted);
    font: .68rem/1.3 'Courier New', monospace;
    white-space: nowrap;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta span) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta i) {
    color: var(--primary-dark);
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-actions) {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 100%;
    padding: 0 0 0 10px;
    border-left: 1px solid var(--border-light);
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-actions .btn) {
    min-height: 28px;
    padding: 5px 8px;
  }

  .blog-admin-page :global(.admin-post-list > .admin-status) {
    margin: 0;
    padding: 13px 10px;
    border-style: dashed;
    text-align: center;
  }

  .blog-admin-page :global(.admin-post-list > .admin-empty-state) {
    min-height: 128px;
    padding: 18px 12px;
    border-style: dashed;
  }

  .blog-admin-page :global(.admin-post-list > .blog-filter-empty) {
    min-height: 84px;
  }

  @media (max-width: 560px) {
    .blog-toolbar-controls {
      grid-template-columns: 1fr 1fr;
    }

    .blog-toolbar-actions {
      grid-column: 1 / -1;
      justify-content: space-between;
    }

    .blog-toolbar-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .blog-admin-page :global(.admin-post-list .admin-list-item) {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'body' 'actions';
    }

    .blog-admin-page :global(.admin-post-list .admin-list-item-actions) {
      min-height: 0;
      padding: 6px 0 0;
      border-top: 1px solid var(--border-light);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-admin-page :global(.admin-post-list .admin-list-item) {
      transition: none;
    }
  }

  .blog-post-type-tabs {
    position: relative;
    z-index: 2;
    margin: 0 0 -1px;
  }

  .blog-post-type-tabs :global(.admin-tabs) {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0 0 0 3px;
    border: 0;
  }

  .blog-post-type-tabs :global(.admin-tab) {
    min-height: 27px;
    padding: 5px 10px;
    border: 1px solid var(--primary-dark);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
    background: color-mix(in srgb, var(--primary-light) 25%, var(--bg-elev));
    color: var(--text-muted);
    font: 700 .68rem/1 'MS PGothic', 'MS UI Gothic', Tahoma, sans-serif;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .blog-post-type-tabs :global(.admin-tab:hover) {
    background: var(--gradient-subtle);
    color: var(--primary-dark);
  }

  .blog-post-type-tabs :global(.admin-tab.active) {
    border-bottom-color: var(--bg-elev);
    background: var(--bg-elev);
    color: var(--primary-dark);
  }

  .blog-toolbar {
    gap: 5px;
    margin-bottom: 8px;
    padding: 6px 8px 5px;
    border-color: var(--primary-dark);
    border-radius: 0 6px 6px 6px;
    background: color-mix(in srgb, var(--bg-elev) 94%, var(--primary-light));
    box-shadow: inset 1px 1px 0 color-mix(in srgb, var(--primary-light) 48%, transparent), 1px 2px 0 var(--halo);
  }

  .blog-toolbar-controls {
    grid-template-columns: minmax(0, 1fr) minmax(110px, 145px) auto;
    gap: 6px;
  }

  .blog-toolbar :global(.admin-field label) {
    color: var(--primary-dark);
    font: 700 .62rem/1.2 'MS PGothic', 'MS UI Gothic', Tahoma, sans-serif;
    letter-spacing: .08em;
  }

  .blog-toolbar :global(input),
  .blog-toolbar :global(select) {
    min-height: 29px;
    padding: 5px 7px;
    border-color: var(--border-light);
    border-radius: 4px;
    font-size: .72rem;
  }

  .blog-toolbar-actions,
  .blog-toolbar-actions .btn {
    min-height: 29px;
  }

  .blog-toolbar-actions .btn {
    padding: 5px 8px;
    border-radius: 4px;
    font: 700 .66rem/1 'MS PGothic', 'MS UI Gothic', Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .blog-toolbar-footer {
    min-height: 26px;
    padding-top: 5px;
  }

  .blog-toolbar-footer :global(.admin-tab) {
    min-height: 25px;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: .64rem;
  }

  .blog-admin-page :global(.admin-post-panel) {
    padding: 3px;
    overflow: visible;
    border: 2px solid var(--primary);
    border-right-color: var(--primary-dark);
    border-bottom-color: var(--primary-dark);
    border-radius: 0 9px 9px 9px;
    background: color-mix(in srgb, var(--primary-light) 28%, var(--bg-elev));
    box-shadow: 0 0 0 2px var(--halo), 3px 3px 0 var(--halo), 2px 2px 5px rgba(0, 0, 0, .18);
  }

  .blog-admin-page :global(.admin-post-panel:hover) {
    transform: none;
    box-shadow: 0 0 0 2px var(--halo), 3px 3px 0 var(--halo), 2px 2px 5px rgba(0, 0, 0, .18);
  }

  .blog-admin-page :global(.admin-post-panel > .admin-panel-header) {
    padding: 7px 10px;
    border: 1px solid var(--primary-dark);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
    background-image: repeating-linear-gradient(45deg, var(--primary-light), var(--primary-light) 6px, var(--primary) 6px, var(--primary) 12px);
    background-size: 17px 17px;
    color: #fff;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 85%, #000);
  }

  .blog-admin-page :global(.admin-post-panel > .admin-panel-header h2) {
    color: #fff;
    font: 700 .78rem/1 'MS PGothic', 'MS UI Gothic', Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .blog-admin-page :global(.admin-post-panel > .admin-panel-content) {
    padding: 8px;
    border: 1px solid var(--primary-dark);
    border-radius: 0 0 7px 7px;
    background: var(--bg-elev);
  }

  .blog-admin-page :global(.admin-panel-actions .btn) {
    min-height: 26px;
    padding: 4px 8px;
    border-radius: 4px;
    font: 700 .64rem/1 'MS PGothic', 'MS UI Gothic', Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-meta i) {
    display: none;
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item) {
    border-radius: 4px;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--card) 94%, var(--primary-light)), var(--card));
    box-shadow: inset 1px 1px 0 color-mix(in srgb, var(--primary-light) 34%, transparent), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item:hover) {
    background: var(--gradient-subtle);
    box-shadow: inset 1px 1px 0 color-mix(in srgb, var(--primary-light) 38%, transparent), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 20%, transparent);
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-actions) {
    border-left-color: var(--border-light);
    background: color-mix(in srgb, var(--bg-elev) 76%, var(--primary-light));
  }

  .blog-admin-page :global(.admin-post-list .admin-list-item-actions .btn) {
    min-height: 25px;
    padding: 4px 7px;
    border-radius: 4px;
    font: 700 .62rem/1 'MS PGothic', 'MS UI Gothic', Tahoma, sans-serif;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .blog-post-type-tabs :global(.admin-tab) {
      flex: 1;
      justify-content: center;
    }
  }

  /* Keep the archive controls in the same mail-shelf language as /blogs/. */
  .blog-admin-page :global(.blog-toolbar.post-controls) {
    display: grid;
    gap: 6px;
    margin: 0 0 9px;
    padding: 0 0 8px;
    border: 0;
    border-bottom: 1px dotted var(--primary-dark);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .blog-admin-page :global(.blog-toolbar .post-search) {
    position: relative;
    display: block;
    min-width: 0;
  }

  .blog-admin-page :global(.blog-toolbar .post-search > i) {
    position: absolute;
    top: 50%;
    left: 9px;
    z-index: 1;
    color: var(--primary-dark);
    font-size: .74rem;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .blog-admin-page :global(.blog-toolbar .post-search .form-control) {
    height: 28px;
    min-height: 28px;
    box-sizing: border-box;
    padding: 7px 9px 7px 25px;
    border: 1px solid var(--primary-dark);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev) 0%, color-mix(in srgb, var(--primary-light) 18%, var(--bg-elev)) 45%, color-mix(in srgb, var(--primary-dark) 12%, var(--bg-elev)) 50%, var(--bg-elev) 100%);
    color: var(--text);
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-size: .76rem;
    line-height: normal;
    box-shadow: inset 1px 1px 2px rgba(0, 0, 0, .12), inset 0 1px 0 rgba(255, 255, 255, .75);
  }

  .blog-admin-page :global(.blog-toolbar .post-search .form-control:focus) {
    outline: 1px solid var(--primary);
    border-color: var(--primary-dark);
    box-shadow: inset 1px 1px 2px rgba(0, 0, 0, .12), 0 0 0 2px color-mix(in srgb, var(--primary-light) 30%, transparent);
  }

  .blog-admin-page :global(.blog-toolbar .admin-field label) {
    color: var(--primary-dark);
    font: 700 .62rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .blog-admin-page :global(.blog-toolbar .admin-field select) {
    height: 28px;
    min-height: 28px;
    box-sizing: border-box;
    padding: 7px 8px;
    border: 1px solid var(--primary-dark);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 18%, var(--bg-elev)));
    color: var(--text);
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-size: .76rem;
    line-height: normal;
  }

  .blog-admin-page :global(.blog-toolbar-actions) {
    min-height: 0;
    align-items: end;
    gap: 5px;
  }

  .blog-admin-page :global(.blog-toolbar-actions .admin-status) {
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .blog-admin-page :global(.blog-toolbar-actions .btn) {
    height: 20px;
    min-height: 20px;
    padding: 4px 8px;
    box-sizing: border-box;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 18%, var(--bg-elev)));
    color: var(--text-muted);
    font: 700 .66rem/normal "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .8);
    text-transform: uppercase;
  }

  .blog-admin-page :global(.blog-toolbar-actions .btn:hover) {
    border-color: var(--primary);
    background: linear-gradient(to bottom, var(--primary-light), var(--primary));
    color: var(--bg);
    transform: none;
  }

  .blog-admin-page :global(.blog-toolbar-footer.tag-filters) {
    display: flex;
    min-height: 0;
    align-items: end;
    justify-content: flex-start;
    gap: 3px;
    padding: 0;
    border: 0;
  }

  .blog-admin-page :global(.blog-toolbar-footer .admin-tabs) {
    display: contents;
  }

  .blog-admin-page :global(.blog-toolbar-footer .admin-tab) {
    height: 20px;
    min-height: 20px !important;
    box-sizing: border-box;
