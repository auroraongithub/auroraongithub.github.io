---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
---
<AdminLayout title="Resources Editor" active="resources" bodyClass="admin-resources-page">
  <Fragment slot="head"><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /></Fragment>
  <AdminPostWorkspace active="scanlation" tabs={[{id:'scanlation',label:'Scanlation'},{id:'youtube',label:'YouTube'}]}>
    <Fragment slot="actions">
      <button class="admin-add-post-tab" id="addResourcePanel" type="button" aria-label="Add resource panel" title="Add resource panel">+</button>
    </Fragment>
    <div id="resourcePanels" class="admin-resource-list"><p class="admin-status" data-state="loading">Loading…</p></div>
    <div class="resources-actions">
      <AdminStatus id="resourceMessage" />
      <div class="resources-action-buttons">
        <button class="btn btn-ghost" id="discardResources" type="button">Discard</button>
        <button class="btn btn-primary" id="saveResources" type="button">Save</button>
      </div>
    </div>
  </AdminPostWorkspace>
  <script is:inline src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
  <script>
    import { adminFetch, escapeHtml, setAdminStatus } from '../../lib/admin/api';
    type Panel={title?:string;content?:string}; let category='scanlation'; let panels:Panel[]=[]; let editors:any[]=[];
    const list=document.querySelector<HTMLElement>('#resourcePanels')!; const message=document.querySelector<HTMLElement>('#resourceMessage'); const QuillCtor=(window as any).Quill;
    function collect(){panels.forEach((panel,index)=>{const input=list.querySelector<HTMLInputElement>(`[data-panel-title="${index}"]`);if(input)panel.title=input.value;if(editors[index])panel.content=editors[index].root.innerHTML;});}
    function render(){editors=[];if(!panels.length){list.innerHTML='<div class="admin-empty-state"><i class="bi bi-inbox"></i><span>No panels yet.</span></div>';return;}list.innerHTML=panels.map((panel,index)=>`<article class="admin-resource-panel" data-index="${index}"><header><div class="admin-resource-panel-title"><span class="admin-resource-panel-index">${String(index+1).padStart(2,'0')}</span><input data-panel-title="${index}" value="${escapeHtml(panel.title||'')}" placeholder="Panel title…"></div><div class="admin-resource-panel-actions"><button class="btn btn-ghost" type="button" data-move="-1" data-index="${index}" aria-label="Move panel up" ${index===0?'disabled':''}><i class="bi bi-arrow-up" aria-hidden="true"></i><span>Up</span></button><button class="btn btn-ghost" type="button" data-move="1" data-index="${index}" aria-label="Move panel down" ${index===panels.length-1?'disabled':''}><i class="bi bi-arrow-down" aria-hidden="true"></i><span>Down</span></button><button class="btn btn-ghost admin-danger" type="button" data-remove data-index="${index}" aria-label="Delete panel"><i class="bi bi-trash3" aria-hidden="true"></i><span>Delete</span></button></div></header><div class="admin-resource-editor" id="resource-editor-${index}"></div></article>`).join('');panels.forEach((panel,index)=>{const el=document.getElementById(`resource-editor-${index}`);if(!el||!QuillCtor)return;const q=new QuillCtor(el,{theme:'snow',modules:{toolbar:[[{header:[1,2,3,false]}],['bold','italic','underline','strike'],[{color:[]},{background:[]}],[{list:'ordered'},{list:'bullet'}],['blockquote','code-block'],['link','image'],['clean']]}});q.root.innerHTML=panel.content||'';editors[index]=q;});}
    async function load(){list.innerHTML='<p class="admin-status" data-state="loading">Loading…</p>';setAdminStatus(message);try{const response=await adminFetch(`/site/resources?category=${encodeURIComponent(category)}`,{}, {auth:false});const data=await response.json();if(!response.ok)throw new Error(data.error||'Failed to load');panels=Array.isArray(data.panels)?data.panels:[];render();}catch(error){list.innerHTML='';setAdminStatus(message,error instanceof Error?error.message:'Failed to load','error')}}
    document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((button)=>button.addEventListener('click',()=>{collect();category=button.dataset.category||'scanlation';document.querySelectorAll('[data-category]').forEach((item)=>{item.classList.toggle('active',item===button);item.setAttribute('aria-selected',String(item===button));});load();}));
    list.addEventListener('click',(event)=>{const target=event.target as HTMLElement;const remove=target.closest<HTMLButtonElement>('[data-remove]');const move=target.closest<HTMLButtonElement>('[data-move]');if(remove){const index=Number(remove.dataset.index);if(window.confirm('Delete this panel?')){collect();panels.splice(index,1);render();}}if(move){const index=Number(move.dataset.index);const delta=Number(move.dataset.move);const next=index+delta;if(next<0||next>=panels.length)return;collect();[panels[index],panels[next]]=[panels[next],panels[index]];render();}});
    document.querySelector('#addResourcePanel')?.addEventListener('click',()=>{collect();panels.push({title:'',content:''});render();list.querySelector<HTMLElement>('.admin-resource-panel:last-child')?.scrollIntoView({behavior:'smooth',block:'center'});});
    document.querySelector('#discardResources')?.addEventListener('click',load);
    document.querySelector('#saveResources')?.addEventListener('click',async()=>{collect();const valid=panels.filter((panel)=>panel.title||(panel.content&&panel.content!=='<p><br></p>'));setAdminStatus(message,'Saving…','loading');try{const response=await adminFetch('/admin/resources',{method:'PUT',body:JSON.stringify({category,panels:valid})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Failed to save');panels=valid;render();setAdminStatus(message,'Resources saved.','success');}catch(error){setAdminStatus(message,error instanceof Error?error.message:'Failed to save','error')}}); load();
  </script>
  <style is:global>
    .scanlation-section .admin-post-workspace-content {
      gap: 6px;
    }

    .scanlation-section .admin-resource-list {
      display: grid;
      gap: 6px;
    }

    .scanlation-section .admin-resource-panel {
      overflow: hidden;
      border: 1px solid var(--primary-dark);
      border-radius: 5px;
      background: var(--card);
      box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .7), 1px 1px 2px rgba(0, 0, 0, .14);
    }

    .scanlation-section .admin-resource-panel:hover {
      border-color: var(--primary-dark);
      background: var(--card);
      box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .7), 1px 1px 2px rgba(0, 0, 0, .14);
    }

    .scanlation-section .admin-resource-panel > header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 9px;
      background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
      border-bottom: 1px solid var(--primary-dark);
      box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .6);
    }

    .scanlation-section .admin-resource-panel-title {
      display: flex;
      align-items: center;
      min-width: 0;
      flex: 1;
      gap: 7px;
    }

    .scanlation-section .admin-resource-panel-index {
      display: grid;
      place-items: center;
      flex-basis: 25px;
      height: 22px;
      border: 1px solid color-mix(in srgb, var(--primary-dark) 60%, var(--primary-light));
      border-radius: 4px;
      background: color-mix(in srgb, var(--bg-elev) 78%, transparent);
      color: var(--bg);
      font: 700 .66rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
      text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 80%, #000);
    }

    .scanlation-section .admin-resource-panel-title > input {
      min-width: 0;
      flex: 1;
      min-height: 32px;
      padding: 6px 8px;
      box-sizing: border-box;
      border: 1px solid var(--primary-dark) !important;
      border-top-color: var(--primary-light) !important;
      border-left-color: var(--primary-light) !important;
      border-radius: 4px;
      background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev))) !important;
      color: var(--text);
      box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .72), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
      font: 700 .78rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    }

    .scanlation-section .admin-resource-panel-title > input:focus-visible {
      outline: 1px solid var(--primary);
      border-color: var(--primary-dark) !important;
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary-light) 30%, transparent), inset 1px 1px 0 rgba(255, 255, 255, .72);
    }

    .scanlation-section .admin-resource-panel-actions {
      display: flex;
      align-items: center;
      flex: 0 0 auto;
      gap: 4px;
    }

    .scanlation-section .admin-resource-panel-actions .btn {
      min-height: 28px;
      padding: 5px 8px;
      border: 1px solid var(--primary-dark);
      border-radius: 4px;
      background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 18%, var(--bg-elev)));
      color: var(--primary-dark);
      box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .8), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
      font: 700 .68rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
      text-transform: uppercase;
    }

    .scanlation-section .admin-resource-panel-actions .btn:hover:not(:disabled) {
      border-color: var(--primary-dark);
      background: linear-gradient(to bottom, var(--primary-light), var(--primary));
      color: var(--bg);
      transform: none;
    }

    .scanlation-section .admin-resource-panel-actions .admin-danger {
      color: var(--admin-danger, #b42318);
    }

    .scanlation-section .admin-resource-editor {
      min-height: 0;
      overflow: hidden;
      background: var(--card);
    }

    .scanlation-section .admin-resource-editor .ql-toolbar.ql-snow {
      padding: 6px 7px;
      border: 0;
      border-bottom: 1px solid var(--primary-dark);
      background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
    }

    .scanlation-section .admin-resource-editor .ql-container.ql-snow {
      border: 0;
      background: var(--card);
    }

    .scanlation-section .admin-resource-editor .ql-editor {
      min-height: 230px;
      padding: 12px;
      color: var(--text);
      font: .78rem/1.55 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    }

    .scanlation-section .admin-resource-editor .ql-editor.ql-blank::before {
      color: var(--text-muted);
      font: italic .76rem/1.5 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    }

    .resources-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-top: 7px;
      border-top: 1px dotted var(--border-light);
    }

    .resources-actions .admin-status {
      margin: 0;
      padding: 4px 0;
      border: 0;
      background: transparent;
      font: .68rem/1.3 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    }

    .resources-action-buttons {
      display: flex;
      gap: 5px;
      margin-left: auto;
    }

    .resources-action-buttons .btn {
      min-height: 29px;
      padding: 5px 9px;
      border: 1px solid var(--primary-dark);
      border-radius: 4px;
      background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary-light));
      color: var(--bg);
      box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .6), 1px 1px 2px rgba(0, 0, 0, .16);
      font: 700 .68rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
      text-transform: uppercase;
    }

    .resources-action-buttons .btn:hover {
      background: var(--primary);
      transform: none;
    }

    @media (max-width: 600px) {
      .scanlation-section .admin-resource-panel > header {
        align-items: stretch;
        flex-direction: column;
      }

      .scanlation-section .admin-resource-panel-actions {
        justify-content: flex-end;
      }
    }

    @media (max-width: 420px) {
      .scanlation-section .admin-resource-panel-actions .btn span {
        display: none;
      }

      .scanlation-section .admin-resource-panel-actions .btn {
        min-width: 32px;
        justify-content: center;
      }

      .resources-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .resources-action-buttons {
        margin-left: 0;
      }

      .resources-action-buttons .btn {
        flex: 1;
      }
    }
  </style>
</AdminLayout>
