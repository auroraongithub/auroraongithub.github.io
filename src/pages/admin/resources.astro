---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPanel from '../../components/admin/AdminPanel.astro';
import AdminTabs from '../../components/admin/AdminTabs.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
---
<AdminLayout title="Resources Editor" active="resources">
  <Fragment slot="head"><link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" /></Fragment>
  <AdminPanel title="Resources Editor" icon="bi-journal-richtext">
    <AdminTabs tabs={[{id:'scanlation',label:'Scanlation'},{id:'youtube',label:'YouTube'}]} dataAttribute="category" />
    <div id="resourcePanels" class="admin-resource-list"><p class="admin-status" data-state="loading">Loading…</p></div>
    <AdminStatus id="resourceMessage" />
    <div class="admin-resource-actions"><button class="btn btn-primary" id="addResourcePanel" type="button">Add New Panel</button></div>
    <div class="admin-sticky-actions"><button class="btn btn-ghost" id="discardResources" type="button">Discard Changes</button><button class="btn btn-primary" id="saveResources" type="button">Save All Panels</button></div>
  </AdminPanel>
  <script is:inline src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
  <script>
    import { adminFetch, escapeHtml, setAdminStatus } from '../../lib/admin/api';
    type Panel={title?:string;content?:string}; let category='scanlation'; let panels:Panel[]=[]; let editors:any[]=[];
    const list=document.querySelector<HTMLElement>('#resourcePanels')!; const message=document.querySelector<HTMLElement>('#resourceMessage'); const QuillCtor=(window as any).Quill;
    function collect(){panels.forEach((panel,index)=>{const input=list.querySelector<HTMLInputElement>(`[data-panel-title="${index}"]`);if(input)panel.title=input.value;if(editors[index])panel.content=editors[index].root.innerHTML;});}
    function render(){editors=[];if(!panels.length){list.innerHTML='<div class="admin-empty-state"><i class="bi bi-inbox"></i><span>No panels yet. Add one below.</span></div>';return;}list.innerHTML=panels.map((panel,index)=>`<article class="admin-resource-panel" data-index="${index}"><header><input data-panel-title="${index}" value="${escapeHtml(panel.title||'')}" placeholder="Panel title…"><div><button class="btn btn-ghost" type="button" data-move="-1" data-index="${index}" ${index===0?'disabled':''}>Up</button><button class="btn btn-ghost" type="button" data-move="1" data-index="${index}" ${index===panels.length-1?'disabled':''}>Down</button><button class="btn btn-ghost admin-danger" type="button" data-remove data-index="${index}">Delete</button></div></header><div class="admin-resource-editor" id="resource-editor-${index}"></div></article>`).join('');panels.forEach((panel,index)=>{const el=document.getElementById(`resource-editor-${index}`);if(!el||!QuillCtor)return;const q=new QuillCtor(el,{theme:'snow',modules:{toolbar:[[{header:[1,2,3,false]}],['bold','italic','underline','strike'],[{color:[]},{background:[]}],[{list:'ordered'},{list:'bullet'}],['blockquote','code-block'],['link','image'],['clean']]}});q.root.innerHTML=panel.content||'';editors[index]=q;});}
    async function load(){list.innerHTML='<p class="admin-status" data-state="loading">Loading…</p>';setAdminStatus(message);try{const response=await adminFetch(`/site/resources?category=${encodeURIComponent(category)}`,{}, {auth:false});const data=await response.json();if(!response.ok)throw new Error(data.error||'Failed to load');panels=Array.isArray(data.panels)?data.panels:[];render();}catch(error){list.innerHTML='';setAdminStatus(message,error instanceof Error?error.message:'Failed to load','error')}}
    document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((button)=>button.addEventListener('click',()=>{collect();category=button.dataset.category||'scanlation';document.querySelectorAll('[data-category]').forEach((item)=>{item.classList.toggle('active',item===button);item.setAttribute('aria-selected',String(item===button));});load();}));
    list.addEventListener('click',(event)=>{const target=event.target as HTMLElement;const remove=target.closest<HTMLButtonElement>('[data-remove]');const move=target.closest<HTMLButtonElement>('[data-move]');if(remove){const index=Number(remove.dataset.index);if(window.confirm('Delete this panel?')){collect();panels.splice(index,1);render();}}if(move){const index=Number(move.dataset.index);const delta=Number(move.dataset.move);const next=index+delta;if(next<0||next>=panels.length)return;collect();[panels[index],panels[next]]=[panels[next],panels[index]];render();}});
    document.querySelector('#addResourcePanel')?.addEventListener('click',()=>{collect();panels.push({title:'',content:''});render();list.querySelector<HTMLElement>('.admin-resource-panel:last-child')?.scrollIntoView({behavior:'smooth',block:'center'});});
    document.querySelector('#discardResources')?.addEventListener('click',load);
    document.querySelector('#saveResources')?.addEventListener('click',async()=>{collect();const valid=panels.filter((panel)=>panel.title||(panel.content&&panel.content!=='<p><br></p>'));setAdminStatus(message,'Saving…','loading');try{const response=await adminFetch('/admin/resources',{method:'PUT',body:JSON.stringify({category,panels:valid})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Failed to save');panels=valid;render();setAdminStatus(message,'Resources saved.','success');}catch(error){setAdminStatus(message,error instanceof Error?error.message:'Failed to save','error')}}); load();
  </script>
  <style>.admin-resource-list{display:grid;gap:9px}.admin-resource-panel{border:1px solid var(--border-light);border-radius:7px;overflow:hidden;background:var(--card)}.admin-resource-panel>header{display:flex;align-items:center;gap:8px;padding:8px;background:var(--gradient-subtle);border-bottom:1px solid var(--border-light)}.admin-resource-panel>header>input{flex:1;background:transparent!important;border:0!important;font-weight:600}.admin-resource-panel>header>div{display:flex;gap:4px}.admin-resource-editor{min-height:150px}.admin-resource-editor .ql-editor{min-height:120px}.admin-resource-actions{margin-top:10px}@media(max-width:600px){.admin-resource-panel>header{align-items:stretch;flex-direction:column}.admin-resource-panel>header>div{justify-content:flex-end}}</style>
</AdminLayout>
