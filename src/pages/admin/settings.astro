---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Site Settings" active="settings">
  <AdminPostWorkspace active="settings" tabs={[{ id: 'settings', label: 'Settings' }]}>
    <form id="settingsForm" class="admin-form settings-form">
      <div class="settings-fields">
        <AdminField label="Spotify link" forId="spotifyUrl">
          <input id="spotifyUrl" type="text" placeholder="https://open.spotify.com/track/…" />
        </AdminField>
        <div class="settings-spotify-connection" id="spotifyConnection">
          <div>
            <span class="settings-connection-label">Spotify API</span>
            <span id="spotifyConnectionState" data-state="loading">Checking connection…</span>
          </div>
          <button class="btn btn-ghost" id="spotifyConnectButton" type="button">Connect Spotify</button>
        </div>
        <AdminField label="Chat room" forId="chattableRoom">
          <input id="chattableRoom" type="text" placeholder="nijikade" />
        </AdminField>
      </div>

      <span class="settings-preview-label">Spotify preview</span>
      <div id="spotifyPreview">Enter a Spotify URL to see preview.</div>

      <div class="settings-actions">
        <button class="btn btn-primary" id="settingsSaveButton" type="submit">Save</button>
      </div>
    </form>
  </AdminPostWorkspace>
</AdminLayout>

<script>
  import { ADMIN_API_BASE, adminFetch, getAdminToken } from '../../lib/admin/api';
  import { spotifyToEmbed } from '../../lib/admin/spotify';

  const spotify = document.querySelector<HTMLInputElement>('#spotifyUrl')!;
  const room = document.querySelector<HTMLInputElement>('#chattableRoom')!;
  const preview = document.querySelector<HTMLElement>('#spotifyPreview')!;
  const saveButton = document.querySelector<HTMLButtonElement>('#settingsSaveButton')!;
  const spotifyConnectionState = document.querySelector<HTMLElement>('#spotifyConnectionState')!;
  const spotifyConnectButton = document.querySelector<HTMLButtonElement>('#spotifyConnectButton')!;
  const defaultSaveLabel = saveButton.textContent || 'Save';

  function setSaveState(label: string, disabled: boolean): void {
    saveButton.textContent = label;
    saveButton.disabled = disabled;
  }

  const updatePreview = () => {
    const url = spotify.value.trim();
    const embed = spotifyToEmbed(url);
    preview.replaceChildren();

    if (!url) {
      preview.textContent = 'Enter a Spotify URL to see preview.';
      return;
    }

    if (!embed.includes('spotify.com/embed')) {
      preview.textContent = 'Could not parse Spotify URL.';
      return;
    }

    const iframe = document.createElement('iframe');
    iframe.src = embed;
    iframe.width = '100%';
    iframe.height = /\/embed\/(track|episode)\//.test(embed) ? '80' : '152';
    iframe.loading = 'lazy';
    iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
    iframe.style.border = '0';
    iframe.style.display = 'block';

    const note = document.createElement('small');
    note.className = 'settings-preview-note';
    note.textContent = `Will be saved as: ${embed}`;
    preview.append(iframe, note);
  };

  spotify.addEventListener('input', updatePreview);

  function setSpotifyConnectionState(label: string, state = '') {
    spotifyConnectionState.textContent = label;
    spotifyConnectionState.dataset.state = state;
  }

  async function loadSpotifyConnection() {
    try {
      const response = await adminFetch('/admin/spotify/status');
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to load Spotify status');

      if (!data.configured) {
        setSpotifyConnectionState('API credentials are not configured', 'error');
        spotifyConnectButton.disabled = true;
      } else if (data.connected) {
        setSpotifyConnectionState(data.profile?.display_name ? `Connected as ${data.profile.display_name}` : 'Connected', 'success');
        spotifyConnectButton.textContent = 'Disconnect';
        spotifyConnectButton.disabled = false;
      } else {
        setSpotifyConnectionState('Not connected', '');
        spotifyConnectButton.textContent = 'Connect Spotify';
        spotifyConnectButton.disabled = false;
      }
    } catch (error) {
      setSpotifyConnectionState(error instanceof Error ? error.message : 'Spotify status unavailable', 'error');
      spotifyConnectButton.disabled = true;
    }
  }

  spotifyConnectButton.addEventListener('click', async () => {
    const token = getAdminToken();
    if (!token) return;

    if (spotifyConnectButton.textContent === 'Disconnect') {
      spotifyConnectButton.disabled = true;
      try {
        const response = await adminFetch('/admin/spotify', { method: 'DELETE' });
        if (!response.ok) throw new Error('Failed to disconnect Spotify');
        await loadSpotifyConnection();
      } catch (error) {
        setSpotifyConnectionState(error instanceof Error ? error.message : 'Failed to disconnect Spotify', 'error');
        spotifyConnectButton.disabled = false;
      }
      return;
    }

    spotifyConnectButton.disabled = true;
    setSpotifyConnectionState('Opening Spotify…', 'loading');
    try {
      const response = await fetch(`${ADMIN_API_BASE}/admin/spotify/connect`, {
        method: 'POST',
        headers: { Authorization: token, accept: 'application/json' }
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.authorization_url) throw new Error(data.error || 'Failed to start Spotify authorization');
      window.location.assign(data.authorization_url);
    } catch (error) {
      setSpotifyConnectionState(error instanceof Error ? error.message : 'Failed to connect Spotify', 'error');
      spotifyConnectButton.disabled = false;
    }
  });

  const spotifyResult = new URLSearchParams(window.location.search).get('spotify');
  if (spotifyResult === 'connected') setSpotifyConnectionState('Connected — loading account…', 'success');
  if (spotifyResult === 'denied') setSpotifyConnectionState('Spotify authorization was cancelled', 'error');
  if (spotifyResult === 'invalid_state') setSpotifyConnectionState('Spotify authorization expired. Try again.', 'error');
  if (spotifyResult === 'error') setSpotifyConnectionState('Spotify authorization failed. Try again.', 'error');
  if (spotifyResult) window.history.replaceState({}, '', window.location.pathname);

  (async () => {
    try {
      const response = await adminFetch('/site/settings', {}, { auth: false });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to load');
      spotify.value = data.spotify_embed_url || '';
      room.value = data.chattable_room || 'nijikade';
      updatePreview();
    } catch (_) {}
  })();

  void loadSpotifyConnection();

  document.querySelector<HTMLFormElement>('#settingsForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setSaveState('Saving…', true);
    try {
      const response = await adminFetch('/admin/settings', {
        method: 'PUT',
        body: JSON.stringify({
          spotify_embed_url: spotifyToEmbed(spotify.value),
          chattable_room: room.value
        })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to save');
      setSaveState('Saved.', true);
      window.setTimeout(() => setSaveState(defaultSaveLabel, false), 1100);
    } catch {
      setSaveState('Retry', false);
    }
  });
</script>

<style is:global>
  .settings-form {
    max-width: none;
    margin: 0;
    gap: 9px;
  }

  .settings-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .settings-spotify-connection {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    min-width: 0;
    padding: 8px;
    border: 1px dotted color-mix(in srgb, var(--primary-dark) 54%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--bg-elev) 72%, transparent);
  }

  .settings-spotify-connection > div {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .settings-connection-label {
    color: var(--primary-dark);
    font: 700 .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #spotifyConnectionState {
    overflow: hidden;
    color: var(--text-muted);
    font: .72rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #spotifyConnectionState[data-state='success'] { color: var(--primary-dark); }
  #spotifyConnectionState[data-state='error'] { color: var(--danger, #b42e2e); }

  .settings-spotify-connection .btn {
    flex: 0 0 auto;
    min-height: 29px;
    padding: 5px 10px;
    font: 700 .68rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .settings-form .admin-field {
    min-width: 0;
    gap: 3px;
  }

  .settings-form .admin-field > label,
  .settings-preview-label {
    color: var(--primary-dark);
    font: 700 .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .admin-page .settings-form input:not([type='checkbox']):not([type='radio']) {
    min-height: 32px;
    padding: 6px 8px;
    border: 1px solid var(--primary-dark);
    border-top-color: var(--primary-light);
    border-left-color: var(--primary-light);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev)));
    color: var(--text);
    font: .78rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .admin-page .settings-form input:not([type='checkbox']):not([type='radio'])::placeholder {
    color: var(--text-muted);
    opacity: .78;
  }

  .admin-page .settings-form input:not([type='checkbox']):not([type='radio']):focus-visible {
    outline: 1px solid var(--primary);
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary-light) 30%, transparent), inset 1px 1px 0 rgba(255, 255, 255, .72);
  }

  .settings-preview-label {
    display: block;
    padding-top: 8px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 52%, transparent);
  }

  #spotifyPreview {
    display: contents;
    color: var(--text-muted);
    font: .72rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    overflow-wrap: anywhere;
  }

  #spotifyPreview iframe {
    width: 100%;
    max-width: 100%;
    border: 0 !important;
  }

  #spotifyPreview small {
    color: var(--text-muted);
    font: .68rem/1.3 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .settings-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: 8px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 52%, transparent);
  }

  .settings-actions .btn {
    min-height: 29px;
    padding: 5px 12px;
    font: 700 .7rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .settings-fields {
      grid-template-columns: 1fr;
    }

    .settings-actions .btn {
      width: 100%;
    }
  }
</style>
