---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPostList from '../../components/admin/AdminPostList.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Admin Stories" active="stories">
  <div class="admin-stories-page">
    <AdminPostWorkspace active="stories">
      <Fragment slot="actions"><a class="btn btn-ghost" href="/admin/add-post/">Add Post</a></Fragment>
      <AdminPostList type="story" title="Stories" panel={false} />
    </AdminPostWorkspace>
  </div>
</AdminLayout>

<style is:global>
  .admin-stories-page {
    min-width: 0;
  }

  @media (max-width: 700px) {
    .admin-stories-page .admin-post-list .admin-list-item { grid-template-columns: minmax(0, 1fr) auto; }
  }

  @media (max-width: 480px) {
    .admin-stories-page .admin-post-list .admin-list-item {
      grid-template-columns: 1fr;
      grid-template-areas: "head" "body" "actions";
    }

    .admin-stories-page .admin-post-list .admin-list-item-actions {
      justify-content: flex-end;
      border-top: 1px solid var(--border-light);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .admin-stories-page .admin-post-list .admin-list-item {
      transition: none;
    }
  }
</style>
