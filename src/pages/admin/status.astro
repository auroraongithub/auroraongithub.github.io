---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Admin Status" active="status">
  <div class="admin-status-page">
    <AdminPostWorkspace active="status" tabs={[{ id: 'status', label: 'Status' }]}>
        <div class="status-layout">
          <form id="statusForm" class="admin-form status-form">
            <div class="status-form-fields">
              <AdminField label="Feeling" forId="feeling">
                <input id="feeling" type="text" placeholder="Happy, tired, excited..." />
              </AdminField>
              <AdminField label="Currently doing" forId="doing">
                <input id="doing" type="text" placeholder="Working on projects..." />
              </AdminField>
            </div>

            <AdminField label="Marquee text" forId="marquee">
              <input id="marquee" type="text" placeholder="Scrolling message..." />
            </AdminField>

            <div class="status-form-footer">
              <AdminStatus id="statusMessage" />
              <button class="btn btn-primary" type="submit">Save status</button>
            </div>
          </form>

          <div class="status-preview" aria-label="Status preview">
            <div class="status-preview-label">Preview</div>
            <div class="status-strip-screen admin-status-preview">
              <div class="status-strip-content">
                <div class="status-info">
                  <span class="status-feeling" id="previewFeeling">Feeling</span>
                  <span class="status-divider" aria-hidden="true">|</span>
                  <span class="status-doing" id="previewDoing">Doing</span>
                </div>
                <div class="status-marquee">
                  <div class="marquee-track"><span class="marquee-text" id="previewMarquee">Marquee</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
    </AdminPostWorkspace>
  </div>

  <script>
    import { adminFetch, setAdminStatus } from '../../lib/admin/api';

    const feeling = document.querySelector<HTMLInputElement>('#feeling');
    const doing = document.querySelector<HTMLInputElement>('#doing');
    const marquee = document.querySelector<HTMLInputElement>('#marquee');
    const message = document.querySelector<HTMLElement>('#statusMessage');
    const previewFeeling = document.querySelector<HTMLElement>('#previewFeeling');
    const previewDoing = document.querySelector<HTMLElement>('#previewDoing');
    const previewMarquee = document.querySelector<HTMLElement>('#previewMarquee');

    if (feeling && doing && marquee && message && previewFeeling && previewDoing && previewMarquee) {
      const updatePreview = () => {
        previewFeeling.textContent = feeling.value || 'Feeling';
        previewDoing.textContent = doing.value || 'Doing';
        previewMarquee.textContent = marquee.value || 'Marquee';
      };

      [feeling, doing, marquee].forEach((input) => input.addEventListener('input', updatePreview));

      (async () => {
        setAdminStatus(message, 'Loading...', 'loading');
        try {
          const response = await adminFetch('/site/status', {}, { auth: false });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Failed to load status');
          feeling.value = data.feeling || '';
          doing.value = data.doing || '';
          marquee.value = data.currently_marquee || '';
          updatePreview();
          setAdminStatus(message);
        } catch (error) {
          setAdminStatus(message, error instanceof Error ? error.message : 'Failed to load status', 'error');
        }
      })();

      document.querySelector<HTMLFormElement>('#statusForm')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setAdminStatus(message, 'Saving...', 'loading');
        try {
          const response = await adminFetch('/admin/status', {
            method: 'PUT',
            body: JSON.stringify({ feeling: feeling.value, doing: doing.value, currently_marquee: marquee.value })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Failed to save');
          setAdminStatus(message, 'Saved.', 'success');
        } catch (error) {
          setAdminStatus(message, error instanceof Error ? error.message : 'Error saving status', 'error');
        }
      });
    }
  </script>
</AdminLayout>

<style is:global>
  .admin-status-page {
    min-width: 0;
  }

  .admin-status-page .admin-post-workspace-content {
    padding: 8px !important;
  }

  .status-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(240px, .85fr);
    gap: 10px;
    min-width: 0;
  }

  .status-form {
    display: grid;
    align-content: start;
    gap: 9px;
    max-width: none;
    margin: 0;
    padding: 3px 4px 4px;
  }

  .status-form-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .status-form .admin-field {
    gap: 3px;
  }

  .status-form .admin-field label,
  .status-preview-label {
    color: var(--primary-dark);
    font: 700 .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .status-form input {
    min-height: 32px;
    padding: 6px 8px;
    border: 1px solid var(--primary-dark);
    border-top-color: var(--primary-light);
    border-left-color: var(--primary-light);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev)));
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .72), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
    color: var(--text);
    font: .78rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .status-form input::placeholder {
    color: var(--text-muted);
    opacity: .78;
  }

  .status-form input:focus-visible {
    outline: 1px solid var(--primary);
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary-light) 30%, transparent), inset 1px 1px 0 rgba(255, 255, 255, .72);
  }

  .status-form-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding-top: 7px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 54%, transparent);
  }

  .status-form-footer .admin-status {
    flex: 1 1 auto;
    min-width: 0;
    padding: 5px 7px;
    border-radius: 4px;
    font: .72rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .status-form-footer .btn {
    min-height: 30px;
    padding: 6px 12px;
    border-radius: 4px;
    font: 700 .7rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .status-preview {
    display: grid;
    align-content: start;
    gap: 5px;
    min-width: 0;
    padding: 3px 4px 4px 10px;
    border-left: 1px dotted color-mix(in srgb, var(--primary-dark) 54%, transparent);
  }

  .status-preview-label {
    color: var(--text-muted);
  }

  .admin-status-preview {
    display: grid;
    min-height: 76px;
    align-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--primary-dark) 72%, var(--border));
    border-radius: 4px;
    background: #102020;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .12), 1px 1px 2px rgba(0, 0, 0, .18);
  }

  .admin-status-preview .status-strip-content {
    display: grid;
    gap: 7px;
    padding: 10px;
  }

  .admin-status-preview .status-info {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    color: #a8f5f2;
    font: .72rem/1.2 "Courier New", monospace;
    text-align: center;
  }

  .admin-status-preview .status-divider {
    color: var(--primary);
  }

  .admin-status-preview .status-marquee {
    min-width: 0;
    overflow: hidden;
    padding-top: 7px;
    border-top: 1px solid rgba(109, 230, 226, .24);
    color: #a8f5f2;
    font: .7rem/1.2 "Courier New", monospace;
    white-space: nowrap;
  }

  .admin-status-preview .marquee-track {
    overflow: hidden;
  }

  .admin-status-preview .marquee-text {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 720px) {
    .status-layout {
      grid-template-columns: 1fr;
    }

    .status-preview {
      padding: 9px 4px 4px;
      border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 54%, transparent);
      border-left: 0;
    }
  }

  @media (max-width: 520px) {
    .status-form-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
