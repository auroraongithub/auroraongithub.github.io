---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPanel from '../../components/admin/AdminPanel.astro';
---
<AdminLayout title="YouTube Research" active="youtube-research" wide={true} bodyClass="admin-tool">
  <AdminPanel title="YouTube Shorts Research" icon="bi-youtube" class="youtube-research-panel">
    <div class="youtube-tabs" role="tablist" aria-label="Research tools">
      {['search','trending','niche','outliers','channel','ideas','discover','saved'].map((tab, index) => <button class:list={['btn','btn-ghost','youtube-tab',{active:index===0}]} type="button" data-yt-tab={tab} role="tab" aria-selected={index===0?'true':'false'}>{tab[0].toUpperCase()+tab.slice(1)}</button>)}
    </div>

    <section class="youtube-pane active" data-yt-pane="search">
      <div class="youtube-presets"><button data-quick-search="viral trends 2025">Viral Trends</button><button data-quick-search="life hacks">Life Hacks</button><button data-quick-search="satisfying videos">Satisfying</button><button data-quick-search="funny moments">Funny</button><button data-quick-search="ASMR">ASMR</button></div>
      <div class="youtube-toolbar"><input id="ytSearchQuery" placeholder="Search Shorts topics…" /><select id="ytSearchOrder"><option value="date">Recent</option><option value="relevance">Relevance</option><option value="viewCount">Views</option><option value="rating">Rating</option></select><select id="ytSearchDuration"><option value="short">Shorts Only</option><option value="">Any Duration</option><option value="medium">Medium</option><option value="long">Long</option></select><select id="ytSearchTime"><option value="week">Past Week</option><option value="month">Past Month</option><option value="3months">Past 3 Months</option><option value="year">Past Year</option><option value="">All Time</option></select><button class="btn btn-primary" id="ytSearchButton" type="button">Search</button></div>
      <div id="ytSearchRelated" class="youtube-related" hidden></div><div id="ytSearchResults" class="youtube-grid"><div class="admin-empty-state">Search for Shorts topics.</div></div><div class="youtube-more" id="ytSearchMore" hidden><button class="btn btn-ghost" id="ytSearchMoreButton" type="button">Load More</button></div>
    </section>

    <section class="youtube-pane" data-yt-pane="trending">
      <div class="youtube-toolbar"><input id="ytTrendingFilter" placeholder="Filter trending…" /><select id="ytTrendingRegion"><option value="US">United States</option><option value="GB">United Kingdom</option><option value="PH">Philippines</option><option value="JP">Japan</option><option value="KR">South Korea</option><option value="IN">India</option><option value="BR">Brazil</option><option value="CA">Canada</option><option value="AU">Australia</option></select><select id="ytTrendingCategory"><option value="">All Categories</option></select><button class="btn btn-primary" id="ytTrendingButton" type="button">Load Trending</button></div>
      <div id="ytTrendingTags" class="youtube-tags" hidden></div><div id="ytTrendingResults" class="youtube-grid"><div class="admin-empty-state">Load trending videos.</div></div>
    </section>

    <section class="youtube-pane" data-yt-pane="niche">
      <div class="youtube-presets"><button data-niche-preset="AI automation">AI automation</button><button data-niche-preset="productivity tips">Productivity</button><button data-niche-preset="side hustle">Side Hustle</button><button data-niche-preset="tech reviews">Tech Reviews</button><button data-niche-preset="gaming tips">Gaming</button></div>
      <div class="youtube-toolbar"><input id="ytNicheQuery" placeholder="Enter a niche/keyword…" /><button class="btn btn-primary" id="ytNicheButton" type="button">Analyze Niche</button><button class="btn btn-ghost" id="ytSaveNiche" type="button">Track Niche</button></div>
      <div id="ytNicheRelated" class="youtube-related" hidden></div><div id="ytNicheResults"><div class="admin-empty-state">Enter a niche to analyze competition and potential.</div></div>
    </section>

    <section class="youtube-pane" data-yt-pane="outliers">
      <div class="youtube-presets"><button data-outlier-preset="minecraft">Minecraft</button><button data-outlier-preset="fortnite">Fortnite</button><button data-outlier-preset="makeup tutorial">Makeup</button><button data-outlier-preset="reaction videos">Reactions</button><button data-outlier-preset="meme compilation">Memes</button></div>
      <div class="youtube-toolbar"><input id="ytOutlierQuery" placeholder="Niche to find viral Shorts…" /><label class="youtube-threshold"><input type="number" id="ytOutlierThreshold" value="3" min="1.5" max="50" step="0.5" /> <span>x median</span></label><button class="btn btn-primary" id="ytOutlierButton" type="button">Find Outliers</button></div>
      <div id="ytOutlierResults" class="youtube-grid"><div class="admin-empty-state">Find viral Shorts in any niche.</div></div>
    </section>

    <section class="youtube-pane" data-yt-pane="channel">
      <div class="youtube-toolbar"><input id="ytChannelId" placeholder="Channel URL, @handle, or ID…" /><select id="ytChannelType"><option value="shorts">Shorts Only</option><option value="all">All Videos</option><option value="long">Long Only</option></select><button class="btn btn-primary" id="ytChannelButton" type="button">Analyze</button></div>
      <div id="ytChannelInfo"></div><div id="ytChannelRelated" class="youtube-related" hidden></div><div id="ytChannelResults" class="youtube-grid"><div class="admin-empty-state">Enter a channel URL, handle, or ID.</div></div><div class="youtube-more" id="ytChannelMore" hidden><button class="btn btn-ghost" id="ytChannelMoreButton" type="button">Load More</button></div>
    </section>

    <section class="youtube-pane" data-yt-pane="ideas">
      <div class="youtube-stack"><input id="ytSourceChannel" placeholder="Source channel (URL, @handle, or ID)" /><input id="ytMyChannel" placeholder="Your channel (URL, @handle, or ID)" /><button class="btn btn-primary" id="ytCompareButton" type="button">Compare & Find Ideas</button></div>
      <div id="ytIdeasResults"><div class="admin-empty-state">Enter both channels to compare.</div></div>
    </section>

    <section class="youtube-pane" data-yt-pane="discover">
      <div class="youtube-toolbar"><select id="ytDiscoverCategory"><option value="">All Categories</option><option value="trending">Trending Now</option><option value="comedy">Comedy</option><option value="gaming">Gaming</option><option value="music">Music</option><option value="sports">Sports</option><option value="education">Education</option><option value="tech">Technology</option><option value="food">Food & Cooking</option><option value="fitness">Fitness</option><option value="diy">DIY & Crafts</option></select><select id="ytDiscoverRegion"><option value="US">United States</option><option value="GB">United Kingdom</option><option value="PH">Philippines</option><option value="JP">Japan</option><option value="KR">South Korea</option><option value="IN">India</option><option value="BR">Brazil</option><option value="CA">Canada</option><option value="AU">Australia</option></select><button class="btn btn-primary" id="ytDiscoverButton" type="button">Discover New</button></div>
      <div id="ytDiscoverResults" class="youtube-grid"><div class="admin-empty-state">Discover random Shorts.</div></div>
    </section>

    <section class="youtube-pane" data-yt-pane="saved">
      <div class="youtube-tabs youtube-subtabs"><button class="btn btn-ghost youtube-subtab active" data-yt-subtab="ideas" type="button">Ideas</button><button class="btn btn-ghost youtube-subtab" data-yt-subtab="niches" type="button">Niches</button><button class="btn btn-ghost youtube-subtab" data-yt-subtab="research" type="button">Research</button></div>
      <div class="youtube-saved-pane" data-yt-saved="ideas" id="ytSavedIdeas"><p class="admin-status" data-state="loading">Loading…</p></div><div class="youtube-saved-pane" data-yt-saved="niches" id="ytSavedNiches" hidden><p class="admin-status" data-state="loading">Loading…</p></div><div class="youtube-saved-pane" data-yt-saved="research" id="ytSavedResearch" hidden><p class="admin-status" data-state="loading">Loading…</p></div>
    </section>
  </AdminPanel>

  <script>
    import { adminJson, escapeHtml } from '../../lib/admin/api';
    import { discoveryKeywords, formatNumber, similarSearchQuery, timeAgo } from '../../lib/admin/youtube';
    type Video=Record<string,any>;
    let searchState={query:'',pageToken:null as string|null,videos:[] as Video[]}; let trendingState={videos:[] as Video[],filtered:[] as Video[]}; let channelState={channelId:'',type:'',pageToken:null as string|null,videos:[] as Video[],channel:null as any}; let currentNiche:any=null; const autoLoaded=new Set<string>();
    const $=<T extends HTMLElement>(selector:string)=>document.querySelector<T>(selector)!;
    const empty=(message:string)=>`<div class="admin-empty-state">${escapeHtml(message)}</div>`; const loading=(message:string)=>`<p class="admin-status" data-state="loading">${escapeHtml(message)}</p>`;
    function videoCard(video:Video){const thumb=video.thumbnails?.medium?.url||video.thumbnails?.default?.url||'';const outlier=video.isOutlier||video.outlierScore>=2;const isShort=video.isShort;const url=`https://youtube.com/${isShort?'shorts/':'watch?v='}${encodeURIComponent(video.id||'')}`;return `<article class="youtube-card ${outlier?'outlier':''}" data-video-id="${escapeHtml(video.id||'')}"><a class="youtube-thumb" href="${url}" target="_blank" rel="noopener noreferrer">${thumb?`<img src="${escapeHtml(thumb)}" alt="" loading="lazy">`:''}</a><div class="youtube-card-body"><strong><a href="${url}" target="_blank" rel="noopener noreferrer">${escapeHtml(video.title||'Untitled')}</a></strong><button class="youtube-channel-link" type="button" data-channel="${escapeHtml(video.channelId||'')}">${escapeHtml(video.channelTitle||'')}</button><div class="admin-list-meta"><span>👁 ${formatNumber(video.stats?.views||0)}</span><span>👍 ${formatNumber(video.stats?.likes||0)}</span><span>${timeAgo(video.publishedAt)}</span>${outlier?`<span class="youtube-outlier">${escapeHtml(video.outlierScore)}x</span>`:''}</div></div><footer><button class="btn btn-ghost" type="button" data-similar="${escapeHtml(video.title||'')}">Similar</button><button class="btn btn-ghost" type="button" data-save-idea="${escapeHtml(video.id||'')}" data-title="${escapeHtml(video.title||'')}" data-source="${escapeHtml(video.channelTitle||'')}">Save</button></footer></article>`}
    const renderVideos=(container:HTMLElement,videos:Video[])=>{container.innerHTML=videos.length?videos.map(videoCard).join(''):empty('No videos found.')};
    function activateTab(name:string){document.querySelectorAll<HTMLButtonElement>('[data-yt-tab]').forEach((button)=>{const active=button.dataset.ytTab===name;button.classList.toggle('active',active);button.setAttribute('aria-selected',String(active))});document.querySelectorAll<HTMLElement>('[data-yt-pane]').forEach((pane)=>pane.classList.toggle('active',pane.dataset.ytPane===name));if(!autoLoaded.has(name)){autoLoaded.add(name);if(name==='trending')$('#ytTrendingButton').click();if(name==='discover')$('#ytDiscoverButton').click();}}
    document.querySelectorAll<HTMLButtonElement>('[data-yt-tab]').forEach((button)=>button.addEventListener('click',()=>activateTab(button.dataset.ytTab||'search')));
    document.querySelectorAll<HTMLButtonElement>('[data-yt-subtab]').forEach((button)=>button.addEventListener('click',()=>{const name=button.dataset.ytSubtab;document.querySelectorAll('[data-yt-subtab]').forEach((item)=>item.classList.toggle('active',item===button));document.querySelectorAll<HTMLElement>('[data-yt-saved]').forEach((pane)=>pane.hidden=pane.dataset.ytSaved!==name)}));
    document.querySelector('.admin-panel-content')?.addEventListener('click',async(event)=>{const target=event.target as HTMLElement;const similar=target.closest<HTMLButtonElement>('[data-similar]');const channel=target.closest<HTMLButtonElement>('[data-channel]');const save=target.closest<HTMLButtonElement>('[data-save-idea]');const tag=target.closest<HTMLButtonElement>('[data-search-tag]');if(similar){activateTab('search');$('#ytSearchQuery').setAttribute('value',similarSearchQuery(similar.dataset.similar||''));($('#ytSearchQuery') as HTMLInputElement).value=similarSearchQuery(similar.dataset.similar||'');$('#ytSearchButton').click()}if(channel?.dataset.channel){activateTab('channel');($('#ytChannelId') as HTMLInputElement).value=channel.dataset.channel;$('#ytChannelButton').click()}if(tag?.dataset.searchTag){activateTab('search');($('#ytSearchQuery') as HTMLInputElement).value=tag.dataset.searchTag;$('#ytSearchButton').click()}if(save?.dataset.saveIdea){try{await adminJson('/youtube/ideas',{method:'POST',body:JSON.stringify({videoId:save.dataset.saveIdea,title:save.dataset.title,sourceChannel:save.dataset.source,status:'pending'})});window.alert('Idea saved!');await loadSavedIdeas()}catch(error){window.alert(error instanceof Error?error.message:'Error saving idea')}}});
    document.querySelectorAll<HTMLButtonElement>('[data-quick-search]').forEach((button)=>button.addEventListener('click',()=>{($('#ytSearchQuery') as HTMLInputElement).value=button.dataset.quickSearch||'';$('#ytSearchButton').click()}));document.querySelectorAll<HTMLButtonElement>('[data-niche-preset]').forEach((button)=>button.addEventListener('click',()=>{($('#ytNicheQuery') as HTMLInputElement).value=button.dataset.nichePreset||'';$('#ytNicheButton').click()}));document.querySelectorAll<HTMLButtonElement>('[data-outlier-preset]').forEach((button)=>button.addEventListener('click',()=>{($('#ytOutlierQuery') as HTMLInputElement).value=button.dataset.outlierPreset||'';$('#ytOutlierButton').click()}));
    async function related(query:string,container:HTMLElement){try{const data:any=await adminJson(`/youtube/related-channels?q=${encodeURIComponent(query)}&maxResults=8`);if(data.channels?.length){container.hidden=false;container.innerHTML=`<strong>Related Channels</strong><div>${data.channels.map((item:any)=>`<button type="button" class="youtube-chip" data-channel="${escapeHtml(item.id)}">${item.thumbnails?.default?.url?`<img src="${escapeHtml(item.thumbnails.default.url)}" alt="">`:''}<span>${escapeHtml(item.title)}</span><small>${formatNumber(item.stats?.subscribers||0)}</small></button>`).join('')}</div>`}}catch(_){}}
    async function search(append=false){const query=($('#ytSearchQuery') as HTMLInputElement).value.trim();if(!query)return;const results=$<HTMLElement>('#ytSearchResults');const more=$<HTMLElement>('#ytSearchMore');if(!append){results.innerHTML=loading('Searching…');searchState={query,pageToken:null,videos:[]};more.hidden=true;$<HTMLElement>('#ytSearchRelated').hidden=true}try{const params=new URLSearchParams({q:query,order:($('#ytSearchOrder') as HTMLSelectElement).value,maxResults:'25'});const duration=($('#ytSearchDuration') as HTMLSelectElement).value;if(duration)params.set('videoDuration',duration);if(searchState.pageToken&&append)params.set('pageToken',searchState.pageToken);const filter=($('#ytSearchTime') as HTMLSelectElement).value;if(filter){const days=filter==='week'?7:filter==='month'?30:filter==='3months'?90:filter==='year'?365:0;if(days)params.set('publishedAfter',new Date(Date.now()-days*86400000).toISOString())}const data:any=await adminJson(`/youtube/search?${params}`);searchState.pageToken=data.nextPageToken||null;searchState.videos=append?[...searchState.videos,...(data.videos||[])]:data.videos||[];renderVideos(results,searchState.videos);more.hidden=!searchState.pageToken;if(!append)related(query,$<HTMLElement>('#ytSearchRelated'))}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Search failed')}}
    $('#ytSearchButton').addEventListener('click',()=>search(false));$('#ytSearchMoreButton').addEventListener('click',()=>search(true));$('#ytSearchQuery').addEventListener('keydown',(event)=>{if((event as KeyboardEvent).key==='Enter')search(false)});
    async function loadCategories(){try{const data:any=await adminJson('/youtube/categories?regionCode=US');const select=$<HTMLSelectElement>('#ytTrendingCategory');(data.categories||[]).filter((item:any)=>item.assignable).forEach((item:any)=>{const option=document.createElement('option');option.value=item.id;option.textContent=item.title;select.append(option)})}catch(_){}}
    async function trending(){const results=$<HTMLElement>('#ytTrendingResults');results.innerHTML=loading('Loading trending…');try{const params=new URLSearchParams({regionCode:($('#ytTrendingRegion') as HTMLSelectElement).value,maxResults:'50'});const category=($('#ytTrendingCategory') as HTMLSelectElement).value;if(category)params.set('categoryId',category);const data:any=await adminJson(`/youtube/trending?${params}`);trendingState={videos:data.videos||[],filtered:data.videos||[]};renderVideos(results,trendingState.filtered);const counts=new Map<string,number>();trendingState.videos.flatMap((video:any)=>video.tags||[]).forEach((tag:string)=>counts.set(tag.toLowerCase(),(counts.get(tag.toLowerCase())||0)+1));const tags=[...counts.entries()].sort((a,b)=>b[1]-a[1]).slice(0,15);const el=$<HTMLElement>('#ytTrendingTags');el.hidden=!tags.length;el.innerHTML=tags.map(([tag,count])=>`<button type="button" class="youtube-chip" data-search-tag="${escapeHtml(tag)}">${escapeHtml(tag)} <small>${count}</small></button>`).join('')}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Failed to load trending')}}
    $('#ytTrendingButton').addEventListener('click',trending);$('#ytTrendingFilter').addEventListener('input',()=>{const filter=($('#ytTrendingFilter') as HTMLInputElement).value.toLowerCase().trim();trendingState.filtered=filter?trendingState.videos.filter((video:any)=>(video.title||'').toLowerCase().includes(filter)||(video.channelTitle||'').toLowerCase().includes(filter)||(video.tags||[]).some((tag:string)=>tag.toLowerCase().includes(filter))):trendingState.videos;renderVideos($<HTMLElement>('#ytTrendingResults'),trendingState.filtered)});
    $('#ytNicheButton').addEventListener('click',async()=>{const query=($('#ytNicheQuery') as HTMLInputElement).value.trim();if(!query)return;const results=$<HTMLElement>('#ytNicheResults');results.innerHTML=loading('Analyzing niche…');$<HTMLElement>('#ytNicheRelated').hidden=true;try{const data:any=await adminJson(`/youtube/niche-analysis?q=${encodeURIComponent(query)}`);currentNiche=data;results.innerHTML=`<div class="youtube-metrics"><div><small>Opportunity</small><strong>${escapeHtml(data.metrics?.opportunityScore??0)}</strong></div><div><small>Competition</small><strong>${escapeHtml(data.metrics?.competitionScore??0)}</strong></div><div><small>Potential</small><strong>${escapeHtml(data.metrics?.potentialScore??0)}</strong></div><div><small>Recent Videos</small><strong>${formatNumber(data.metrics?.totalRecentVideos||0)}</strong></div><div><small>Avg Recent Views</small><strong>${formatNumber(data.metrics?.avgRecentViews||0)}</strong></div><div><small>Avg Top Views</small><strong>${formatNumber(data.metrics?.avgTopViews||0)}</strong></div></div><div class="youtube-tags">${(data.topTags||[]).map((item:any)=>`<button type="button" class="youtube-chip" data-search-tag="${escapeHtml(item.tag)}">${escapeHtml(item.tag)} <small>${escapeHtml(item.count)}</small></button>`).join('')}</div><h3 class="youtube-section-title">Top Videos</h3><div class="youtube-grid">${(data.topVideos||[]).map(videoCard).join('')}</div>`;related(query,$<HTMLElement>('#ytNicheRelated'))}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Niche analysis failed')}});
    $('#ytSaveNiche').addEventListener('click',async()=>{const query=($('#ytNicheQuery') as HTMLInputElement).value.trim();if(!query||!currentNiche)return window.alert('Analyze a niche first.');try{await adminJson('/youtube/niches',{method:'POST',body:JSON.stringify({name:query,keywords:(currentNiche.topTags||[]).map((item:any)=>item.tag),metrics:currentNiche.metrics})});window.alert('Niche saved for tracking.');await loadSavedNiches()}catch(error){window.alert(error instanceof Error?error.message:'Failed to save niche')}});
    $('#ytOutlierButton').addEventListener('click',async()=>{const query=($('#ytOutlierQuery') as HTMLInputElement).value.trim();if(!query)return;const results=$<HTMLElement>('#ytOutlierResults');results.innerHTML=loading('Finding outliers…');try{const threshold=($('#ytOutlierThreshold') as HTMLInputElement).value;const data:any=await adminJson(`/youtube/outliers?q=${encodeURIComponent(query)}&threshold=${encodeURIComponent(threshold)}`);if(!data.outliers?.length){results.innerHTML=empty(`No outliers found at ${threshold}x threshold.`);return}results.innerHTML=`<div class="youtube-summary"><span>Median ${formatNumber(data.medianViews)}</span><span>Threshold ${escapeHtml(data.threshold)}x</span><span>${escapeHtml(data.outlierCount)} outliers</span></div>${data.outliers.map(videoCard).join('')}`}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Outlier search failed')}});
    async function channelVideos(append=false){const channelId=($('#ytChannelId') as HTMLInputElement).value.trim();if(!channelId)return;const results=$<HTMLElement>('#ytChannelResults');const info=$<HTMLElement>('#ytChannelInfo');const relatedEl=$<HTMLElement>('#ytChannelRelated');const more=$<HTMLElement>('#ytChannelMore');const type=($('#ytChannelType') as HTMLSelectElement).value;if(!append){results.innerHTML=loading('Analyzing channel…');info.innerHTML='';relatedEl.hidden=true;more.hidden=true;channelState={channelId,type,pageToken:null,videos:[],channel:null}}try{if(!append){const data:any=await adminJson(`/youtube/channel?id=${encodeURIComponent(channelId)}`);channelState.channel=data.channel;const channel=data.channel;info.innerHTML=`<div class="youtube-summary youtube-channel-summary">${channel.thumbnails?.default?.url?`<img src="${escapeHtml(channel.thumbnails.default.url)}" alt="">`:''}<strong>${escapeHtml(channel.title||'')}</strong><span>${formatNumber(channel.stats?.subscribers||0)} subscribers</span><span>${formatNumber(channel.stats?.videoCount||0)} videos</span><span>${formatNumber(channel.stats?.viewCount||0)} views</span></div>`;related(channel.title||channelId,relatedEl)}const params=new URLSearchParams({channelId,type,maxResults:'25'});if(channelState.pageToken&&append)params.set('pageToken',channelState.pageToken);const data:any=await adminJson(`/youtube/channel-videos?${params}`);channelState.pageToken=data.nextPageToken||null;channelState.videos=append?[...channelState.videos,...(data.videos||[])]:data.videos||[];results.innerHTML=`${data.averages?`<div class="youtube-summary"><span>${channelState.videos.length} videos</span><span>Avg views ${formatNumber(data.averages.views||0)}</span><span>Avg engagement ${escapeHtml(data.averages.engagement||0)}%</span></div>`:''}${channelState.videos.map(videoCard).join('')}`;more.hidden=!channelState.pageToken}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Channel analysis failed')}}
    $('#ytChannelButton').addEventListener('click',()=>channelVideos(false));$('#ytChannelMoreButton').addEventListener('click',()=>channelVideos(true));
    $('#ytCompareButton').addEventListener('click',async()=>{const sourceChannelId=($('#ytSourceChannel') as HTMLInputElement).value.trim();const myChannelId=($('#ytMyChannel') as HTMLInputElement).value.trim();if(!sourceChannelId||!myChannelId)return;const results=$<HTMLElement>('#ytIdeasResults');results.innerHTML=loading('Comparing channels…');try{const data:any=await adminJson('/youtube/idea-compare',{method:'POST',body:JSON.stringify({sourceChannelId,myChannelId})});results.innerHTML=`<div class="youtube-summary"><span>${escapeHtml(data.summary?.total||0)} total</span><span>${escapeHtml(data.summary?.new||0)} new</span><span>${escapeHtml(data.summary?.skipped||0)} done</span></div><div class="youtube-idea-list">${(data.newIdeas||[]).map((idea:any)=>`<article class="youtube-idea new">${idea.thumbnail?`<img src="${escapeHtml(idea.thumbnail)}" alt="">`:''}<div><strong><a href="https://youtube.com/watch?v=${encodeURIComponent(idea.id)}" target="_blank">${escapeHtml(idea.title)}</a></strong><small>${timeAgo(idea.publishedAt)}</small></div><button class="btn btn-ghost" type="button" data-save-idea="${escapeHtml(idea.id)}" data-title="${escapeHtml(idea.title)}" data-source="${escapeHtml(sourceChannelId)}">Save</button></article>`).join('')}</div>${data.skippedIdeas?.length?`<h3 class="youtube-section-title">Already Done</h3><div class="youtube-idea-list">${data.skippedIdeas.map((idea:any)=>`<article class="youtube-idea skipped"><div><strong>${escapeHtml(idea.title)}</strong><small>Similar to: ${escapeHtml(idea.similarTo||'N/A')}</small></div></article>`).join('')}</div>`:''}${data.aiMessage?`<p class="admin-status">${escapeHtml(data.aiMessage)}</p>`:''}`}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Channel comparison failed')}});
    $('#ytDiscoverButton').addEventListener('click',async()=>{const results=$<HTMLElement>('#ytDiscoverResults');results.innerHTML=loading('Discovering Shorts…');try{const category=($('#ytDiscoverCategory') as HTMLSelectElement).value;const region=($('#ytDiscoverRegion') as HTMLSelectElement).value;let videos:Video[]=[];if(category===''||category==='trending'){const data:any=await adminJson(`/youtube/trending?regionCode=${encodeURIComponent(region)}&maxResults=50`);videos=(data.videos||[]).filter((video:any)=>video.isShort===true)}else{const query=`${discoveryKeywords[category]||category} shorts`;const data:any=await adminJson(`/youtube/search?q=${encodeURIComponent(query)}&order=viewCount&videoDuration=short&maxResults=50&regionCode=${encodeURIComponent(region)}`);videos=data.videos||[]}videos=[...videos].sort(()=>Math.random()-.5).slice(0,12);renderVideos(results,videos)}catch(error){results.innerHTML=empty(error instanceof Error?error.message:'Discovery failed')}});
    async function loadSavedIdeas(){const container=$<HTMLElement>('#ytSavedIdeas');try{const data:any=await adminJson('/youtube/ideas');container.innerHTML=data.ideas?.length?data.ideas.map((item:any)=>`<article class="youtube-saved-item"><div><strong>${escapeHtml(item.title)}</strong><small>${item.sourceChannel?`Source: ${escapeHtml(item.sourceChannel)} · `:''}Status: ${escapeHtml(item.status||'')} · ${timeAgo(item.createdAt)}</small></div><button class="btn btn-ghost admin-danger" type="button" data-delete-idea="${escapeHtml(item.id)}">Delete</button></article>`).join(''):empty('No saved ideas yet.')}catch(error){container.innerHTML=empty(error instanceof Error?error.message:'Failed to load ideas')}}
    async function loadSavedNiches(){const container=$<HTMLElement>('#ytSavedNiches');try{const data:any=await adminJson('/youtube/niches');container.innerHTML=data.niches?.length?data.niches.map((item:any)=>`<article class="youtube-saved-item"><div><strong>${escapeHtml(item.name)}</strong><small>Opportunity: ${escapeHtml(item.metrics?.opportunityScore||'N/A')} · ${timeAgo(item.createdAt)}</small></div><div><button class="btn btn-ghost" type="button" data-open-niche="${escapeHtml(item.name)}">Open</button><button class="btn btn-ghost admin-danger" type="button" data-delete-niche="${escapeHtml(item.id)}">Delete</button></div></article>`).join(''):empty('No tracked niches yet.')}catch(error){container.innerHTML=empty(error instanceof Error?error.message:'Failed to load niches')}}
    async function loadSavedResearch(){const container=$<HTMLElement>('#ytSavedResearch');try{const data:any=await adminJson('/youtube/research');container.innerHTML=data.research?.length?data.research.map((item:any)=>`<article class="youtube-saved-item"><div><strong>${escapeHtml(item.title)}</strong><small>Query: ${escapeHtml(item.query||'')} · Type: ${escapeHtml(item.type||'')} · ${timeAgo(item.createdAt)}</small></div><button class="btn btn-ghost admin-danger" type="button" data-delete-research="${escapeHtml(item.id)}">Delete</button></article>`).join(''):empty('No saved research yet.')}catch(error){container.innerHTML=empty(error instanceof Error?error.message:'Failed to load research')}}
    document.querySelector('[data-yt-pane="saved"]')?.addEventListener('click',async(event)=>{const target=event.target as HTMLElement;const idea=target.closest<HTMLButtonElement>('[data-delete-idea]');const niche=target.closest<HTMLButtonElement>('[data-delete-niche]');const research=target.closest<HTMLButtonElement>('[data-delete-research]');const open=target.closest<HTMLButtonElement>('[data-open-niche]');if(open?.dataset.openNiche){activateTab('niche');($('#ytNicheQuery') as HTMLInputElement).value=open.dataset.openNiche;return}try{if(idea?.dataset.deleteIdea&&window.confirm('Delete this idea?')){await adminJson(`/youtube/ideas/${encodeURIComponent(idea.dataset.deleteIdea)}`,{method:'DELETE'});await loadSavedIdeas()}if(niche?.dataset.deleteNiche&&window.confirm('Delete this niche?')){await adminJson(`/youtube/niches/${encodeURIComponent(niche.dataset.deleteNiche)}`,{method:'DELETE'});await loadSavedNiches()}if(research?.dataset.deleteResearch&&window.confirm('Delete this research?')){await adminJson(`/youtube/research/${encodeURIComponent(research.dataset.deleteResearch)}`,{method:'DELETE'});await loadSavedResearch()}}catch(error){window.alert(error instanceof Error?error.message:'Delete failed')}});
    loadCategories();loadSavedIdeas();loadSavedNiches();loadSavedResearch();
  </script>
  <style>
    .youtube-research-panel {
      overflow: hidden;
      border-color: var(--primary-dark);
      background: var(--bg-elev);
      box-shadow: 0 4px 12px color-mix(in srgb, var(--primary) 15%, transparent);
    }

    .youtube-research-panel:hover { transform: none; }

    .youtube-research-panel .admin-panel-header {
      padding: 10px 14px;
      border-bottom-color: var(--primary-dark);
      background-image: repeating-linear-gradient(45deg, var(--primary-light), var(--primary-light) 6px, var(--primary) 6px, var(--primary) 12px);
      background-size: 17px 17px;
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.58), inset 0 -1px 0 color-mix(in srgb, var(--primary-dark) 55%, transparent);
      text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 82%, #000);
    }

    .youtube-research-panel .admin-panel-header h2 {
      display: flex;
      align-items: center;
      gap: 7px;
      font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
      font-size: .94rem;
      letter-spacing: .08em;
    }

    .youtube-research-panel .admin-panel-header h2 i { font-size: 1.08rem; }

    .youtube-research-panel .admin-panel-content {
      padding: 0 14px 16px;
      background: color-mix(in srgb, var(--bg-elev) 96%, var(--primary-light));
    }

    .youtube-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin: 0 -14px 14px;
      padding: 8px 10px;
      border-bottom: 1px solid var(--primary-dark);
      background: linear-gradient(to bottom, color-mix(in srgb, var(--primary-light) 24%, var(--bg-elev)), var(--bg-elev));
    }

    .youtube-tab,
    .youtube-subtab {
      position: relative;
      min-height: 32px!important;
      padding: 6px 11px!important;
      border: 1px solid transparent!important;
      border-radius: 5px!important;
      background: transparent!important;
      color: var(--text-muted)!important;
      font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif!important;
      font-size: .76rem!important;
      font-weight: 700;
      letter-spacing: .02em;
      transition: background .15s ease, border-color .15s ease, color .15s ease, transform .15s ease;
    }

    .youtube-tab:hover,
    .youtube-subtab:hover {
      border-color: var(--primary-dark)!important;
      background: color-mix(in srgb, var(--primary-light) 22%, var(--bg-elev))!important;
      color: var(--text)!important;
      transform: translateY(-1px);
    }

    .youtube-tab.active,
    .youtube-subtab.active {
      border-color: var(--primary-dark)!important;
      background: linear-gradient(to bottom, var(--primary-light), var(--primary) 48%, var(--primary-dark) 52%, var(--primary))!important;
      color: #fff!important;
      text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 80%, #000);
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.62), 0 1px 2px rgba(0,0,0,.12);
    }

    .youtube-pane { display: none; min-height: 260px; }
    .youtube-pane.active { display: block; }

    .youtube-toolbar,
    .youtube-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      align-items: center;
      margin: 0 0 13px;
      padding: 9px;
      border: 1px solid var(--primary-dark);
      border-radius: 6px;
      background: linear-gradient(to bottom, color-mix(in srgb, var(--primary-light) 12%, var(--bg-elev)), var(--bg-elev));
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.5), 0 2px 4px rgba(0,0,0,.08);
    }

    .youtube-toolbar > input,
    .youtube-toolbar > select,
    .youtube-stack > input {
      flex: 1 1 150px;
      min-width: 0;
    }

    .youtube-stack { max-width: 760px; align-items: stretch; flex-direction: column; }

    .youtube-research-panel input:not([type='checkbox']):not([type='radio']),
    .youtube-research-panel select {
      min-height: 34px;
      padding: 6px 9px;
      border: 1px solid var(--primary-dark);
      border-top-color: var(--primary-light);
      border-left-color: var(--primary-light);
      border-radius: 5px;
      background: linear-gradient(to bottom, color-mix(in srgb, var(--bg-elev) 93%, var(--primary-light)), var(--bg-elev));
      color: var(--text);
      font-family: Verdana, Geneva, sans-serif;
      font-size: .78rem;
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.68), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 28%, transparent), 1px 1px 2px rgba(0,0,0,.1);
    }

    [data-theme='dark'] .youtube-research-panel input:not([type='checkbox']):not([type='radio']),
    [data-theme='dark'] .youtube-research-panel select {
      background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 9%, var(--bg-elev)));
    }

    .youtube-research-panel input:not([type='checkbox']):not([type='radio']):focus-visible,
    .youtube-research-panel select:focus-visible {
      border-color: var(--primary);
      outline: none;
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.7), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 24%, transparent), 0 0 0 2px color-mix(in srgb, var(--primary) 24%, transparent);
    }

    .youtube-research-panel input::placeholder { color: var(--text-muted); opacity: .92; }

    .youtube-research-panel .btn {
      min-height: 34px;
      padding: 6px 12px;
      border: 1px solid var(--primary-dark);
      border-radius: 5px;
      font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
      font-size: .76rem;
      font-weight: 700;
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.62), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 22%, transparent), 1px 1px 2px rgba(0,0,0,.12);
    }

    .youtube-research-panel .btn-primary {
      background: linear-gradient(to bottom, var(--primary-light), var(--primary) 46%, var(--primary-dark) 52%, var(--primary-light));
      color: #fff;
      text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 80%, #000);
    }

    .youtube-research-panel .btn-primary:hover { background: linear-gradient(to bottom, var(--primary), var(--primary-dark)); }

    .youtube-research-panel .btn-ghost {
      background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev)));
      color: var(--text);
    }

    .youtube-research-panel .btn-ghost:hover { background: color-mix(in srgb, var(--primary-light) 24%, var(--bg-elev)); color: var(--text); }

    .youtube-presets,
    .youtube-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin: 0 0 10px;
      padding: 0 0 8px;
      border-bottom: 1px dotted var(--primary-dark);
    }

    .youtube-presets button,
    .youtube-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 8px;
      border: 1px solid var(--border-light);
      border-radius: 4px;
      background: var(--bg-elev);
      color: var(--text-muted);
      font: inherit;
      font-size: .7rem;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease, color .15s ease, transform .15s ease;
    }

    .youtube-presets button:hover,
    .youtube-chip:hover {
      border-color: var(--primary-dark);
      background: color-mix(in srgb, var(--primary-light) 20%, var(--bg-elev));
      color: var(--text);
      transform: translateY(-1px);
    }

    .youtube-chip img { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; }

    .youtube-related,
    .youtube-summary,
    .youtube-metrics > div {
      border: 1px solid var(--border-light);
      background: var(--bg-elev);
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.34);
    }

    .youtube-related {
      margin: 0 0 13px;
      padding: 9px;
      border-top: 2px solid var(--primary);
      border-radius: 5px;
      color: var(--text);
      font-size: .75rem;
    }

    .youtube-related > div { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; }

    .youtube-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(205px, 1fr));
      gap: 10px;
    }

    .youtube-grid > .youtube-summary { grid-column: 1 / -1; }

    .youtube-card {
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--border-light);
      border-radius: 7px;
      background: var(--card);
      box-shadow: 0 2px 5px rgba(0,0,0,.07);
      transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

    .youtube-card:hover {
      border-color: var(--primary);
      box-shadow: 0 7px 15px color-mix(in srgb, var(--primary) 20%, transparent);
      transform: translateY(-2px);
    }

    .youtube-card.outlier { border-color: var(--primary); box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 35%, transparent); }

    .youtube-thumb { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-secondary); }
    .youtube-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
    .youtube-card:hover .youtube-thumb img { transform: scale(1.03); }

    .youtube-card-body { display: grid; align-content: start; gap: 5px; padding: 9px; }
    .youtube-card-body strong { font-size: .77rem; line-height: 1.35; }
    .youtube-card-body strong a { color: var(--text); text-decoration: none; }
    .youtube-card-body strong a:hover { color: var(--primary-dark); text-decoration: underline; text-underline-offset: 2px; }
    .youtube-channel-link { appearance: none; padding: 0; border: 0; background: none; color: var(--text-muted); text-align: left; font: inherit; font-size: .68rem; cursor: pointer; }
    .youtube-channel-link:hover { color: var(--primary-dark); text-decoration: underline; text-underline-offset: 2px; }
    .youtube-card footer { display: flex; gap: 5px; padding: 7px; border-top: 1px dotted var(--border-light); background: color-mix(in srgb, var(--bg-elev) 55%, var(--card)); }
    .youtube-card footer .btn { flex: 1; min-height: 29px; padding: 4px 7px; font-size: .7rem; }
    .youtube-outlier { color: var(--primary-dark); font-weight: 700; }

    .youtube-more { padding: 12px 0 2px; text-align: center; }

    .youtube-summary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin: 0 0 11px;
      padding: 8px 10px;
      border-radius: 5px;
      color: var(--text-muted);
      font-size: .72rem;
    }

    .youtube-channel-summary { justify-content: flex-start; border-top: 2px solid var(--primary); color: var(--text); }
    .youtube-channel-summary img { width: 40px; height: 40px; border-radius: 50%; }

    .youtube-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 7px; margin: 0 0 11px; }
    .youtube-metrics > div { display: grid; gap: 2px; padding: 9px 8px; border-radius: 5px; text-align: center; }
    .youtube-metrics small { color: var(--text-muted); font-size: .68rem; }
    .youtube-metrics strong { color: var(--primary-dark); font-size: 1.02rem; }
    .youtube-section-title { margin: 15px 0 8px; padding-bottom: 5px; border-bottom: 1px dotted var(--primary-dark); font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; }
    .youtube-threshold { display: flex; align-items: center; gap: 5px; color: var(--text-muted); font-size: .72rem; }
    .youtube-threshold input { width: 70px!important; }

    .youtube-idea-list,
    .youtube-saved-pane { display: grid; gap: 0; border: 1px solid var(--border-light); background: var(--bg-elev); }
    .youtube-idea,
    .youtube-saved-item { display: flex; align-items: center; gap: 9px; min-width: 0; padding: 8px 9px; border: 0; border-bottom: 1px dotted var(--border-light); border-radius: 0; background: transparent; }
    .youtube-idea:last-child,
    .youtube-saved-item:last-child { border-bottom: 0; }
    .youtube-idea:hover,
    .youtube-saved-item:hover { background: color-mix(in srgb, var(--primary-light) 13%, var(--bg-elev)); }
    .youtube-idea img { width: 76px; height: 44px; object-fit: cover; border-radius: 4px; }
    .youtube-idea > div,
    .youtube-saved-item > div:first-child { display: grid; gap: 2px; min-width: 0; flex: 1; }
    .youtube-idea small,
    .youtube-saved-item small { overflow: hidden; color: var(--text-muted); font-size: .68rem; text-overflow: ellipsis; white-space: nowrap; }
    .youtube-saved-item { justify-content: space-between; }
    .youtube-saved-item > div:last-child { display: flex; gap: 5px; flex: 0 0 auto; }

    .youtube-research-panel ::selection { background: var(--primary); color: #fff; }
    .youtube-research-panel :focus-visible { outline-color: var(--primary-dark); }

    @media (max-width: 900px) {
      .youtube-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
    }

    @media (max-width: 600px) {
      .youtube-research-panel .admin-panel-content { padding: 0 10px 12px; }
      .youtube-tabs { margin-right: -10px; margin-left: -10px; padding: 7px 6px; }
      .youtube-tab, .youtube-subtab { flex: 1 1 auto; padding-right: 8px!important; padding-left: 8px!important; }
      .youtube-toolbar { align-items: stretch; flex-direction: column; }
      .youtube-toolbar > input, .youtube-toolbar > select, .youtube-toolbar > .btn { width: 100%; }
      .youtube-threshold { justify-content: space-between; }
      .youtube-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
      .youtube-card-body { padding: 8px; }
      .youtube-card footer { padding: 6px; }
      .youtube-saved-item > div:last-child { flex-direction: column; }
    }

    @media (max-width: 390px) {
      .youtube-grid { grid-template-columns: 1fr; }
      .youtube-tab, .youtube-subtab { flex-basis: 25%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .youtube-tab, .youtube-subtab, .youtube-presets button, .youtube-chip, .youtube-card, .youtube-thumb img { transition: none; }
    }
  </style>
</AdminLayout>
