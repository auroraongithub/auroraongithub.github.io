---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Now Editor" active="now">
  <AdminPostWorkspace active="now" tabs={[{ id: 'now', label: 'Now' }]}>
    <form id="nowForm" class="admin-form now-editor-form">
      <div class="now-editor-fields">
        <AdminField label="Working on" forId="workingOn">
          <input id="workingOn" type="text" placeholder="Current work…" />
        </AdminField>
        <AdminField label="Learning" forId="learning">
          <input id="learning" type="text" placeholder="Current learning…" />
        </AdminField>
      </div>

      <AdminField label="Open to collabs?" class="now-collab-field">
        <div class="now-choice-row">
          <label class="now-choice">
            <input type="radio" name="collabs" value="true" id="collabsYes" />
            <span>Yes</span>
          </label>
          <label class="now-choice">
            <input type="radio" name="collabs" value="false" id="collabsNo" />
            <span>No</span>
          </label>
        </div>
      </AdminField>

      <div class="now-editor-actions">
        <button class="btn btn-primary" id="nowSaveButton" type="submit">Save</button>
      </div>
    </form>
  </AdminPostWorkspace>
</AdminLayout>

<script>
  import { adminFetch } from '../../lib/admin/api';
  const workingOn = document.querySelector<HTMLInputElement>('#workingOn')!;
  const learning = document.querySelector<HTMLInputElement>('#learning')!;
  const yes = document.querySelector<HTMLInputElement>('#collabsYes')!;
  const no = document.querySelector<HTMLInputElement>('#collabsNo')!;
  const saveButton = document.querySelector<HTMLButtonElement>('#nowSaveButton')!;
  const defaultSaveLabel = saveButton.textContent || 'Save';

  function setSaveState(label: string, disabled: boolean): void {
    saveButton.textContent = label;
    saveButton.disabled = disabled;
  }

  (async () => {
    try {
      const response = await adminFetch('/site/now', {}, { auth: false });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Failed to load');
      workingOn.value = data.working_on || '';
      learning.value = data.learning || '';
      yes.checked = Boolean(data.open_to_collabs);
      no.checked = !yes.checked;
    } catch (_) {}
  })();

  document.querySelector<HTMLFormElement>('#nowForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setSaveState('Saving…', true);
    try {
      const response = await adminFetch('/admin/now', {
        method: 'PUT',
        body: JSON.stringify({
          working_on: workingOn.value,
          learning: learning.value,
          open_to_collabs: yes.checked
        })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to save');
      setSaveState('Saved.', true);
      window.setTimeout(() => setSaveState(defaultSaveLabel, false), 1100);
    } catch {
      setSaveState('Retry', false);
    }
  });
</script>

<style is:global>
  .admin-page .now-editor-form {
    max-width: none;
    margin: 0;
    gap: 9px;
  }

  .now-editor-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .admin-page .now-editor-form .admin-field {
    min-width: 0;
    gap: 3px;
  }

  .admin-page .now-editor-form .admin-field > label {
    color: var(--primary-dark);
    font: 700 .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .admin-page .now-editor-form input:not([type='checkbox']):not([type='radio']) {
    min-height: 32px;
    padding: 6px 8px;
    border: 1px solid var(--primary-dark);
    border-top-color: var(--primary-light);
    border-left-color: var(--primary-light);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev)));
    color: var(--text);
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-size: .78rem;
  }

  .admin-page .now-editor-form input:not([type='checkbox']):not([type='radio'])::placeholder {
    color: var(--text-muted);
    opacity: .78;
  }

  .now-collab-field {
    grid-column: 1 / -1;
  }

  .now-choice-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .now-choice {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 12%, var(--bg-elev)));
    color: var(--text);
    cursor: pointer;
    font: 700 .7rem/1.1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .now-choice:hover {
    border-color: var(--primary);
  }

  .now-choice:has(input:checked) {
    border-color: var(--primary-dark);
    background: linear-gradient(to bottom, var(--primary-light), var(--primary));
    color: var(--bg);
  }

  .now-choice input[type='radio'] {
    flex: 0 0 auto;
    width: 13px;
    height: 13px;
    margin: 0;
    accent-color: var(--primary-dark);
  }

  .now-editor-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    padding-top: 8px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 52%, transparent);
  }

  .now-editor-actions .btn {
    min-height: 29px;
    padding: 5px 12px;
    font: 700 .7rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .now-editor-fields,
    .now-choice-row {
      grid-template-columns: 1fr;
    }

    .now-editor-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .now-editor-actions .btn {
      width: 100%;
    }
  }
</style>
