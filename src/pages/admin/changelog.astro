---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
import AdminModal from '../../components/admin/AdminModal.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Admin Changelog" active="changelog">
  <div class="changelog-admin-page">
    <AdminPostWorkspace
      active="changelog"
      tabs={[{ id: 'blogs', label: 'Blogs' }, { id: 'stories', label: 'Stories' }, { id: 'changelog', label: 'Changelog' }]}
    >
      <Fragment slot="actions">
        <button class="btn btn-ghost admin-add-post-tab" type="button" id="changelogAddTrigger" aria-label="Add changelog entry" title="Add changelog entry">+</button>
      </Fragment>

      <div class="changelog-layout">
        <section class="changelog-compose" aria-labelledby="changelogComposeTitle">
          <h2 id="changelogComposeTitle" class="changelog-section-label">Add entry</h2>
          <form id="changelogAddForm" class="admin-form">
            <AdminField label="Title" forId="newTitle">
              <input id="newTitle" type="text" placeholder="Optional title" />
            </AdminField>
            <AdminField label="Description" forId="newBody" required>
              <textarea id="newBody" rows="6" placeholder="What changed?"></textarea>
            </AdminField>
            <AdminStatus id="changelogMessage" />
            <div class="changelog-form-footer">
              <label class="admin-check"><input type="checkbox" id="newPinned" /> <span>Pin entry</span></label>
              <div class="changelog-form-actions">
                <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add entry</button>
              </div>
            </div>
          </form>
        </section>

        <section class="changelog-history" aria-labelledby="changelogHistoryTitle">
          <h2 id="changelogHistoryTitle" class="changelog-section-label">Entries</h2>
          <div id="changelogList" class="admin-list admin-post-list changelog-list">
            <p class="admin-status" data-state="loading">Loading…</p>
          </div>
        </section>
      </div>
    </AdminPostWorkspace>
  </div>

  <AdminModal id="editChangelogModal" title="Edit entry">
    <form id="changelogEditForm" class="admin-form">
      <input type="hidden" id="editId" />
      <AdminField label="Title" forId="editTitle">
        <input id="editTitle" type="text" />
      </AdminField>
      <AdminField label="Description" forId="editBody" required>
        <textarea id="editBody" rows="7"></textarea>
      </AdminField>
      <AdminStatus id="editChangelogMessage" />
      <div class="admin-modal-actions">
        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn btn-ghost" type="button" data-modal-close="editChangelogModal">Cancel</button>
      </div>
    </form>
  </AdminModal>
</AdminLayout>

<script>
  import { adminFetch, escapeHtml, setAdminStatus } from '../../lib/admin/api';

  type Entry = { id: string; title?: string; body: string; date?: string; pinned?: boolean };

  const list = document.querySelector<HTMLElement>('#changelogList')!;
  const message = document.querySelector<HTMLElement>('#changelogMessage');
  const editMessage = document.querySelector<HTMLElement>('#editChangelogMessage');
  const addTrigger = document.querySelector<HTMLButtonElement>('#changelogAddTrigger');
  const newTitle = document.querySelector<HTMLInputElement>('#newTitle')!;
  const newBody = document.querySelector<HTMLTextAreaElement>('#newBody')!;
  const newPinned = document.querySelector<HTMLInputElement>('#newPinned')!;
  const modal = document.querySelector<HTMLElement>('#editChangelogModal')!;
  let entries: Entry[] = [];

  const closeModal = () => {
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
  };

  const openModal = (entry: Entry) => {
    (document.querySelector<HTMLInputElement>('#editId')!).value = entry.id;
    (document.querySelector<HTMLInputElement>('#editTitle')!).value = entry.title || '';
    (document.querySelector<HTMLTextAreaElement>('#editBody')!).value = entry.body || '';
    setAdminStatus(editMessage);
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
  };

  function formatDate(value?: string) {
    if (!value) return 'No date';
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? value : parsed.toLocaleDateString();
  }

  function renderEntries() {
    if (!entries.length) {
      list.innerHTML = '<div class="admin-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No changelog entries</strong></div>';
      return;
    }

    list.innerHTML = entries.map((entry) => `
      <article class="admin-list-item changelog-list-item${entry.pinned ? ' is-pinned' : ''}" data-id="${escapeHtml(entry.id)}">
        <div class="admin-list-item-head item-header">
          <span class="post-card-icon" aria-hidden="true"><i class="bi bi-list-check"></i></span>
          <h3>${escapeHtml(entry.title?.trim() || 'Site update')}</h3>
        </div>
        <div class="admin-list-item-body item-content">
          <p class="post-card-description">${escapeHtml(entry.body)}</p>
          <div class="admin-list-meta item-meta">
            <span class="post-date">${escapeHtml(formatDate(entry.date))}</span>
            ${entry.pinned ? '<span class="post-tags"><span class="chip">Pinned</span></span>' : ''}
          </div>
        </div>
        <div class="admin-list-item-actions">
          <button class="btn btn-ghost" type="button" data-edit="${escapeHtml(entry.id)}">Edit</button>
          <button class="btn btn-ghost admin-danger" type="button" data-delete="${escapeHtml(entry.id)}">Delete</button>
        </div>
      </article>
    `).join('');
  }

  async function load() {
    list.innerHTML = '<p class="admin-status" data-state="loading">Loading…</p>';
    try {
      const response = await adminFetch('/site/changelog?limit=50', {}, { auth: false });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Failed to load changelog');
      entries = Array.isArray(data) ? data : [];
      renderEntries();
    } catch (error) {
      list.innerHTML = `<p class="admin-status" data-state="error">${escapeHtml(error instanceof Error ? error.message : 'Failed to load changelog')}</p>`;
    }
  }

  addTrigger?.addEventListener('click', () => {
    document.querySelector<HTMLElement>('.changelog-compose')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    window.setTimeout(() => newTitle.focus(), 180);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-modal-close="editChangelogModal"]').forEach((button) => button.addEventListener('click', closeModal));
  modal.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  document.querySelector<HTMLFormElement>('#changelogAddForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!newBody.value.trim()) {
      setAdminStatus(message, 'Description is required.', 'error');
      return;
    }
    setAdminStatus(message, 'Adding…', 'loading');
    try {
      const response = await adminFetch('/admin/changelog', {
        method: 'POST',
        body: JSON.stringify({ title: newTitle.value, body: newBody.value, pinned: newPinned.checked })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to add entry');
      (event.currentTarget as HTMLFormElement).reset();
      setAdminStatus(message, 'Entry added.', 'success');
      await load();
    } catch (error) {
      setAdminStatus(message, error instanceof Error ? error.message : 'Failed to add entry', 'error');
    }
  });

  list.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const edit = target.closest<HTMLButtonElement>('[data-edit]');
    const del = target.closest<HTMLButtonElement>('[data-delete]');
    if (edit) {
      const entry = entries.find((item) => item.id === edit.dataset.edit);
      if (entry) openModal(entry);
      return;
    }
    if (!del?.dataset.delete || !window.confirm('Delete this entry?')) return;
    try {
      const response = await adminFetch(`/admin/changelog/${encodeURIComponent(del.dataset.delete)}`, { method: 'DELETE' });
      if (!response.ok) throw new Error('Failed to delete entry');
      await load();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Failed to delete entry');
    }
  });

  document.querySelector<HTMLFormElement>('#changelogEditForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const id = (document.querySelector<HTMLInputElement>('#editId')!).value;
    const title = (document.querySelector<HTMLInputElement>('#editTitle')!).value;
    const body = (document.querySelector<HTMLTextAreaElement>('#editBody')!).value;
    if (!body.trim()) {
      setAdminStatus(editMessage, 'Description is required.', 'error');
      return;
    }
    setAdminStatus(editMessage, 'Saving…', 'loading');
    try {
      const response = await adminFetch(`/admin/changelog/${encodeURIComponent(id)}`, {
        method: 'PATCH',
        body: JSON.stringify({ title, body })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Failed to update entry');
      closeModal();
      await load();
    } catch (error) {
      setAdminStatus(editMessage, error instanceof Error ? error.message : 'Failed to update entry', 'error');
    }
  });

  void load();
</script>

<style is:global>
  .changelog-admin-page {
    min-width: 0;
  }

  .changelog-admin-page .admin-post-workspace-content {
    padding: 10px;
  }

  .changelog-layout {
    display: grid;
    grid-template-columns: minmax(190px, .68fr) minmax(0, 1.32fr);
    gap: 12px;
    align-items: start;
  }

  .changelog-compose,
  .changelog-history {
    min-width: 0;
  }

  .changelog-section-label {
    margin: 0 2px 8px;
    padding: 0 0 5px;
    border-bottom: 1px dotted var(--primary-dark);
    color: var(--primary-dark);
    font: 700 .7rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .changelog-compose .admin-form {
    max-width: none;
    gap: 9px;
  }

  .changelog-compose .admin-field {
    gap: 3px;
  }

  .changelog-compose .admin-field label,
  .changelog-compose .admin-check {
    color: var(--text);
    font: 700 .68rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .changelog-compose input:not([type="checkbox"]),
  .changelog-compose textarea {
    min-height: 31px;
    padding: 6px 8px;
    border-radius: 4px;
    font: .76rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .changelog-compose textarea {
    min-height: 128px;
    resize: vertical;
  }

  .changelog-compose .admin-check {
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: none;
  }

  .changelog-compose .admin-check input {
    accent-color: var(--primary-dark);
  }

  .changelog-form-actions {
    display: flex;
    margin-left: auto;
  }

  .changelog-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .changelog-form-actions .btn {
    min-height: 28px;
    padding: 5px 10px;
    font: 700 .68rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .changelog-history .changelog-list {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .changelog-history .changelog-list .admin-list-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "head actions" "body actions";
    gap: 3px 10px;
    align-items: center;
    height: auto;
    min-height: 82px;
    padding: 7px 10px;
    border-radius: 5px;
    background: var(--card);
    box-shadow: inset 1px 1px 0 color-mix(in srgb, var(--primary-light) 34%, transparent), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
    transition: border-color .16s ease, background-color .16s ease;
  }

  .changelog-history .changelog-list .admin-list-item:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary-light) 10%, var(--card));
  }

  .changelog-history .changelog-list .admin-list-item.is-pinned {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary-light) 13%, var(--card));
  }

  .changelog-history .changelog-list .admin-list-item-head {
    grid-area: head;
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .changelog-history .changelog-list .post-card-icon {
    flex: 0 0 auto;
    color: var(--primary-dark);
    font-size: .72rem;
  }

  .changelog-history .changelog-list .admin-list-item-head h3 {
    min-width: 0;
    overflow: hidden;
    margin: 0;
    color: var(--text);
    font: 700 .78rem/1.25 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .changelog-history .changelog-list .admin-list-item-body {
    grid-area: body;
    display: flex;
    min-width: 0;
    padding: 0;
  }

  .changelog-history .changelog-list .post-card-description {
    display: -webkit-box;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--text-muted);
    font: .72rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .changelog-history .changelog-list .admin-list-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    color: var(--text-muted);
    font: .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .changelog-history .changelog-list .post-date {
    color: var(--primary-dark);
    font-weight: 700;
    white-space: nowrap;
  }

  .changelog-history .changelog-list .post-tags,
  .changelog-history .changelog-list .chip {
    display: inline-flex;
    align-items: center;
  }

  .changelog-history .changelog-list .chip {
    padding: 2px 5px;
    border: 1px solid var(--border-light);
    border-radius: 3px;
    background: color-mix(in srgb, var(--primary-light) 12%, var(--bg-elev));
    color: var(--primary-dark);
    font-size: .6rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .changelog-history .changelog-list .admin-list-item-actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 100%;
    padding: 0 0 0 10px;
    border-left: 1px solid var(--border-light);
  }

  .changelog-history .changelog-list .admin-list-item-actions .btn {
    min-height: 25px;
    padding: 4px 7px;
    border-radius: 4px;
    font: 700 .62rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .changelog-admin-page .admin-status {
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .changelog-admin-page .admin-empty-state {
    min-height: 100px;
  }

  #editChangelogModal .admin-form {
    max-width: none;
  }

  /* Keep changelog controls and rows on the same compact, glossy admin
     surface as the Blogs and Stories workspaces. */
  .changelog-admin-page .changelog-compose input:not([type='checkbox']):not([type='radio']),
  .changelog-admin-page .changelog-compose textarea,
  #editChangelogModal input:not([type='checkbox']):not([type='radio']),
  #editChangelogModal textarea {
    width: 100%;
    box-sizing: border-box;
    min-height: 32px;
    padding: 6px 8px;
    border: 1px solid var(--primary-dark);
    border-top-color: var(--primary-light);
    border-left-color: var(--primary-light);
    border-radius: 4px;
    background: linear-gradient(
      to bottom,
      var(--bg-elev) 0%,
      color-mix(in srgb, var(--primary-light) 15%, var(--bg-elev)) 46%,
      color-mix(in srgb, var(--primary-dark) 12%, var(--bg-elev)) 51%,
      var(--bg-elev) 100%
    );
    color: var(--text);
    font: .76rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .72), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 24%, transparent);
  }

  .changelog-admin-page .changelog-compose textarea,
  #editChangelogModal textarea {
    min-height: 128px;
    resize: vertical;
  }

  .changelog-admin-page .changelog-compose input::placeholder,
  .changelog-admin-page .changelog-compose textarea::placeholder,
  #editChangelogModal input::placeholder,
  #editChangelogModal textarea::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .changelog-admin-page .changelog-compose input:focus-visible,
  .changelog-admin-page .changelog-compose textarea:focus-visible,
  #editChangelogModal input:focus-visible,
  #editChangelogModal textarea:focus-visible {
    border-color: var(--primary-dark);
    outline: 2px solid color-mix(in srgb, var(--primary) 48%, transparent);
    outline-offset: 1px;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .78), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 28%, transparent), 0 0 0 2px color-mix(in srgb, var(--primary-light) 24%, transparent);
  }

  .changelog-history {
    overflow: hidden;
  }

  .changelog-history .changelog-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .changelog-history .changelog-list .admin-list-item {
    position: relative;
    display: flex;
    height: 146px;
    min-height: 146px;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
    overflow: hidden;
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg-elev) 86%, transparent);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .75), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 30%, transparent), 1px 1px 2px rgba(0, 0, 0, .12);
    transition: border-color .16s ease, background-color .16s ease, box-shadow .16s ease;
  }

  .changelog-history .changelog-list .admin-list-item:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev));
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .85), 0 1px 3px color-mix(in srgb, var(--primary-dark) 22%, transparent);
    transform: none;
  }

  .changelog-history .changelog-list .admin-list-item.is-pinned {
    border-color: var(--primary);
  }

  .changelog-history .changelog-list .admin-list-item-head {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px;
    align-items: center;
    position: relative;
    min-width: 0;
    padding: 7px 8px;
    padding-right: 108px;
    border-bottom: 1px solid var(--primary-dark);
    background: linear-gradient(to bottom, var(--primary-light) 0%, var(--primary) 45%, var(--primary-dark) 50%, var(--primary-light) 100%);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .6);
  }

  .changelog-history .changelog-list .admin-list-item-head h3 {
    display: block;
    min-width: 0;
    overflow: hidden;
    margin: 0;
    color: #fff;
    font: 700 .78rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-overflow: ellipsis;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 75%, #000);
    white-space: nowrap;
  }

  .changelog-history .changelog-list .admin-list-item-head .post-card-icon {
    color: #fff;
    font-size: .72rem;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 75%, #000);
  }

  .changelog-history .changelog-list .admin-list-item-body {
    display: flex;
    min-width: 0;
    flex: 1;
    align-self: stretch;
    width: 100%;
    box-sizing: border-box;
    flex-direction: column;
    padding: 8px;
  }

  .changelog-history .changelog-list .post-card-description {
    display: -webkit-box;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    color: var(--text);
    font: .72rem/1.35 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .changelog-history .changelog-list .admin-list-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 52%, transparent);
    color: var(--text-muted);
    font: .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .changelog-history .changelog-list .post-date {
    color: var(--primary-dark);
    font-weight: 700;
    white-space: nowrap;
  }

  .changelog-history .changelog-list .admin-list-item-actions {
    display: flex;
    align-items: center;
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 1;
    gap: 5px;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .changelog-history .changelog-list .admin-list-item-actions .btn {
    height: 20px;
    min-height: 20px;
    box-sizing: border-box;
    padding: 3px 7px;
    border: 1px solid color-mix(in srgb, var(--primary-dark) 72%, var(--border-light));
    border-radius: 3px;
    background: linear-gradient(to bottom, var(--bg-elev), color-mix(in srgb, var(--primary-light) 18%, var(--bg-elev)));
    color: var(--primary-dark);
    font: 700 .6rem/normal "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .82), inset 0 -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
    text-transform: uppercase;
  }

  .changelog-history .changelog-list .admin-list-item-actions .btn:hover {
    border-color: var(--primary-dark);
    background: linear-gradient(to bottom, var(--primary-light), var(--primary));
    color: var(--bg);
    transform: none;
  }

  .changelog-history .changelog-list .admin-list-item-actions .admin-danger {
    color: var(--admin-danger, #b42318);
  }

