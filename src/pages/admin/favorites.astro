---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminField from '../../components/admin/AdminField.astro';
import AdminStatus from '../../components/admin/AdminStatus.astro';
import AdminModal from '../../components/admin/AdminModal.astro';
import AdminTabs from '../../components/admin/AdminTabs.astro';
import AdminPostWorkspace from '../../components/admin/AdminPostWorkspace.astro';
---
<AdminLayout title="Favorites Editor" active="favorites" wide={true}>
  <div class="favorites-admin-page">
    <AdminPostWorkspace active="favorites" tabs={[{ id: 'favorites', label: 'Favorites' }]}>
      <div id="favoriteTabs" class="favorite-tabs">
        <AdminTabs
          tabs={[
            { id: 'anime', label: 'Anime' },
            { id: 'manga', label: 'Manga / LN' },
            { id: 'characters', label: 'Characters' },
            { id: 'games', label: 'Games' }
          ]}
          active="anime"
          dataAttribute="category"
        />
      </div>

    <div class="favorite-tool-grid">
      <div class="favorite-source-panel">
        <section class="favorite-tool-block" id="malImportSection">
          <h3>Import from MyAnimeList</h3>
          <div class="admin-toolbar">
            <AdminField label="Username" forId="malUsername"><input id="malUsername" type="text" placeholder="MyAnimeList username" /></AdminField>
            <button class="btn btn-primary" id="importMal" type="button">Import</button>
          </div>
          <div class="admin-progress favorite-progress" id="importProgress" hidden><div><span id="importFill"></span></div><small id="importText">Importing...</small></div>
        </section>

        <section class="favorite-tool-block favorite-search-block">
          <h3>Search MyAnimeList</h3>
          <div class="admin-toolbar">
            <AdminField label="Title" forId="favoriteSearch"><input id="favoriteSearch" type="text" placeholder="Search by title..." /></AdminField>
            <button class="btn btn-ghost" id="searchFavorites" type="button">Search</button>
          </div>
          <div id="favoriteSearchResults" class="admin-search-results" hidden></div>
        </section>
      </div>

      <section class="favorite-manual-panel">
        <h3>Add manually</h3>
        <form id="favoriteAddForm" class="admin-favorite-form">
          <AdminField label="Title" forId="addTitle" required><input id="addTitle" required /></AdminField>
          <AdminField label="Image URL" forId="addImage"><input id="addImage" type="url" placeholder="https://..." /></AdminField>
          <AdminField label="MAL ID" forId="addMalId"><input id="addMalId" type="number" min="1" /></AdminField>
          <AdminField label="Status" forId="addStatus"><select id="addStatus"><option value="completed">Completed</option><option value="watching">Watching / Reading / Playing</option><option value="plan">Plan to Watch / Read / Play</option><option value="dropped">Dropped</option></select></AdminField>
          <AdminField label="Score" forId="addScore"><input id="addScore" type="number" min="0" max="10" step="0.01" /></AdminField>
          <AdminField label="Year" forId="addYear"><input id="addYear" type="number" min="1900" max="2100" /></AdminField>
          <AdminField label="Description" forId="addDescription" class="admin-favorite-full"><textarea id="addDescription"></textarea></AdminField>
          <div class="admin-favorite-full favorite-form-actions"><button class="btn btn-primary" type="submit">Add favorite</button></div>
        </form>
      </section>
    </div>

    <section class="favorite-library-section" aria-labelledby="favoriteLibraryTitle">
      <div class="admin-list-toolbar admin-favorite-toolbar">
        <div class="favorite-library-title"><div class="favorite-library-heading"><h3 id="favoriteLibraryTitle">Current favorites</h3><span class="admin-count" id="favoriteCount">0</span></div></div>
        <div class="favorite-library-actions"><span id="favoriteSyncStatus" class="admin-sync-label">Checking cache...</span><button class="btn btn-ghost" id="applyManualMetadata" type="button">Fill MAL data</button><button class="btn btn-ghost" id="syncJikan" type="button">Sync missing</button></div>
      </div>
      <div class="admin-progress favorite-progress" id="syncProgress" hidden><div><span id="syncFill"></span></div><small id="syncText">Syncing...</small></div>
      <AdminStatus id="favoriteMessage" />
      <div id="favoritesList" class="admin-grid favorite-grid"><p class="admin-status" data-state="loading">Loading...</p></div>
    </section>
    </AdminPostWorkspace>
  </div>

  <AdminModal id="editFavoriteModal" title="Edit Favorite">
    <form id="favoriteEditForm" class="admin-form">
      <input type="hidden" id="editFavoriteId" />
      <AdminField label="Title" forId="editFavoriteTitle" required><input id="editFavoriteTitle" required /></AdminField>
      <AdminField label="Image URL" forId="editFavoriteImage"><input id="editFavoriteImage" type="url" /></AdminField>
      <AdminField label="Status" forId="editFavoriteStatus"><select id="editFavoriteStatus"><option value="completed">Completed</option><option value="watching">Watching / Reading / Playing</option><option value="plan">Plan to Watch / Read / Play</option><option value="dropped">Dropped</option></select></AdminField>
      <div class="admin-split"><AdminField label="Score" forId="editFavoriteScore"><input id="editFavoriteScore" type="number" min="0" max="10" step="0.01" /></AdminField><AdminField label="Year" forId="editFavoriteYear"><input id="editFavoriteYear" type="number" min="1900" max="2100" /></AdminField></div>
      <AdminField label="Description" forId="editFavoriteDescription"><textarea id="editFavoriteDescription"></textarea></AdminField>
      <AdminStatus id="editFavoriteMessage" />
      <div class="admin-modal-actions"><button class="btn btn-primary" type="submit">Save Changes</button><button class="btn btn-ghost" type="button" data-modal-close="editFavoriteModal">Cancel</button></div>
    </form>
  </AdminModal>

  <script>
    import { adminFetch, escapeHtml, setAdminStatus } from '../../lib/admin/api';
    type Favorite=Record<string,any> & {id?:string;title:string;image?:string|null;status?:string;score?:number|null;year?:number|null;description?:string|null;mal_id?:number|null;jikan?:Record<string,any>};
    const JIKAN='https://api.jikan.moe/v4'; let category='anime'; let favorites:Favorite[]=[]; let searchItems:Favorite[]=[]; let lastJikan=0;
    const list=document.querySelector<HTMLElement>('#favoritesList')!; const count=document.querySelector<HTMLElement>('#favoriteCount')!; const message=document.querySelector<HTMLElement>('#favoriteMessage'); const syncStatus=document.querySelector<HTMLElement>('#favoriteSyncStatus')!; const modal=document.querySelector<HTMLElement>('#editFavoriteModal')!; const editMessage=document.querySelector<HTMLElement>('#editFavoriteMessage');
    const malId=(item:any)=>item?.mal_id??item?.malId??item?.myanimelist_id??item?.myanimelistId??null; const jikan=(item:any)=>item?.jikan&&typeof item.jikan==='object'?item.jikan:(item?.jikan_metadata&&typeof item.jikan_metadata==='object'?item.jikan_metadata:null);
    function closeModal(){modal.classList.remove('active');modal.setAttribute('aria-hidden','true')} document.querySelectorAll('[data-modal-close="editFavoriteModal"]').forEach((button)=>button.addEventListener('click',closeModal));modal.addEventListener('click',(event)=>{if(event.target===modal)closeModal()});
    function statusClass(value:string){return ['completed','watching','playing','plan','dropped'].includes(value)?value:'plan'}
    function render(){count.textContent=String(favorites.length);if(!favorites.length){list.innerHTML='<div class="admin-empty-state"><i class="bi bi-heart"></i><span>No favorites in this category yet.</span></div>';updateSync();return;}list.innerHTML=favorites.map((item,index)=>`<article class="admin-favorite-card" data-index="${index}">${item.image?`<img src="${escapeHtml(item.image)}" alt="" loading="lazy">`:'<div class="admin-favorite-placeholder"><i class="bi bi-image"></i></div>'}<div class="admin-favorite-body"><strong>${escapeHtml(item.title)}</strong><div class="admin-list-meta"><span class="admin-favorite-status ${statusClass(item.status||'')}">${escapeHtml(item.status||'plan')}</span>${item.score!=null?`<span>★ ${escapeHtml(item.score)}</span>`:''}${item.year?`<span>${escapeHtml(item.year)}</span>`:''}${malId(item)?`<span>MAL ${escapeHtml(malId(item))}</span>`:''}</div>${item.description?`<p>${escapeHtml(item.description)}</p>`:''}</div><footer><button class="btn btn-ghost" data-edit="${index}" type="button">Edit</button><button class="btn btn-ghost admin-danger" data-delete="${escapeHtml(item.id??index)}" data-index="${index}" type="button">Delete</button></footer></article>`).join('');updateSync()}
    function updateSync(){if(category==='games'){syncStatus.textContent='Jikan does not provide game stats';(document.querySelector<HTMLButtonElement>('#syncJikan')!).disabled=true;return;}const linked=favorites.filter((item)=>malId(item));const cached=linked.filter((item)=>jikan(item)).length;const missing=linked.length-cached;syncStatus.textContent=!linked.length?'No MAL IDs linked yet':missing?`${cached}/${linked.length} cached · ${missing} missing`:`All ${linked.length} MAL entries cached`;const button=document.querySelector<HTMLButtonElement>('#syncJikan')!;button.disabled=!linked.length;button.textContent=missing?`Sync ${missing} missing`:'Refresh cache'}
    async function load(){list.innerHTML='<p class="admin-status" data-state="loading">Loading…</p>';setAdminStatus(message);try{const response=await adminFetch(`/site/favorites?category=${encodeURIComponent(category)}`,{}, {auth:false});const data=await response.json();if(!response.ok)throw new Error(data.error||'Failed to load');favorites=Array.isArray(data.items)?data.items:[];render()}catch(error){list.innerHTML='';setAdminStatus(message,error instanceof Error?error.message:'Failed to load','error')}}
    async function switchCategory(next:string){category=next;document.querySelectorAll<HTMLButtonElement>('#favoriteTabs [data-category]').forEach((button)=>{const active=button.dataset.category===next;button.classList.toggle('active',active);button.setAttribute('aria-selected',String(active))});const importSection=document.querySelector<HTMLElement>('#malImportSection')!;importSection.hidden=next==='games';const search=document.querySelector<HTMLInputElement>('#favoriteSearch')!;search.placeholder=next==='games'?'Games are manual-only':'Search by title…';(document.querySelector<HTMLButtonElement>('#searchFavorites')!).disabled=next==='games';await load()}
    document.querySelectorAll<HTMLButtonElement>('#favoriteTabs [data-category]').forEach((button)=>button.addEventListener('click',()=>switchCategory(button.dataset.category||'anime')));
    document.querySelector<HTMLFormElement>('#favoriteAddForm')?.addEventListener('submit',async(event)=>{event.preventDefault();const item:Favorite={title:(document.querySelector<HTMLInputElement>('#addTitle')!).value.trim(),image:(document.querySelector<HTMLInputElement>('#addImage')!).value.trim()||null,mal_id:parseInt((document.querySelector<HTMLInputElement>('#addMalId')!).value,10)||null,status:(document.querySelector<HTMLSelectElement>('#addStatus')!).value,score:parseFloat((document.querySelector<HTMLInputElement>('#addScore')!).value)||null,year:parseInt((document.querySelector<HTMLInputElement>('#addYear')!).value,10)||null,description:(document.querySelector<HTMLTextAreaElement>('#addDescription')!).value.trim()||null};if(!item.title){setAdminStatus(message,'Title is required.','error');return;}try{const response=await adminFetch('/admin/favorites',{method:'POST',body:JSON.stringify({category,item})});const data=await response.json();if(!response.ok)throw new Error(data.error||'Failed to add favorite');favorites.push(data.item||item);(event.currentTarget as HTMLFormElement).reset();render();setAdminStatus(message,'Favorite added.','success')}catch(error){setAdminStatus(message,error instanceof Error?error.message:'Failed to add favorite','error')}});
    list.addEventListener('click',async(event)=>{const target=event.target as HTMLElement;const edit=target.closest<HTMLButtonElement>('[data-edit]');const del=target.closest<HTMLButtonElement>('[data-delete]');if(edit){const item=favorites[Number(edit.dataset.edit)];if(!item)return;(document.querySelector<HTMLInputElement>('#editFavoriteId')!).value=String(item.id??'');(document.querySelector<HTMLInputElement>('#editFavoriteTitle')!).value=item.title||'';(document.querySelector<HTMLInputElement>('#editFavoriteImage')!).value=item.image||'';(document.querySelector<HTMLSelectElement>('#editFavoriteStatus')!).value=item.status||'completed';(document.querySelector<HTMLInputElement>('#editFavoriteScore')!).value=String(item.score??'');(document.querySelector<HTMLInputElement>('#editFavoriteYear')!).value=String(item.year??'');(document.querySelector<HTMLTextAreaElement>('#editFavoriteDescription')!).value=item.description||'';modal.dataset.index=edit.dataset.edit||'';setAdminStatus(editMessage);modal.classList.add('active');modal.setAttribute('aria-hidden','false')}if(del&&window.confirm('Delete this favorite?')){const item=favorites[Number(del.dataset.index)];const itemId=item?.id??del.dataset.delete;try{const response=await adminFetch('/admin/favorites',{method:'DELETE',body:JSON.stringify({category,itemId})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Delete failed');favorites.splice(Number(del.dataset.index),1);render()}catch(error){window.alert(error instanceof Error?error.message:'Delete failed')}}});
    document.querySelector<HTMLFormElement>('#favoriteEditForm')?.addEventListener('submit',async(event)=>{event.preventDefault();const index=Number(modal.dataset.index);const current=favorites[index];if(!current)return;const itemId=current.id??(document.querySelector<HTMLInputElement>('#editFavoriteId')!).value;const updates={title:(document.querySelector<HTMLInputElement>('#editFavoriteTitle')!).value.trim(),image:(document.querySelector<HTMLInputElement>('#editFavoriteImage')!).value.trim()||null,status:(document.querySelector<HTMLSelectElement>('#editFavoriteStatus')!).value,score:parseFloat((document.querySelector<HTMLInputElement>('#editFavoriteScore')!).value)||null,year:parseInt((document.querySelector<HTMLInputElement>('#editFavoriteYear')!).value,10)||null,description:(document.querySelector<HTMLTextAreaElement>('#editFavoriteDescription')!).value.trim()||null};if(!updates.title){setAdminStatus(editMessage,'Title is required.','error');return;}setAdminStatus(editMessage,'Saving…','loading');try{const response=await adminFetch('/admin/favorites/item',{method:'PATCH',body:JSON.stringify({category,itemId,updates})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Update failed');favorites[index]={...current,...updates};closeModal();render()}catch(error){setAdminStatus(editMessage,error instanceof Error?error.message:'Update failed','error')}});
    async function jikanRequest(url:string){const wait=Math.max(0,1200-(Date.now()-lastJikan));if(wait)await new Promise((resolve)=>setTimeout(resolve,wait));lastJikan=Date.now();const response=await fetch(url);if(!response.ok)throw new Error(`Jikan ${response.status}`);return response.json()}
    document.querySelector('#searchFavorites')?.addEventListener('click',async()=>{const query=(document.querySelector<HTMLInputElement>('#favoriteSearch')!).value.trim();const results=document.querySelector<HTMLElement>('#favoriteSearchResults')!;if(!query)return;if(category==='games'){results.hidden=false;results.innerHTML='<div class="admin-empty-state"><span>Jikan does not support games. Add them manually.</span></div>';return;}results.hidden=false;results.innerHTML='<p class="admin-status" data-state="loading">Searching…</p>';try{const endpoint=category==='characters'?'characters':category;const data=await jikanRequest(`${JIKAN}/${endpoint}?q=${encodeURIComponent(query)}&limit=10`);searchItems=(data.data||[]).map((item:any)=>category==='characters'?{title:item.name,image:item.images?.jpg?.image_url,year:null,score:null,description:item.about?.substring(0,200),mal_id:item.mal_id,status:'completed',jikan:{url:item.url||null,type:null,status:null,score:null,year:null,series:null,synced_at:Date.now()}}:{title:item.title,image:item.images?.jpg?.image_url||item.images?.jpg?.large_image_url,year:item.year||(item.aired?.from?new Date(item.aired.from).getFullYear():null)||(item.published?.from?new Date(item.published.from).getFullYear():null),score:item.score,description:item.synopsis?.substring(0,200),mal_id:item.mal_id,status:item.status==='Finished Airing'||item.status==='Finished'?'completed':'watching',jikan:{url:item.url||null,type:item.type||null,status:item.status||null,score:item.score??null,year:item.year??null,synced_at:Date.now()}});if(!searchItems.length){results.innerHTML='<div class="admin-empty-state"><span>No results found.</span></div>';return;}results.innerHTML=searchItems.map((item,index)=>`<button class="admin-search-item" type="button" data-search-index="${index}">${item.image?`<img src="${escapeHtml(item.image)}" alt="">`:''}<span><strong>${escapeHtml(item.title)}</strong><small>${item.year?escapeHtml(item.year):''}${item.score!=null?` · ★ ${escapeHtml(item.score)}`:''}</small></span></button>`).join('')}catch(error){results.innerHTML=`<p class="admin-status" data-state="error">${escapeHtml(error instanceof Error?error.message:'Search failed')}</p>`}});
    document.querySelector('#favoriteSearchResults')?.addEventListener('click',async(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-search-index]');if(!button)return;const item=searchItems[Number(button.dataset.searchIndex)];if(!item)return;if(favorites.some((favorite)=>malId(favorite)===malId(item)||favorite.title===item.title)){window.alert('This item is already in your favorites.');return;}try{const response=await adminFetch('/admin/favorites',{method:'POST',body:JSON.stringify({category,item})});const data=await response.json();if(!response.ok)throw new Error(data.error||'Failed to add');favorites.push(data.item||item);render()}catch(error){window.alert(error instanceof Error?error.message:'Failed to add')}});
    document.querySelector('#importMal')?.addEventListener('click',async()=>{const username=(document.querySelector<HTMLInputElement>('#malUsername')!).value.trim();if(!username)return;const progress=document.querySelector<HTMLElement>('#importProgress')!;const fill=document.querySelector<HTMLElement>('#importFill')!;const text=document.querySelector<HTMLElement>('#importText')!;progress.hidden=false;fill.style.width='10%';text.textContent='Fetching favorites from MyAnimeList…';try{const data=await jikanRequest(`${JIKAN}/users/${encodeURIComponent(username)}/favorites`);const source=category==='anime'?data.data?.anime:category==='manga'?data.data?.manga:data.data?.characters;const items=Array.isArray(source)?source:[];fill.style.width='50%';text.textContent=`Processing ${items.length} ${category}…`;const converted=items.map((item:any)=>category==='characters'?{id:Date.now().toString()+Math.random().toString(36).slice(2),title:item.name,image:item.images?.jpg?.image_url,year:null,score:null,mal_id:item.mal_id,status:'completed',description:null}:{id:Date.now().toString()+Math.random().toString(36).slice(2),title:item.title,image:item.images?.jpg?.image_url,year:item.start_year||null,score:null,mal_id:item.mal_id,status:'completed',description:null});const existing=new Set(favorites.map((item)=>malId(item)));const unique=converted.filter((item:any)=>!existing.has(item.mal_id));if(!unique.length){fill.style.width='100%';text.textContent=`All ${category} are already saved.`;return;}const merged=[...favorites,...unique];const response=await adminFetch('/admin/favorites',{method:'PUT',body:JSON.stringify({category,items:merged})});const saved=await response.json().catch(()=>({}));if(!response.ok)throw new Error(saved.error||'Import failed');favorites=merged;fill.style.width='100%';text.textContent=`Imported ${unique.length} new favorites.`;render()}catch(error){fill.style.width='0%';text.textContent=error instanceof Error?error.message:'Import failed'}});
    async function fetchJikanRecord(item:Favorite){const id=malId(item);if(!id||category==='games')return null;const endpoint=category==='characters'?`characters/${encodeURIComponent(id)}/full`:`${category}/${encodeURIComponent(id)}`;for(let attempt=0;attempt<3;attempt++){try{const payload=await jikanRequest(`${JIKAN}/${endpoint}`);const data=payload.data;if(!data)return null;return {url:data.url||null,type:data.type||null,status:data.status||null,score:data.score??null,year:data.year||(data.aired?.from?new Date(data.aired.from).getFullYear():null)||(data.published?.from?new Date(data.published.from).getFullYear():null),episodes:data.episodes??null,chapters:data.chapters??null,volumes:data.volumes??null,image:data.images?.jpg?.image_url||null,series:category==='characters'?(data.anime?.[0]?.anime?.title||data.manga?.[0]?.manga?.title||null):null,synced_at:Date.now()}}catch(error){if(attempt===2)throw error;await new Promise((resolve)=>setTimeout(resolve,1200))}}return null}
    document.querySelector('#syncJikan')?.addEventListener('click',async()=>{if(category==='games')return;const indexed=favorites.map((item,index)=>({item,index})).filter(({item})=>malId(item)&&!jikan(item));const targets=indexed.length?indexed:favorites.map((item,index)=>({item,index})).filter(({item})=>malId(item));if(!targets.length)return;const progress=document.querySelector<HTMLElement>('#syncProgress')!;const fill=document.querySelector<HTMLElement>('#syncFill')!;const text=document.querySelector<HTMLElement>('#syncText')!;progress.hidden=false;const updated=[...favorites];let saved=0;for(let position=0;position<targets.length;position++){const {item,index}=targets[position];try{const metadata=await fetchJikanRecord(item);if(metadata){updated[index]={...item,score:category==='characters'?item.score??null:metadata.score??item.score??null,year:metadata.year||item.year||null,image:item.image||metadata.image||null,jikan:metadata};saved++}}catch(_){}fill.style.width=`${Math.round(((position+1)/targets.length)*80)}%`;text.textContent=`Checked ${position+1}/${targets.length} · ${saved} saved`;}try{const response=await adminFetch('/admin/favorites',{method:'PUT',body:JSON.stringify({category,items:updated})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Save failed');favorites=updated;fill.style.width='100%';text.textContent=`Finished · ${saved} metadata records saved.`;render()}catch(error){fill.style.width='0%';text.textContent=error instanceof Error?error.message:'Sync failed'}});
    document.querySelector('#applyManualMetadata')?.addEventListener('click',async()=>{const button=document.querySelector<HTMLButtonElement>('#applyManualMetadata')!;button.disabled=true;setAdminStatus(message,'Applying verified metadata…','loading');try{const metadataModulePath='/admin/manual-favorites-metadata.js';const module=await import(/* @vite-ignore */ metadataModulePath);for(const current of ['anime','manga','characters']){const response=await adminFetch(`/site/favorites?category=${current}`,{}, {auth:false});const data=await response.json();const source=Array.isArray(data.items)?data.items:[];const updated=source.map((item:any)=>{const metadata=module.manualMetadataFor(current,item);return metadata?{...item,score:current==='characters'?item.score??null:metadata.score??item.score??null,year:metadata.year||item.year||null,image:item.image||metadata.image||null,jikan:{...(jikan(item)||{}),...metadata}}:item});const save=await adminFetch('/admin/favorites',{method:'PUT',body:JSON.stringify({category:current,items:updated})});if(!save.ok)throw new Error(`${current} save failed`)}await load();setAdminStatus(message,'Verified MAL metadata saved.','success')}catch(error){setAdminStatus(message,error instanceof Error?error.message:'Metadata update failed','error')}finally{button.disabled=false}}); load();
  </script>
  <style>.admin-subsection{padding:0 0 12px;margin:0 0 12px;border-bottom:1px dashed var(--border-light)}.admin-subsection h3,.admin-list-toolbar h3{margin:0 0 8px;font-size:.78rem;letter-spacing:.07em;text-transform:uppercase}.admin-favorite-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.admin-favorite-full{grid-column:1/-1}.admin-list-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:12px 0 8px}.admin-list-toolbar>div{display:flex;align-items:center;justify-content:flex-end;gap:6px;flex-wrap:wrap}.admin-sync-label{color:var(--text-muted);font-size:.7rem}.admin-count{display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 5px;border-radius:10px;background:var(--primary);color:var(--bg);font-size:.68rem}.admin-progress{display:grid;gap:5px;margin:7px 0;padding:7px;border:1px solid var(--border-light);border-radius:6px}.admin-progress>div{height:6px;overflow:hidden;border-radius:3px;background:var(--bg-secondary)}.admin-progress>div>span{display:block;height:100%;width:0;background:var(--primary);transition:width .2s}.admin-progress small{color:var(--text-muted)}.admin-search-results{display:grid;gap:5px;max-height:310px;overflow:auto;margin-top:7px}.admin-search-item{display:flex;align-items:center;gap:9px;width:100%;padding:7px;border:1px solid var(--border-light);border-radius:6px;background:var(--card);color:var(--text);text-align:left;cursor:pointer}.admin-search-item:hover{border-color:var(--primary)}.admin-search-item img{width:42px;height:58px;object-fit:cover;border-radius:4px}.admin-search-item span{display:grid;gap:2px}.admin-search-item small{color:var(--text-muted)}.admin-favorite-card{display:grid;grid-template-rows:110px 1fr auto;border:1px solid var(--border-light);border-radius:7px;overflow:hidden;background:var(--card)}.admin-favorite-card>img,.admin-favorite-placeholder{width:100%;height:110px;object-fit:cover;background:var(--bg-secondary)}.admin-favori