---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import SiteSection from '../components/SiteSection.astro';
import PortfolioShowcase from '../components/PortfolioShowcase.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<ContentLayout title="Portfolio">
  <SiteSection title="Portfolio" id="portfolio" class="portfolio-section">
    <PortfolioShowcase projects={projects} />
  </SiteSection>
</ContentLayout>
