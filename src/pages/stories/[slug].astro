---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import PostKudos from '../../components/PostKudos.astro';
import { entrySlug, sortByDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = sortByDate(await getCollection('stories', ({ data }) => !data.draft));
  return posts.map((post, index) => ({
    params: { slug: entrySlug(post.id) },
    props: {
      post,
      newer: index > 0 ? { title: posts[index - 1].data.title, href: `/stories/${entrySlug(posts[index - 1].id)}/` } : null,
      older: index < posts.length - 1 ? { title: posts[index + 1].data.title, href: `/stories/${entrySlug(posts[index + 1].id)}/` } : null
    }
  }));
}

interface Props {
  post: CollectionEntry<'stories'>;
  newer: { title: string; href: string } | null;
  older: { title: string; href: string } | null;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<PostLayout title={post.data.title} description={post.data.description}>
  <Fragment slot="meta"><div class="article-meta"><span><i class="bi bi-calendar3"></i> {post.data.date.toLocaleDateString()}</span>{post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}</div></Fragment>
  <Content />
  <Fragment slot="after">
    <PostKudos postId={post.data.backendId} />
    <nav class="post-navigation">
      {older ? <a href={older.href}><i class="bi bi-arrow-left"></i> {older.title}</a> : <span></span>}
      <a href="/stories/">Back to Stories</a>
      {newer ? <a href={newer.href}>{newer.title} <i class="bi bi-arrow-right"></i></a> : <span></span>}
    </nav>
    <script is:inline type="module" src="/scripts/post-kudos.js"></script>
  </Fragment>
</PostLayout>
