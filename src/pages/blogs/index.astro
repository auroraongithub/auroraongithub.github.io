---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import SiteSection from '../../components/SiteSection.astro';
import PostCard from '../../components/PostCard.astro';
import { entrySlug, sortByDate } from '../../lib/content';
const posts = sortByDate(await getCollection('blogs', ({ data }) => !data.draft));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<ContentLayout title="Blogs">
  <SiteSection title="Blogs" icon="bi-journal-text" class="blogs-section">
    <div class="post-controls" aria-label="Blog archive filters">
      <label class="post-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <span class="visually-hidden">Search blogs</span>
        <input type="search" class="form-control" placeholder="Search the archive..." aria-label="Search blogs" data-post-search />
      </label>
      <div class="tag-filters" aria-label="Filter by blog tag">
        <button type="button" class="btn btn-ghost active" data-tag-filter="">All</button>
        {tags.map((tag) => <button type="button" class="btn btn-ghost" data-tag-filter={tag.toLowerCase()}>{tag}</button>)}
      </div>
    </div>
    <div class="masonry-grid" data-post-grid>
      {posts.map((post) => <PostCard title={post.data.title} description={post.data.description} date={post.data.date} tags={post.data.tags} href={`/blogs/${entrySlug(post.id)}/`} />)}
    </div>
    <p class="text-muted" data-post-empty hidden>No matching blog posts.</p>
  </SiteSection>
  <script is:inline type="module" src="/scripts/post-filter.js"></script>
</ContentLayout>
