---
import AdminLayout from '../layouts/AdminLayout.astro';
import { adminNavigation } from '../lib/admin/navigation';
---
<AdminLayout title="Admin Dashboard" requiresAuth={true} dashboard={true}>
  <div class="admin-dashboard-page">
    <div class="admin-dashboard-columns neo-sidebar">
      {adminNavigation.map((section) => (
        <section class="neo-box admin-dashboard-column">
          <div class="neo-header"><h2>{section.label}</h2></div>
          <div class="neo-content">
            <ul class="admin-dashboard-list">
              {section.items.map((item) => (
                <li>
                  <a class="sidebar-button admin-dashboard-link" href={item.href}>
                    <span>{item.label}</span><span class="admin-dashboard-link-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </div>
</AdminLayout>

<style>
  .admin-dashboard-page {
    min-width: 0;
    width: 100%;
    padding: 8px 10px 20px;
  }
  .admin-dashboard-columns {
    display: grid;
    grid-template-columns: minmax(150px, .82fr) minmax(230px, 1.38fr) minmax(150px, .82fr);
    gap: 0 14px;
    align-items: start;
    min-height: 0;
    padding: 0 6px 18px;
  }
  .admin-dashboard-columns.neo-sidebar {
    flex: none;
    position: static;
    max-height: none;
    overflow: visible;
  }
  .admin-dashboard-column {
    min-width: 0;
    margin: 0 !important;
  }
  .admin-dashboard-column:nth-child(1) {
    width: calc(100% - 10px);
    margin-top: 28px !important;
    justify-self: start;
  }
  .admin-dashboard-column:nth-child(2) {
    width: 100%;
    margin-top: 0 !important;
    justify-self: center;
  }
  .admin-dashboard-column:nth-child(3) {
    width: calc(100% - 14px);
    margin-top: 66px !important;
    justify-self: end;
  }
  .admin-dashboard-column:hover {
    transform: none;
  }
  .admin-dashboard-column .neo-content {
    max-height: none !important;
    overflow: visible !important;
  }
  .admin-dashboard-list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .admin-dashboard-list li {
    margin: 0 !important;
  }
  .admin-dashboard-link {
    justify-content: space-between !important;
    text-align: left;
  }
  .admin-dashboard-link::before {
    content: none !important;
  }
  .admin-dashboard-link-arrow {
    flex: 0 0 auto;
    color: var(--primary-dark);
    font-size: inherit;
  }
  @media (max-width: 860px) {
    .admin-dashboard-columns {
      grid-template-columns: 1fr;
      gap: 10px;
      min-height: 0;
      padding: 0 0 10px;
    }
    .admin-dashboard-column:nth-child(1),
    .admin-dashboard-column:nth-child(2),
    .admin-dashboard-column:nth-child(3) {
      width: 100%;
      margin-top: 0 !important;
      justify-self: stretch;
    }
  }
</style>
