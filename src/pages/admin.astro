---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminPanel from '../components/admin/AdminPanel.astro';
---
<AdminLayout title="Admin" requiresAuth={false} login={true}>
  <AdminPanel title="Opening Admin" icon="bi-shield-lock" class="admin-login-panel">
    <p class="admin-entry-message"><span class="admin-entry-dot"></span> Checking your session…</p>
  </AdminPanel>
  <script>
    let token = null;
    try { token = localStorage.getItem('jwt') || sessionStorage.getItem('jwt'); } catch (_) {}
    window.location.replace(token ? '/admin/blogs/' : '/admin/login/');
  </script>
</AdminLayout>
