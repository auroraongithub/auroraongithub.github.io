---
import AdminLayout from '../layouts/AdminLayout.astro';
import { adminNavigation } from '../lib/admin/navigation';
---
<AdminLayout title="Admin Dashboard" requiresAuth={true} dashboard={true}>
  <div class="admin-dashboard-page">
    <section class="admin-dashboard-status-sheet" aria-label="Site status">
      <div class="admin-dashboard-status-heading">SYSTEM STATUS</div>
      <div class="admin-dashboard-metrics" aria-label="Site metrics">
        <div class="admin-dashboard-metric"><strong id="statProjects">--</strong><span>Projects</span></div>
        <div class="admin-dashboard-metric"><strong id="statPosts">--</strong><span>Posts</span></div>
        <div class="admin-dashboard-metric"><strong id="statPageviews">--</strong><span>Total visits</span></div>
      </div>
    </section>

    <div class="admin-dashboard-columns">
      {adminNavigation.map((section) => (
        <section class="neo-box admin-dashboard-column">
          <div class="neo-header"><h2>{section.label}</h2></div>
          <div class="neo-content">
            <ul class="admin-dashboard-list">
              {section.items.map((item) => (
                <li>
                  <a class="admin-dashboard-link" href={item.href}>
                    <span>{item.label}</span><span class="admin-dashboard-link-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </div>
</AdminLayout>

<script>
  import { adminFetch } from '../lib/admin/api';

  async function loadStats() {
    try {
      const response = await adminFetch('/site/stats', {}, { auth: false });
      const data = await response.json();
      if (!response.ok) return;
      document.querySelector('#statProjects')!.textContent = String(data.projects ?? data.projects_count ?? '0');
      document.querySelector('#statPosts')!.textContent = String(data.posts ?? data.posts_count ?? '0');
      document.querySelector('#statPageviews')!.textContent = String(data.pageviews ?? data.total_visits ?? data.total ?? '0');
    } catch (_) {
      // Navigation remains useful when optional metrics are unavailable.
    }
  }

  loadStats();
</script>

<style>
  .admin-dashboard-page {
    display: grid;
    gap: 10px;
    min-width: 0;
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }
  .admin-dashboard-status-sheet {
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: var(--card);
  }
  .admin-dashboard-status-heading {
    min-height: 24px;
    box-sizing: border-box;
    padding: 5px 8px;
    border-bottom: 1px solid var(--primary-dark);
    background: var(--gradient);
    color: #fff;
    font: 700 .7rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .09em;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 70%, #000);
    text-transform: uppercase;
  }
  .admin-dashboard-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .admin-dashboard-metric {
    display: grid;
    gap: 3px;
    min-height: 51px;
    place-content: center;
    padding: 6px 8px;
    background: color-mix(in srgb, var(--card) 94%, var(--primary-light));
    text-align: center;
  }
  .admin-dashboard-metric + .admin-dashboard-metric {
    border-left: 1px dotted var(--border-light);
  }
  .admin-dashboard-metric strong {
    color: var(--primary-dark);
    font: 700 1.22rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .admin-dashboard-metric span {
    color: var(--text-muted);
    font: 700 .65rem/1.1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }
  .admin-dashboard-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: start;
  }
  .admin-dashboard-column {
    min-width: 0;
    margin: 0 !important;
    border-radius: 6px;
    font-family: "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }
  .admin-dashboard-column:hover {
    transform: none;
  }
  .admin-dashboard-column .neo-header {
    min-height: 29px;
    box-sizing: border-box;
    padding: 7px 9px;
  }
  .admin-dashboard-column .neo-header h2 {
    margin: 0;
    font-size: .74rem;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .admin-dashboard-column .neo-content {
    padding: 5px;
  }
  .admin-dashboard-list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .admin-dashboard-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 29px;
    box-sizing: border-box;
    padding: 5px 7px;
    border: 1px solid transparent;
    color: var(--text);
    font-size: .76rem;
    text-decoration: none;
  }
  .admin-dashboard-link:hover {
    border-color: var(--border-light);
    background: var(--gradient-subtle);
    color: var(--primary-dark);
  }
  .admin-dashboard-link-arrow {
    flex: 0 0 auto;
    color: var(--primary-dark);
    font-size: .8rem;
  }
  @media (max-width: 760px) {
    .admin-dashboard-columns {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .admin-dashboard-metrics { grid-template-columns: 1fr; }
    .admin-dashboard-metric { min-height: 40px; }
    .admin-dashboard-metric + .admin-dashboard-metric { border-top: 1px dotted var(--border-light); border-left: 0; }
  }
</style>
