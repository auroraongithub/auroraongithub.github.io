---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { contentPortfolio } from '../data/portfolio';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---
<div class="portfolio-showcase" data-portfolio-showcase>
  <div class="portfolio-tabs" role="tablist" aria-label="Portfolio categories">
    <button class="portfolio-tab active" type="button" role="tab" aria-selected="true" aria-controls="portfolioContentPanel" data-portfolio-tab="content">
      <i class="bi bi-camera-reels"></i> Content
    </button>
    <button class="portfolio-tab" type="button" role="tab" aria-selected="false" aria-controls="portfolioCodingPanel" data-portfolio-tab="coding">
      <i class="bi bi-code-slash"></i> Coding
    </button>
  </div>

  <section class="portfolio-panel" id="portfolioContentPanel" role="tabpanel" data-portfolio-panel="content">
    <div class="portfolio-panel-intro">
      <span class="portfolio-panel-kicker"><i class="bi bi-broadcast-pin"></i> Content creation / social growth</span>
      <p>Selected channels, edits, and milestones from a hands-on content workflow.</p>
    </div>

    <div class="portfolio-content-grid">
      {contentPortfolio.map((item) => (
        <article class="portfolio-highlight-card">
          <div class="portfolio-highlight-topline">
            <span class="portfolio-highlight-icon"><i class={`bi ${item.icon}`}></i></span>
            <span>{item.eyebrow}</span>
          </div>
          <h3>{item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}</h3>
          <p>{item.description}</p>
          <div class="portfolio-highlight-metrics">
            {item.metrics.map((metric) => <span>{metric}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="portfolio-panel" id="portfolioCodingPanel" role="tabpanel" data-portfolio-panel="coding" hidden>
    <div class="portfolio-panel-intro">
      <span class="portfolio-panel-kicker"><i class="bi bi-terminal"></i> Coding / web projects</span>
      <p>Small tools, websites, and experiments built to solve a real problem or make an idea easier to use.</p>
    </div>
    <div class="neo-grid" id="portfolioGrid">
      {projects.length
        ? projects.map((project) => <ProjectCard name={project.data.name} description={project.data.description} href={project.data.githubUrl || project.data.url || '#'} language={project.data.language} stars={project.data.stars} forks={project.data.forks} />)
        : <div class="loading-small">Loading coding projects...</div>}
    </div>
  </section>
</div>
