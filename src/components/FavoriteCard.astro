---
interface Props {
  title: string;
  image?: string;
  year?: string | number;
  score?: string | number;
  href?: string;
}

const { title, image, year, score, href } = Astro.props;
---
<a class="carousel-item favorite-item" data-favorite-link href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined} aria-label={`Open ${title} on MyAnimeList`}>
  <span class="favorite-rank" data-favorite-list-rank aria-hidden="true">01</span>
  {image && <img class="favorite-item-image" data-favorite-image src={image} alt={title} loading="lazy" />}
  <div class="favorite-info">
    <strong data-favorite-title>{title}</strong>
    <div class="favorite-meta">
      <small data-favorite-year hidden={!year}>{year}</small>
      <small data-favorite-status hidden></small>
      <small data-favorite-format hidden></small>
    </div>
    <div class="favorite-stats">
      <small class="favorite-score" data-favorite-score hidden={!score}>{score ? `★ ${score}` : ''}</small>
      <small class="favorite-pending" data-favorite-pending hidden>MAL stats pending</small>
    </div>
  </div>
</a>
