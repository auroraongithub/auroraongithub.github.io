---
import PrimaryNav from './PrimaryNav.astro';
import SidebarButton from './SidebarButton.astro';
import { socialLinks } from '../data/socialLinks';
---
<aside class="neo-sidebar">
  <div class="neo-box sidebar-animate" data-default-accent="cyan">
    <div class="neo-header"><h3><i class="bi bi-compass" aria-hidden="true"></i> Navigate</h3></div>
    <div class="neo-content">
      <PrimaryNav />
    </div>
  </div>

  <div class="neo-box sidebar-animate sidebar-links-box" data-default-accent="pink">
    <div class="neo-header"><h3><i class="bi bi-link-45deg" aria-hidden="true"></i> Links</h3></div>
    <div class="neo-content">
      <ul class="sidebar-links">
        {socialLinks.map((link) => (
          <li><SidebarButton href={link.href} label={link.label} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} /></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="neo-box sidebar-animate" data-default-accent="purple">
    <div class="neo-header"><h3><i class="bi bi-images" aria-hidden="true"></i> Gallery</h3></div>
    <div class="neo-content gallery-content">
      <img src="/img/pfp.png" alt="Profile" loading="lazy" />
      <img src="/img/topheader.png" alt="Header artwork" loading="lazy" />
    </div>
  </div>

  <div class="neo-box sidebar-animate sidebar-more" data-default-accent="green">
    <div class="neo-header"><h3><i class="bi bi-three-dots" aria-hidden="true"></i> More</h3></div>
    <div class="neo-content" style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;">
      <img src="/img/igotaleek.gif" alt="I got a leek" style="width: 120px; border-radius: 4px;" loading="lazy" />
      <img src="/img/2voca.jpg" alt="Vocaloid" style="width: 120px; border-radius: 4px;" loading="lazy" />
      <img src="/img/0178-mikuwink2.gif" alt="Miku wink" style="width: 120px; border-radius: 4px;" loading="lazy" />
      <a class="sidebar-more-link" href="/button/"><i class="bi bi-badge-ad" aria-hidden="true"></i> Get our button</a>
    </div>
  </div>

  <div class="neo-box sidebar-animate sidebar-stats-box" data-default-accent="orange">
    <div class="neo-header"><h3><i class="bi bi-bar-chart"></i> Stats</h3></div>
    <div class="neo-content stats-content" id="sidebarStatsContent">
      <div class="stats-grid sidebar-stats">
        <div class="stat-item"><span class="stat-value" id="statProjects">--</span><span class="stat-label">Projects</span></div>
        <div class="stat-item"><span class="stat-value" id="statPosts">--</span><span class="stat-label">Posts</span></div>
        <div class="stat-item"><span class="stat-value" id="statVisitors">--</span><span class="stat-label">Online Now</span></div>
        <div class="stat-item"><span class="stat-value" id="statPageviews">--</span><span class="stat-label">Total Visits</span></div>
      </div>
    </div>
  </div>
</aside>
