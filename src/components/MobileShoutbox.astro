<section class="neo-box scroll-animate mobile-shoutbox-section">
  <div class="neo-header">
    <h2><i class="bi bi-chat-dots"></i> Chatbox</h2>
    <button class="shoutbox-admin-btn" onclick="toggleAdminMode()" title="Admin login"><i class="bi bi-shield-lock"></i></button>
  </div>
  <div class="neo-content shoutbox-container">
    <div class="shoutbox-messages" id="mobileShoutboxMessages"><div class="shoutbox-loading">Loading messages...</div></div>
    <div class="shoutbox-setup" id="mobileShoutboxSetup">
      <div class="shoutbox-setup-row">
        <input type="color" id="mobileShoutboxColor" value="#6de6e2" aria-label="Chat name color" />
        <input type="text" id="mobileShoutboxUsername" placeholder="Choose a username..." maxlength="30" />
      </div>
      <button class="shoutbox-join-btn" onclick="joinShoutbox('mobile')">Join Chat</button>
    </div>
    <div class="shoutbox-input" id="mobileShoutboxInput" style="display: none;">
      <div class="shoutbox-user-info"><span id="mobileShoutboxCurrentUser"></span><button class="shoutbox-change-user" onclick="changeShoutboxUser('mobile')" title="Change username"><i class="bi bi-pencil"></i></button></div>
      <div class="shoutbox-send-row">
        <button class="shoutbox-emoji-btn" onclick="toggleEmojiPicker('mobile')" title="Add emoji"><i class="bi bi-emoji-smile"></i></button>
        <input type="text" id="mobileShoutboxMessage" placeholder="Type a message..." maxlength="500" onkeypress="if(event.key==='Enter')sendShoutboxMessage('mobile')" />
        <button class="shoutbox-send-btn" onclick="sendShoutboxMessage('mobile')"><i class="bi bi-send"></i></button>
      </div>
      <div class="emoji-picker-container" id="mobileEmojiPickerContainer" style="display: none;"><div class="custom-emoji-picker" id="mobileCustomEmojiPicker"></div></div>
    </div>
  </div>
</section>
