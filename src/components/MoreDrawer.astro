---
import PrimaryNav from './PrimaryNav.astro';
import SidebarButton from './SidebarButton.astro';
import { socialLinks } from '../data/socialLinks';
import WebringBadges from './WebringBadges.astro';
---

<div class="more-drawer" id="moreDrawer" role="dialog" aria-modal="true" aria-labelledby="more-drawer-title" aria-hidden="true">
  <div class="more-drawer-overlay" data-more-close></div>
  <div class="more-drawer-content">
    <div class="more-drawer-header">
      <h2 id="more-drawer-title"><i class="bi bi-grid-fill" aria-hidden="true"></i> More</h2>
      <button class="more-drawer-close" data-more-close aria-label="Close more menu"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>

    <div class="more-drawer-body">
      <section class="neo-box sidebar-animate more-drawer-section" data-default-accent="cyan">
        <div class="neo-header"><h3><i class="bi bi-compass" aria-hidden="true"></i> Navigate</h3></div>
        <div class="neo-content">
          <PrimaryNav />
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section sidebar-links-box" data-default-accent="pink">
        <div class="neo-header"><h3><i class="bi bi-link-45deg" aria-hidden="true"></i> Links</h3></div>
        <div class="neo-content">
          <ul class="sidebar-links">
            {socialLinks.map((link) => (
              <li><SidebarButton href={link.href} label={link.label} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} /></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section" data-default-accent="purple">
        <div class="neo-header"><h3><i class="bi bi-images" aria-hidden="true"></i> Gallery</h3></div>
        <div class="neo-content gallery-content">
          <img src="/img/pfp.png" alt="Profile" loading="lazy" />
          <img src="/img/topheader.png" alt="Header artwork" loading="lazy" />
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section sidebar-more" data-default-accent="green">
        <div class="neo-header"><h3><i class="bi bi-three-dots" aria-hidden="true"></i> More</h3></div>
        <div class="neo-content sidebar-more-content">
          <img src="/img/igotaleek.gif" alt="I got a leek" loading="lazy" />
          <img src="/img/2voca.jpg" alt="Vocaloid" loading="lazy" />
          <img src="/img/0178-mikuwink2.gif" alt="Miku wink" loading="lazy" />
          <a class="sidebar-more-link" href="/button/"><i class="bi bi-badge-ad" aria-hidden="true"></i> Get our button</a>
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section sidebar-stats-box" data-default-accent="orange">
        <div class="neo-header"><h3><i class="bi bi-bar-chart" aria-hidden="true"></i> Stats</h3></div>
        <div class="neo-content stats-content" id="drawerStatsContent">
          <div class="stats-grid sidebar-stats">
            <div class="stat-item"><span class="stat-value" id="drawerStatPosts">--</span><span class="stat-label">Posts</span></div>
            <div class="stat-item"><span class="stat-value" id="drawerStatVisitors">--</span><span class="stat-label">Online Now</span></div>
            <div class="stat-item"><span class="stat-value" id="drawerStatPageviews">--</span><span class="stat-label">Total Visits</span></div>
          </div>
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section widget-now" data-default-accent="blue">
        <div class="neo-header"><h3><i class="bi bi-clock-history" aria-hidden="true"></i> Now</h3></div>
        <div class="neo-content">
          <div class="now-widget-item"><span class="now-widget-label">Working On</span><span class="now-widget-value" id="drawerWorkingOn">Loading...</span></div>
          <div class="now-widget-item"><span class="now-widget-label">Learning</span><span class="now-widget-value" id="drawerLearning">Loading...</span></div>
          <div class="now-widget-item"><span class="now-widget-label">Open to Collabs</span><span class="now-widget-value" id="drawerCollabs"><i class="bi bi-question-circle" aria-hidden="true"></i></span></div>
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section widget-changelog" data-default-accent="red">
        <div class="neo-header"><h3><i class="bi bi-list-check" aria-hidden="true"></i> Updates</h3></div>
        <div class="neo-content" id="drawerChangelog">
          <div class="loading-small">Loading...</div>
          <a href="/changelog/" class="widget-link">View all updates <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section widget-shoutbox-sidebar" data-default-accent="yellow">
        <div class="neo-header">
          <h3><i class="bi bi-chat-dots" aria-hidden="true"></i> Chatbox</h3>
          <button class="shoutbox-admin-btn" onclick="toggleAdminMode()" title="Admin login" aria-label="Admin login"><i class="bi bi-shield-lock" aria-hidden="true"></i></button>
        </div>
        <div class="neo-content shoutbox-container drawer-shoutbox">
          <div class="shoutbox-messages" id="drawerShoutboxMessages"><div class="shoutbox-loading">Loading messages...</div></div>
          <div class="shoutbox-setup shoutbox-setup--polished" id="drawerShoutboxSetup">
            <div class="shoutbox-setup-row">
              <input type="color" id="drawerShoutboxColor" value="#6de6e2" aria-label="Chat name color" />
              <input type="text" id="drawerShoutboxUsername" placeholder="Choose a username..." maxlength="30" />
            </div>
            <button class="shoutbox-join-btn" onclick="joinShoutbox('drawer')">Join Chat</button>
          </div>
          <div class="shoutbox-input" id="drawerShoutboxInput" style="display: none;">
            <div class="shoutbox-user-info"><span id="drawerShoutboxCurrentUser"></span><button class="shoutbox-change-user" onclick="changeShoutboxUser('drawer')" title="Change username"><i class="bi bi-pencil" aria-hidden="true"></i></button></div>
            <div class="shoutbox-send-row">
              <div class="shoutbox-message-field">
                <input type="text" id="drawerShoutboxMessage" placeholder="Type a message..." maxlength="500" onkeypress="if(event.key==='Enter')sendShoutboxMessage('drawer')" />
                <button class="shoutbox-emoji-btn" id="drawerShoutboxEmojiButton" type="button" onclick="toggleEmojiPicker('drawer')" title="Add emoji" aria-label="Add emoji" aria-controls="drawerEmojiPickerContainer" aria-expanded="false"><i class="bi bi-emoji-smile" aria-hidden="true"></i></button>
              </div>
              <button class="shoutbox-send-btn" onclick="sendShoutboxMessage('drawer')" aria-label="Send message"><i class="bi bi-send" aria-hidden="true"></i></button>
            </div>
            <div class="emoji-picker-container" id="drawerEmojiPickerContainer" style="display: none;"><div class="custom-emoji-picker" id="drawerCustomEmojiPicker"></div></div>
          </div>
        </div>
      </section>

      <section class="neo-box sidebar-animate more-drawer-section widget-webring" data-default-accent="green">
        <div class="neo-header"><h3><i class="bi bi-globe2" aria-hidden="true"></i> Webring</h3></div>
        <div class="neo-content webring-content">
          <WebringBadges />
        </div>
      </section>

    </div>
  </div>
</div>
