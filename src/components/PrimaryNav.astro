---
import { primaryNavigation } from '../data/navigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<ul class="primary-nav-list">
  {primaryNavigation.map((item) => (
    <li><a href={item.href} class:list={['sidebar-button', { active: isActive(item.href) }]}><span>{item.label}</span></a></li>
  ))}
</ul>
