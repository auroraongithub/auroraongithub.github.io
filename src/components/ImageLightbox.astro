<div class="lightbox-overlay" id="siteImageLightbox" role="dialog" aria-modal="true" aria-label="Image preview" aria-hidden="true">
  <button class="lightbox-close" type="button" aria-label="Close image preview">
    <i class="bi bi-x-lg" aria-hidden="true"></i>
  </button>
  <img id="siteImageLightboxImage" src="/img/favicon.png" alt="" />
</div>

<script is:inline>
  (() => {
    const overlay = document.querySelector('#siteImageLightbox');
    const image = document.querySelector('#siteImageLightboxImage');
    const closeButton = overlay?.querySelector('.lightbox-close');
    const imageSelector = '.gallery-content img, .blog-post .article-content img, .story-post .article-content img';
    let restoreFocus = null;
    let previousOverflow = '';

    const close = () => {
      if (!overlay || !image) return;
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
      image.removeAttribute('src');
      document.body.style.overflow = previousOverflow;
      restoreFocus?.focus({ preventScroll: true });
      restoreFocus = null;
    };

    const open = (source) => {
      if (!overlay || !image) return;
      restoreFocus = source;
      previousOverflow = document.body.style.overflow;
      image.src = source.currentSrc || source.src;
      image.alt = source.alt || 'Expanded image';
      overlay.classList.add('active');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeButton?.focus();
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLImageElement) || !target.matches(imageSelector)) return;
      event.preventDefault();
      open(target);
    });

    closeButton?.addEventListener('click', close);
    overlay?.addEventListener('click', (event) => {
      if (event.target === overlay) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay?.classList.contains('active')) close();
    });
  })();
</script>
