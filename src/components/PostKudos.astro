---
interface Props { postId?: string; }
const { postId } = Astro.props;
---
{postId && (
  <div class="post-kudos" data-kudos-root data-post-id={postId}>
    <button class="btn btn-ghost" type="button" data-kudos-button><i class="bi bi-heart"></i> Kudos <span data-kudos-count>0</span></button>
  </div>
)}
