---
import { adminNavigation, type AdminNavKey } from '../../lib/admin/navigation';
import SidebarButton from '../SidebarButton.astro';

interface Props { active?: AdminNavKey }
const { active } = Astro.props;
---
<aside class="neo-sidebar admin-nav" aria-label="Admin navigation">
  {adminNavigation.map((section) => (
    <section
      class="neo-box admin-nav-group"
      data-default-accent={section.label === 'Content' ? 'purple' : section.label === 'Site' ? 'green' : 'orange'}
    >
      <div class="neo-header"><h3>{section.label}</h3></div>
      <div class="neo-content">
        <ul class="primary-nav-list admin-nav-list">
          {section.items.map((item) => (
            <li>
              <SidebarButton href={item.href} label={item.label} active={item.key === active} icon={'icon' in item ? item.icon : undefined} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</aside>
