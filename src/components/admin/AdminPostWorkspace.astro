---
import AdminTabs from './AdminTabs.astro';

interface Props { active: 'blogs' | 'stories' }

const { active } = Astro.props;
const postTabs = [
  { id: 'blogs', label: 'Blogs' },
  { id: 'stories', label: 'Stories' }
] as const;
---
<section class:list={['neo-box', 'scroll-animate', 'admin-post-workspace', `${active}-section`]}>
  <div class="neo-header admin-post-workspace-header">
    <AdminTabs tabs={postTabs} active={active} dataAttribute="category" />
    <div class="admin-post-workspace-actions"><slot name="actions" /></div>
  </div>
  <div class="neo-content admin-post-workspace-content">
    <slot />
  </div>
</section>

<script>
  const postRoutes: Record<string, string> = {
    blogs: '/admin/blogs/',
    stories: '/admin/stories/'
  };

  document.querySelectorAll<HTMLButtonElement>('.admin-post-workspace-header [data-category]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const route = postRoutes[tab.dataset.category || ''];
      if (route && window.location.pathname !== route) window.location.assign(route);
    });
  });
</script>

<style is:global>
  .admin-post-workspace {
    position: relative;
    min-width: 0;
    margin: 30px 0 0 !important;
    padding: 3px;
    overflow: visible;
    box-sizing: border-box;
    border: 2px solid var(--primary);
    border-right-color: var(--primary-dark);
    border-bottom-color: var(--primary-dark);
    border-radius: 0 12px 12px 12px;
    background: color-mix(in srgb, var(--primary-light) 38%, var(--bg-elev));
    box-shadow:
      0 0 0 2px var(--halo),
      3px 3px 0 var(--halo),
      6px 6px 0 color-mix(in srgb, var(--primary) 22%, var(--bg-elev)),
      2px 2px 5px rgba(0, 0, 0, .25);
  }

  .admin-post-workspace:hover {
    transform: none;
    box-shadow:
      0 0 0 2px var(--halo),
      3px 3px 0 var(--halo),
      6px 6px 0 color-mix(in srgb, var(--primary) 22%, var(--bg-elev)),
      2px 2px 5px rgba(0, 0, 0, .25);
  }

  .admin-post-workspace > .admin-post-workspace-header {
    width: max-content;
    max-width: calc(100% - 12px);
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    position: absolute;
    top: -35px;
    left: -4px;
    z-index: 2;
    margin: 0;
    padding: 0;
    border: 2px solid var(--halo);
    border-bottom: none;
    border-radius: 15px 15px 0 0;
    background-image: repeating-linear-gradient(
      45deg,
      var(--primary-light),
      var(--primary-light) 6px,
      var(--primary) 6px,
      var(--primary) 12px
    );
    background-size: 17px 17px;
    color: #fff;
    text-shadow: 2px 2px 0 color-mix(in srgb, var(--primary-dark) 85%, #000);
    box-shadow: 2px -2px 5px color-mix(in srgb, var(--primary) 22%, transparent);
    animation: admin-post-stripe-move 1s linear infinite;
  }

  .admin-post-workspace-header .admin-tabs {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0 4px;
    border: 0;
  }

  .admin-post-workspace-actions {
    display: flex;
    align-items: center;
    padding: 0 5px 0 3px;
  }

  .admin-post-workspace-actions .btn {
    min-height: 25px;
    padding: 4px 8px;
    border-radius: 4px;
    font: 700 .64rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .admin-post-workspace-header .admin-tab {
    min-height: 31px !important;
    padding: 7px 14px !important;
    border: 0;
    border-radius: 10px 10px 0 0 !important;
    background: transparent;
    color: #fff;
    font: 700 .82rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif !important;
    letter-spacing: .08em;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 85%, #000);
    text-transform: uppercase;
  }

  .admin-post-workspace-header .admin-tab:hover {
    background: color-mix(in srgb, #fff 18%, transparent);
    color: #fff;
  }

  .admin-post-workspace-header .admin-tab.active {
    border: 1px solid var(--primary-dark);
    border-bottom: 0;
    background: var(--bg-elev);
    color: var(--primary-dark);
    text-shadow: none;
  }

  .admin-post-workspace > .admin-post-workspace-content {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    box-sizing: border-box;
    padding: 8px;
    overflow: hidden;
    border: 1px solid var(--primary-dark);
    border-radius: 0 8px 8px 8px;
    background: var(--bg-elev);
  }

  .admin-post-workspace .admin-post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .admin-post-workspace .masonry-item {
    opacity: 1;
    transform: none;
  }

  .admin-post-workspace .masonry-item:hover {
    transform: none;
  }

  .admin-post-workspace .admin-post-list .admin-list-group-title {
    grid-column: 1 / -1;
    margin: 7px 2px 0;
    padding: 4px 6px 3px;
    border-bottom: 1px dashed var(--border-light);
    color: var(--primary-dark);
    font: 700 .68rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    letter-spacing: .12em;
  }

  .admin-post-workspace .admin-post-list .admin-list-group-title:first-child {
    margin-top: 0;
  }

  .admin-post-workspace .admin-post-list .admin-list-item {
    position: relative;
    display: flex;
    min-height: 112px;
    flex-direction: column;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background: color-mix(in srgb, var(--bg-elev) 86%, transparent);
    box-shadow: inset 1px 1px 0 color-mix(in srgb, var(--primary-light) 34%, transparent), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 18%, transparent);
    transition: border-color .16s ease, background-color .16s ease;
  }

  .admin-post-workspace .admin-post-list .admin-list-item:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary-light) 16%, var(--bg-elev));
    box-shadow: inset 1px 1px 0 color-mix(in srgb, var(--primary-light) 38%, transparent), inset -1px -1px 0 color-mix(in srgb, var(--primary-dark) 20%, transparent);
  }

  .admin-post-workspace .admin-post-list .admin-list-item-head {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px;
    align-items: center;
    min-width: 0;
    padding: 7px 8px;
    padding-right: 94px;
    border-bottom: 1px solid var(--primary-dark);
    background: linear-gradient(to bottom, var(--primary-light) 0%, var(--primary) 45%, var(--primary-dark) 50%, var(--primary-light) 100%);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, .6);
  }

  .admin-post-workspace .admin-post-list .admin-list-item-head h3 {
    overflow: hidden;
    margin: 0;
    font: 700 .78rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-post-workspace .admin-post-list .admin-list-item-head .post-card-icon {
    color: var(--bg);
    font-size: .72rem;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 75%, #000);
  }

  .admin-post-workspace .admin-post-list .admin-list-item-head a {
    color: var(--bg);
    text-decoration: none;
    text-shadow: 1px 1px 0 color-mix(in srgb, var(--primary-dark) 75%, #000);
  }

  .admin-post-workspace .admin-post-list .admin-list-item-head a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .admin-post-workspace .admin-post-list .admin-list-item-body {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    padding: 8px;
  }

  .admin-post-workspace .admin-post-list .admin-list-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px dotted color-mix(in srgb, var(--primary-dark) 52%, transparent);
    color: var(--text-muted);
    font: .64rem/1.2 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
  }

  .admin-post-workspace .admin-post-list .admin-list-meta span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .admin-post-workspace .admin-post-list .admin-list-meta .post-date {
    flex: 0 0 auto;
    color: var(--primary-dark);
    font-weight: 700;
    white-space: nowrap;
  }

  .admin-post-workspace .admin-post-list .admin-list-meta .post-tags {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 3px;
  }

  .admin-post-workspace .admin-post-list .admin-list-meta .chip {
    max-width: 100%;
    overflow: hidden;
    padding: 2px 5px;
    border: 1px solid var(--border-light);
    border-radius: 3px;
    background: color-mix(in srgb, var(--primary-light) 12%, var(--bg-elev));
    color: var(--text-muted);
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-post-workspace .admin-post-list .admin-list-meta i {
    display: none;
  }

  .admin-post-workspace .admin-post-list .admin-list-item-actions {
    display: flex;
    align-items: center;
    position: absolute;
    top: 6px;
    right: 6px;
    gap: 5px;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .admin-post-workspace .admin-post-list .admin-list-item-actions .btn {
    min-height: 25px;
    padding: 3px 6px;
    border-radius: 4px;
    border-color: color-mix(in srgb, #fff 62%, var(--primary-dark));
    background: color-mix(in srgb, var(--bg-elev) 78%, transparent);
    font: 700 .62rem/1 "MS PGothic", "MS UI Gothic", Tahoma, sans-serif;
    text-transform: uppercase;
  }

  .admin-post-workspace .admin-post-list .admin-list-item-actions .btn:hover {
    background: #fff;
  }

  .admin-post-workspace .admin-post-list > .admin-status {
    margin: 0;
    padding: 13px 10px;
    border-style: dashed;
    text-align: center;
  }

  .admin-post-workspace .admin-post-list > .admin-empty-state {
    min-height: 128px;
    padding: 18px 12px;
    border-style: dashed;
  }

  @media (max-width: 560px) {
    .admin-post-workspace .admin-post-list .admin-list-item {
      min-height: 108px;
    }

    .admin-post-workspace .admin-post-list .admin-list-item-actions {
      min-height: 0;
      top: 5px;
      right: 5px;
    }

    .admin-post-workspace .admin-post-list { grid-template-columns: 1fr; }
  }

  @keyframes admin-post-stripe-move {
    from { background-position: 0 0; }
    to { background-position: 17px 0; }
  }

  @media (max-width: 560px) {
    .admin-post-workspace-header .admin-tab {
      padding-inline: 10px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .admin-post-workspace > .admin-post-workspace-header {
      animation: none;
    }
  }
</style>
